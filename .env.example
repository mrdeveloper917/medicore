NODE_ENV=development
IDENTITY_DEMO_MODE=false
PORT=5000
MONGO_URL=mongodb://127.0.0.1:27017/medicore
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret
CORS_ORIGIN=http://localhost:5000
AADHAAR_ENV=sandbox
AADHAAR_PROVIDER=authorized-sub-aua-or-kua-name
AADHAAR_SANDBOX_AUTH_START_URL=
AADHAAR_SANDBOX_AUTH_CALLBACK_URL=
AADHAAR_SANDBOX_CLIENT_ID=
# Legacy generic aliases supported only for an authorized sandbox provider.
AADHAAR_AUTH_URL=
AADHAAR_CALLBACK_URL=
AADHAAR_CLIENT_ID=
AADHAAR_PRODUCTION_AUTH_START_URL=
AADHAAR_PRODUCTION_AUTH_CALLBACK_URL=
AADHAAR_PRODUCTION_CLIENT_ID=
FACE_AUTH_PROVIDER=authorized-provider-name
FACE_AUTH_VERIFY_URL=
FACE_AUTH_CLIENT_ID=
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
# Set to false only when a trusted local proxy/antivirus injects a self-signed SMTP certificate.
MAIL_TLS_REJECT_UNAUTHORIZED=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM="MediCore <no-reply@example.com>"
APP_URL=http://localhost:5000
