<%- include("../layouts/header",{title:"Reset Password"}) %>

<section class="auth-section">

    <div class="auth-container">

        <!-- Left Side -->

        <div class="auth-left">

            <div class="overlay"></div>

            <div class="left-content">

                <h1>DoctorCare</h1>

                <h2>Create New Password</h2>

                <p>

                    Enter a strong password for your account.
                    Make sure it contains uppercase, lowercase,
                    numbers and special characters.

                </p>

                <img
                    src="/images/auth/reset-password.png"
                    alt="Reset Password">

            </div>

        </div>

        <!-- Right Side -->

        <div class="auth-right">

            <div class="form-box">

                <h2>Reset Password</h2>

                <p>

                    Create a new password.

                </p>

                <% if(message){ %>

                    <div class="alert">

                        <%= message %>

                    </div>

                <% } %>

                <% if(success){ %>

                    <div class="success-alert">

                        <%= success %>

                    </div>

                <% } %>

                <form
                    action="/reset-password/<%= token %>"
                    method="POST"
                    id="resetPasswordForm">

                    <!-- Password -->

                    <div class="input-group">

                        <label>

                            New Password

                        </label>

                        <div class="password-box">

                            <input
                                type="password"
                                name="password"
                                id="resetPassword"
                                required>

                            <span
                                id="resetToggle">

                                <i class="fa-solid fa-eye"></i>

                            </span>

                        </div>

                        <div class="strength">

                            <div
                                id="resetStrengthBar">

                            </div>

                        </div>

                    </div>

                    <!-- Confirm -->

                    <div class="input-group">

                        <label>

                            Confirm Password

                        </label>

                        <input
                            type="password"
                            name="confirmPassword"
                            id="resetConfirmPassword"
                            required>

                    </div>

                    <button
                        class="register-btn"
                        type="submit">

                        Reset Password

                    </button>

                </form>

                <div class="bottom-link">

                    Back to

                    <a href="/login">

                        Login

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>

<script src="/js/auth.js"></script>

<%- include("../layouts/footer") %>