<%- include("../layouts/header", { title: "Forgot Password" }) %>



<section class="auth-section">


<div class="auth-container">

    <!-- ================= LEFT PANEL ================= -->

    <div class="auth-left">

        <div class="left-glow glow-one"></div>
        <div class="left-glow glow-two"></div>

        <div class="left-content">

            <!-- Brand -->

            <div class="brand-badge">

                <span class="brand-icon">
                    <i class="fa-solid fa-heart-pulse"></i>
                </span>

                MediCore

            </div>


            <!-- Hero -->

            <div class="hero-text">

                <span class="mini-title">
                    <i class="fa-solid fa-shield-heart"></i>
                    Account Recovery
                </span>

                <h1>
                    Secure your
                    <span>account.</span>
                </h1>

                <p>
                    Forgot your password? No problem.
                    We'll help you securely regain access
                    to your MediCore account.
                </p>

            </div>


            <!-- Image -->

            <div class="forgot-image">

                <div class="image-glow"></div>

                <div class="floating-card card-top">

                    <i class="fa-solid fa-envelope-circle-check"></i>

                    <div>
                        <strong>Reset Link</strong>
                        <span>Sent to your email</span>
                    </div>

                </div>

                <img
                    src="/images/auth/forgot-password.png"
                    alt="Password Recovery">

                <div class="floating-card card-bottom">

                    <i class="fa-solid fa-lock"></i>

                    <div>
                        <strong>Stay Secure</strong>
                        <span>Protected account recovery</span>
                    </div>

                </div>

            </div>


            <!-- Security -->

            <div class="security-info">

                <div class="security-icon">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>

                <div>

                    <strong>Safe & Secure Recovery</strong>

                    <span>
                        Your account information remains protected.
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ================= RIGHT PANEL ================= -->

    <div class="auth-right">

        <div class="form-box">

            <!-- Mobile Brand -->

            <div class="mobile-brand">

                <span>
                    <i class="fa-solid fa-heart-pulse"></i>
                </span>

                MediCore

            </div>


            <!-- Header -->

            <div class="form-header">

                <span class="welcome-label">

                    <i class="fa-solid fa-key"></i>

                    Account Recovery

                </span>

                <h2>
                    Forgot your
                    <span>password?</span>
                </h2>

                <p>
                    Enter your registered email and we'll
                    send you a secure password reset link.
                </p>

            </div>


            <!-- Error -->

            <% if(message){ %>

                <div class="alert alert-error">

                    <div class="alert-icon">
                        <i class="fa-solid fa-circle-exclamation"></i>
                    </div>

                    <div class="alert-content">

                        <strong>Something went wrong</strong>

                        <span>
                            <%= message %>
                        </span>

                    </div>

                </div>

            <% } %>


            <!-- Success -->

            <% if(success){ %>

                <div class="alert alert-success">

                    <div class="alert-icon">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>

                    <div class="alert-content">

                        <strong>Reset link sent</strong>

                        <span>
                            <%= success %>
                        </span>

                    </div>

                </div>

            <% } %>


            <!-- Recovery Form -->

            <form
                action="/forgot-password"
                method="POST"
                id="forgotPasswordForm">

                <div class="input-group">

                    <label for="resetEmail">
                        Registered Email
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-regular fa-envelope input-icon"></i>

                        <input
                            type="email"
                            id="resetEmail"
                            name="email"
                            placeholder="Enter your registered email"
                            autocomplete="email"
                            required>

                    </div>

                    <small class="input-help">

                        <i class="fa-solid fa-circle-info"></i>

                        We'll send a password reset link to this address.

                    </small>

                </div>


                <!-- Submit -->

                <button
                    class="reset-btn"
                    type="submit">

                    <span>Send Reset Link</span>

                    <i class="fa-solid fa-paper-plane"></i>

                </button>

            </form>


            <!-- Steps -->

            <div class="recovery-steps">

                <div class="step active">

                    <div class="step-icon">
                        <i class="fa-solid fa-envelope"></i>
                    </div>

                    <div>
                        <strong>Enter email</strong>
                        <span>Use your registered email</span>
                    </div>

                </div>


                <div class="step-line"></div>


                <div class="step">

                    <div class="step-icon">
                        <i class="fa-solid fa-link"></i>
                    </div>

                    <div>
                        <strong>Open reset link</strong>
                        <span>Check your inbox</span>
                    </div>

                </div>


                <div class="step-line"></div>


                <div class="step">

                    <div class="step-icon">
                        <i class="fa-solid fa-lock"></i>
                    </div>

                    <div>
                        <strong>Create password</strong>
                        <span>Set a new password</span>
                    </div>

                </div>

            </div>


            <!-- Back Login -->

            <div class="bottom-link">

                <span>Remember your password?</span>

                <a href="/login">

                    Back to Login

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>


            <!-- Trust -->

            <div class="login-trust">

                <div>
                    <i class="fa-solid fa-lock"></i>
                    Secure Recovery
                </div>

                <span></span>

                <div>
                    <i class="fa-solid fa-shield-heart"></i>
                    Privacy Protected
                </div>

            </div>

        </div>

    </div>

</div>


</section>

<%- include("../layouts/footer") %>
