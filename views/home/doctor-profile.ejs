<%- include("../layouts/header", {
    title: title || "Doctor Profile | MediCore"
}) %>

<%
    const doctorFullName = [
        doctor.firstName,
        doctor.lastName
    ]
    .filter(Boolean)
    .join(" ") || doctor.name || "Doctor";
%>

<style>

    .doctor-profile-page {
        background: #f5f8fc;
        min-height: 100vh;
        padding-bottom: 70px;
    }

    .doctor-profile-container {
        width: 90%;
        max-width: 1100px;
        margin: auto;
    }

    /* =====================================================
       COVER
    ===================================================== */

    .doctor-profile-cover {
        height: 280px;
        background:
            linear-gradient(
                135deg,
                #0b1d36,
                #1677c8
            );
        border-radius: 0 0 25px 25px;
        position: relative;
        overflow: hidden;
    }

    .doctor-profile-cover::after {
        content: "";
        position: absolute;
        width: 350px;
        height: 350px;
        border-radius: 50%;
        border: 50px solid rgba(255,255,255,0.06);
        right: -100px;
        top: -150px;
    }

    /* =====================================================
       PROFILE CARD
    ===================================================== */

    .doctor-profile-card {
        background: #ffffff;
        margin-top: -80px;
        position: relative;
        z-index: 2;
        border-radius: 22px;
        padding: 35px;
        box-shadow: 0 15px 45px rgba(11, 29, 54, 0.10);
    }

    .doctor-profile-top {
        display: flex;
        gap: 30px;
        align-items: flex-start;
    }

    /* =====================================================
       IMAGE
    ===================================================== */

    .doctor-profile-image-wrapper {
        width: 170px;
        height: 170px;
        min-width: 170px;
        border-radius: 20px;
        overflow: hidden;
        background: #eaf1f8;
        border: 6px solid #ffffff;
        box-shadow: 0 8px 25px rgba(0,0,0,0.12);
        margin-top: -85px;
        position: relative;
    }

    .doctor-profile-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .doctor-profile-placeholder {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 65px;
        color: #1677c8;
    }

    /* =====================================================
       BASIC INFO
    ===================================================== */

    .doctor-profile-info {
        flex: 1;
    }

    .doctor-profile-specialization {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #1677c8;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .doctor-profile-name {
        font-size: 34px;
        color: #0b1d36;
        margin: 0 0 12px;
    }

    .doctor-profile-name span {
        font-weight: 400;
    }

    .doctor-profile-qualification {
        color: #555;
        font-size: 17px;
        margin-bottom: 12px;
    }

    .doctor-profile-verified {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: #e8f8ef;
        color: #168a4a;
        padding: 7px 13px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 700;
    }

    /* =====================================================
       DETAILS GRID
    ===================================================== */

    .doctor-details-grid {
        display: grid;
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
        gap: 18px;
        margin-top: 35px;
    }

    .doctor-detail-box {
        background: #f7faff;
        border: 1px solid #e3ebf4;
        border-radius: 15px;
        padding: 20px;
        display: flex;
        gap: 15px;
        align-items: flex-start;
    }

    .doctor-detail-icon {
        width: 45px;
        height: 45px;
        min-width: 45px;
        border-radius: 12px;
        background: #e7f2ff;
        color: #1677c8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }

    .doctor-detail-content small {
        display: block;
        color: #777;
        font-size: 13px;
        margin-bottom: 5px;
    }

    .doctor-detail-content strong {
        display: block;
        color: #172b4d;
        font-size: 16px;
    }

    /* =====================================================
       SECTIONS
    ===================================================== */

    .doctor-profile-section {
        background: #ffffff;
        border-radius: 20px;
        margin-top: 25px;
        padding: 30px;
        box-shadow:
            0 8px 30px rgba(11, 29, 54, 0.06);
    }

    .doctor-profile-section h2 {
        color: #0b1d36;
        margin: 0 0 15px;
        font-size: 23px;
    }

    .doctor-profile-section p {
        color: #555;
        line-height: 1.8;
        margin: 0;
    }

    /* =====================================================
       FEES
    ===================================================== */

    .doctor-fees {
        display: grid;
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .doctor-fee-box {
        border: 1px solid #e2eaf2;
        border-radius: 15px;
        padding: 20px;
    }

    .doctor-fee-box small {
        display: block;
        color: #777;
        margin-bottom: 7px;
    }

    .doctor-fee-box strong {
        font-size: 25px;
        color: #0b1d36;
    }

    /* =====================================================
       ACTIONS
    ===================================================== */

    .doctor-profile-actions {
        display: flex;
        gap: 15px;
        margin-top: 30px;
        flex-wrap: wrap;
    }

    .doctor-action-btn {
        text-decoration: none;
        padding: 13px 22px;
        border-radius: 10px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: 0.2s ease;
    }

    .doctor-action-primary {
        background: #1677c8;
        color: #ffffff;
    }

    .doctor-action-primary:hover {
        background: #0f5fa3;
        transform: translateY(-2px);
    }

    .doctor-action-secondary {
        background: #eef4fa;
        color: #0b1d36;
    }

    .doctor-action-secondary:hover {
        background: #e0eaf4;
    }

    /* =====================================================
       MOBILE
    ===================================================== */

    @media (max-width: 768px) {

        .doctor-profile-cover {
            height: 200px;
        }

        .doctor-profile-card {
            padding: 25px 20px;
        }

        .doctor-profile-top {
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .doctor-profile-image-wrapper {
            margin-top: -100px;
        }

        .doctor-profile-name {
            font-size: 27px;
        }

        .doctor-details-grid,
        .doctor-fees {
            grid-template-columns: 1fr;
        }

        .doctor-profile-section {
            padding: 22px;
        }

    }

</style>


<main class="doctor-profile-page">

    <!-- =====================================================
         COVER
    ===================================================== -->

    <div class="doctor-profile-cover"></div>


    <div class="doctor-profile-container">

        <!-- =================================================
             MAIN PROFILE CARD
        ================================================= -->

        <section class="doctor-profile-card">

            <div class="doctor-profile-top">

                <!-- IMAGE -->

                <div class="doctor-profile-image-wrapper">

                    <% if (doctor.profileImage) { %>

                        <img
                            src="<%= doctor.profileImage.startsWith('/')
                                ? doctor.profileImage
                                : '/uploads/doctors/profile/' + doctor.profileImage %>"
                            alt="Dr. <%= doctorFullName %>"
                            class="doctor-profile-image"
                            onerror="
                                this.style.display='none';
                                this.nextElementSibling.style.display='flex';
                            "
                        >

                        <div
                            class="doctor-profile-placeholder"
                            style="display:none;"
                        >
                            <i class="fa-solid fa-user-doctor"></i>
                        </div>

                    <% } else { %>

                        <div class="doctor-profile-placeholder">

                            <i class="fa-solid fa-user-doctor"></i>

                        </div>

                    <% } %>

                </div>


                <!-- BASIC INFO -->

                <div class="doctor-profile-info">

                    <div class="doctor-profile-specialization">

                        <i class="fa-solid fa-stethoscope"></i>

                        <%= doctor.specialization ||
                            "Healthcare Professional" %>

                    </div>


                    <h1 class="doctor-profile-name">

                        Dr. <%= doctorFullName %>

                    </h1>


                    <% if (doctor.qualification) { %>

                        <div class="doctor-profile-qualification">

                            <i class="fa-solid fa-graduation-cap"></i>

                            <%= doctor.qualification %>

                        </div>

                    <% } %>


                    <% if (doctor.isVerified === true) { %>

                        <span class="doctor-profile-verified">

                            <i class="fa-solid fa-circle-check"></i>

                            Verified Doctor

                        </span>

                    <% } %>

                </div>

            </div>


            <!-- =================================================
                 DETAILS
            ================================================= -->

            <div class="doctor-details-grid">


                <% if (
                    doctor.experience !== undefined &&
                    doctor.experience !== null
                ) { %>

                    <div class="doctor-detail-box">

                        <div class="doctor-detail-icon">

                            <i class="fa-solid fa-briefcase"></i>

                        </div>

                        <div class="doctor-detail-content">

                            <small>
                                Experience
                            </small>

                            <strong>

                                <%= doctor.experience %>

                                <%= Number(doctor.experience) === 1
                                    ? "Year"
                                    : "Years" %>

                            </strong>

                        </div>

                    </div>

                <% } %>


                <div class="doctor-detail-box">

                    <div class="doctor-detail-icon">

                        <i class="fa-solid fa-location-dot"></i>

                    </div>

                    <div class="doctor-detail-content">

                        <small>
                            Location
                        </small>

                        <strong>
                            <%= doctor.displayLocation %>
                        </strong>

                    </div>

                </div>


                <% if (doctor.hospital) { %>

                    <div class="doctor-detail-box">

                        <div class="doctor-detail-icon">

                            <i class="fa-solid fa-hospital"></i>

                        </div>

                        <div class="doctor-detail-content">

                            <small>
                                Hospital
                            </small>

                            <strong>
                                <%= doctor.hospital %>
                            </strong>

                        </div>

                    </div>

                <% } %>


                <% if (doctor.clinic) { %>

                    <div class="doctor-detail-box">

                        <div class="doctor-detail-icon">

                            <i class="fa-solid fa-clinic-medical"></i>

                        </div>

                        <div class="doctor-detail-content">

                            <small>
                                Clinic
                            </small>

                            <strong>
                                <%= doctor.clinic %>
                            </strong>

                        </div>

                    </div>

                <% } %>


                <% if (doctor.registrationNumber) { %>

                    <div class="doctor-detail-box">

                        <div class="doctor-detail-icon">

                            <i class="fa-solid fa-id-card"></i>

                        </div>

                        <div class="doctor-detail-content">

                            <small>
                                Registration Number
                            </small>

                            <strong>
                                <%= doctor.registrationNumber %>
                            </strong>

                        </div>

                    </div>

                <% } %>


                <% if (doctor.followUpDays) { %>

                    <div class="doctor-detail-box">

                        <div class="doctor-detail-icon">

                            <i class="fa-solid fa-calendar-check"></i>

                        </div>

                        <div class="doctor-detail-content">

                            <small>
                                Follow-up
                            </small>

                            <strong>
                                <%= doctor.followUpDays %> Days
                            </strong>

                        </div>

                    </div>

                <% } %>


            </div>


            <!-- =================================================
                 FEES
            ================================================= -->

            <% if (
                doctor.consultationFee ||
                doctor.onlineConsultationFee
            ) { %>

                <div class="doctor-profile-section">

                    <h2>
                        Consultation Fees
                    </h2>

                    <div class="doctor-fees">

                        <% if (doctor.consultationFee) { %>

                            <div class="doctor-fee-box">

                                <small>
                                    Clinic Consultation
                                </small>

                                <strong>
                                    ₹<%= doctor.consultationFee %>
                                </strong>

                            </div>

                        <% } %>


                        <% if (doctor.onlineConsultationFee) { %>

                            <div class="doctor-fee-box">

                                <small>
                                    Online Consultation
                                </small>

                                <strong>
                                    ₹<%= doctor.onlineConsultationFee %>
                                </strong>

                            </div>

                        <% } %>

                    </div>

                </div>

            <% } %>


            <!-- =================================================
                 ABOUT
            ================================================= -->

            <div class="doctor-profile-section">

                <h2>
                    About Dr. <%= doctorFullName %>
                </h2>

                <p>

                    <%= doctor.bio ||
                        "This doctor has not added a professional biography yet." %>

                </p>

            </div>


            <!-- =================================================
                 LANGUAGES
            ================================================= -->

            <% if (doctor.languages) { %>

                <div class="doctor-profile-section">

                    <h2>
                        Languages
                    </h2>

                    <p>
                        <%= Array.isArray(doctor.languages)
                            ? doctor.languages.join(", ")
                            : doctor.languages %>
                    </p>

                </div>

            <% } %>


            <!-- =================================================
                 ACTIONS
            ================================================= -->

            <div class="doctor-profile-actions">

                <a
                    href="/doctors"
                    class="doctor-action-btn doctor-action-secondary"
                >

                    <i class="fa-solid fa-arrow-left"></i>

                    Back to Doctors

                </a>


                <!-- Login is required only when booking -->

                <a
    href="/auth/login?redirect=/patient/book-appointment?doctor=<%= doctor._id %>"
    class="doctor-action-btn doctor-action-primary"
>
    <i class="fa-solid fa-calendar-check"></i>
    Book Appointment
</a>

            </div>

        </section>

    </div>

</main>


<%- include("../layouts/footer") %>