                        <div class="department-icon">

                            <i class="fa-solid fa-heart-pulse"></i>

                        </div>


                        <h3>
                            Cardiology
                        </h3>


                        <p>
                            Specialized care for heart and
                            cardiovascular conditions including
                            regular cardiac checkups and diagnosis.
                        </p>


                        <a
                            href="/doctors?specialization=Cardiology"
