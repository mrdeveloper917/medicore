            <div class="department-hero-visual">

                <div class="hero-medical-card">

                    <div class="hero-medical-icon">

                        <i class="fa-solid fa-heart-pulse"></i>

                    </div>


                    <div>

                        <span>
                            MediCore Healthcare
                        </span>

                        <strong>
                            Specialized Care
                        </strong>

                    </div>


                    <div class="hero-check">

                        <i class="fa-solid fa-check"></i>

