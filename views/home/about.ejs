                <div class="step-connector"></div>


                <div class="step-card">

                    <div class="step-top">
                        <span class="step-number">03</span>

                        <div class="step-icon">
                            <svg viewBox="0 0 24 24" fill="none">
                                <path d="M20.8 8.9C20.8 13.7 12 20 12 20S3.2 13.7 3.2 8.9C3.2 5.7 5.7 3.5 8.5 3.5C10.1 3.5 11.5 4.3 12 5.5C12.5 4.3 13.9 3.5 15.5 3.5C18.3 3.5 20.8 5.7 20.8 8.9Z"
