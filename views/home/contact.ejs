<%- include("../layouts/header", { title: "Contact Us | MediCore" }) %>

<link rel="stylesheet" href="/css/home-contact.css">


<main class="public-contact-page">


    <!-- =========================================================
         HERO SECTION
    ========================================================== -->

    <section class="contact-hero">

        <div class="contact-container">

            <div class="contact-hero-content">

                <span class="contact-hero-badge">

                    <i class="fa-solid fa-headset"></i>

                    WE'RE HERE TO HELP

                </span>


                <h1>

                    Let's talk about
                    <span>your healthcare.</span>

                </h1>


                <p>

                    Have a question about MediCore, appointments,
                    doctors or our healthcare services? Our support
                    team is here to help you.

                </p>


                <div class="contact-hero-points">

                    <div>

                        <i class="fa-solid fa-circle-check"></i>

                        Quick Response

                    </div>


                    <div>

                        <i class="fa-solid fa-circle-check"></i>

                        Patient Support

                    </div>


                    <div>

                        <i class="fa-solid fa-circle-check"></i>

                        Secure Communication

                    </div>

                </div>

            </div>


            <!-- HERO CARD -->

            <div class="contact-hero-card">

                <div class="contact-hero-card-icon">

                    <i class="fa-solid fa-comments"></i>

                </div>


                <div>

                    <span>
                        Need assistance?
                    </span>

                    <strong>
                        Talk to our support team
                    </strong>

                    <small>
                        We're ready to answer your questions.
                    </small>

                </div>

            </div>

        </div>

    </section>



    <!-- =========================================================
         CONTACT INFORMATION
    ========================================================== -->

    <section class="contact-information">

        <div class="contact-container">


            <div class="contact-section-heading">

                <span class="contact-section-label">
                    GET IN TOUCH
                </span>


                <h2>
                    We're always here
                    <span>for you.</span>
                </h2>


                <p>
                    Reach out to MediCore using any of the
                    contact options below.
                </p>

            </div>



            <div class="contact-info-grid">


                <!-- =================================================
                     EMAIL
                ================================================== -->

                <a
                    href="mailto:support@medicore.com"
                    class="contact-info-card"
                >

                    <div class="contact-info-icon">

                        <i class="fa-regular fa-envelope"></i>

                    </div>


                    <div>

                        <span>
                            Email Us
                        </span>

                        <h3>
                            support@medicore.com
                        </h3>

                        <p>
                            Send us your questions anytime.
                        </p>

                    </div>


                    <i class="fa-solid fa-arrow-right contact-card-arrow"></i>

                </a>



                <!-- =================================================
                     PHONE
                ================================================== -->

                <a
                    href="tel:+911800123456"
                    class="contact-info-card"
                >

                    <div class="contact-info-icon">

                        <i class="fa-solid fa-phone"></i>

                    </div>


                    <div>

                        <span>
                            Call Us
                        </span>

                        <h3>
                            +91 1800 123 456
                        </h3>

                        <p>
                            Speak with our support team.
                        </p>

                    </div>


                    <i class="fa-solid fa-arrow-right contact-card-arrow"></i>

                </a>



                <!-- =================================================
                     LOCATION
                ================================================== -->

                <div class="contact-info-card">

                    <div class="contact-info-icon">

                        <i class="fa-solid fa-location-dot"></i>

                    </div>


                    <div>

                        <span>
                            Visit Us
                        </span>

                        <h3>
                            MediCore Healthcare
                        </h3>

                        <p>
                            Healthcare Centre, India
                        </p>

                    </div>


                    <i class="fa-solid fa-arrow-right contact-card-arrow"></i>

                </div>



                <!-- =================================================
                     WORKING HOURS
                ================================================== -->

                <div class="contact-info-card">

                    <div class="contact-info-icon">

                        <i class="fa-regular fa-clock"></i>

                    </div>


                    <div>

                        <span>
                            Working Hours
                        </span>

                        <h3>
                            Mon – Sat
                        </h3>

                        <p>
                            9:00 AM – 8:00 PM
                        </p>

                    </div>


                    <i class="fa-solid fa-arrow-right contact-card-arrow"></i>

                </div>


            </div>

        </div>

    </section>



    <!-- =========================================================
         CONTACT FORM + SUPPORT
    ========================================================== -->

    <section class="contact-main">

        <div class="contact-container">

            <div class="contact-main-grid">


                <!-- =================================================
                     CONTACT FORM
                ================================================== -->

                <div class="contact-form-card">

                    <div class="contact-form-header">

                        <span class="contact-section-label">
                            SEND US A MESSAGE
                        </span>


                        <h2>
                            How can we help?
                        </h2>


                        <p>
                            Fill out the form and our team will
                            get back to you as soon as possible.
                        </p>

                    </div>


                    <form
                        action="/contact"
                        method="POST"
                        class="medicore-contact-form"
                    >


                        <!-- NAME -->

                        <div class="contact-form-row">

                            <div class="contact-form-group">

                                <label for="name">
                                    Full Name
                                </label>

                                <div class="contact-input-wrapper">

                                    <i class="fa-regular fa-user"></i>

                                    <input
                                        type="text"
                                        id="name"
                                        name="name"
                                        placeholder="Enter your full name"
                                        autocomplete="name"
                                        required
                                    >

                                </div>

                            </div>


                            <!-- EMAIL -->

                            <div class="contact-form-group">

                                <label for="email">
                                    Email Address
                                </label>

                                <div class="contact-input-wrapper">

                                    <i class="fa-regular fa-envelope"></i>

                                    <input
                                        type="email"
                                        id="email"
                                        name="email"
                                        placeholder="Enter your email"
                                        autocomplete="email"
                                        required
                                    >

                                </div>

                            </div>

                        </div>



                        <!-- PHONE -->

                        <div class="contact-form-row">

                            <div class="contact-form-group">

                                <label for="phone">
                                    Phone Number
                                </label>

                                <div class="contact-input-wrapper">

                                    <i class="fa-solid fa-phone"></i>

                                    <input
                                        type="tel"
                                        id="phone"
                                        name="phone"
                                        placeholder="Enter your phone number"
                                        autocomplete="tel"
                                    >

                                </div>

                            </div>


                            <!-- SUBJECT -->

                            <div class="contact-form-group">

                                <label for="subject">
                                    Subject
                                </label>

                                <div class="contact-input-wrapper">

                                    <i class="fa-regular fa-pen-to-square"></i>

                                    <select
                                        id="subject"
                                        name="subject"
                                        required
                                    >

                                        <option value="">
                                            Select a subject
                                        </option>

                                        <option value="appointment">
                                            Appointment Support
                                        </option>

                                        <option value="doctor">
                                            Doctor Information
                                        </option>

                                        <option value="account">
                                            Account Support
                                        </option>

                                        <option value="technical">
                                            Technical Issue
                                        </option>

                                        <option value="general">
                                            General Enquiry
                                        </option>

                                    </select>

                                </div>

                            </div>

                        </div>



                        <!-- MESSAGE -->

                        <div class="contact-form-group">

                            <label for="message">
                                Message
                            </label>

                            <div class="contact-textarea-wrapper">

                                <i class="fa-regular fa-message"></i>

                                <textarea
                                    id="message"
                                    name="message"
                                    rows="6"
                                    placeholder="Tell us how we can help you..."
                                    required
                                ></textarea>

                            </div>

                        </div>



                        <!-- PRIVACY -->

                        <label class="contact-consent">

                            <input
                                type="checkbox"
                                name="consent"
                                required
                            >

                            <span>

                                I agree that MediCore may use my
                                information to respond to this enquiry.

                            </span>

                        </label>



                        <!-- SUBMIT -->

                        <button
                            type="submit"
                            class="contact-submit-btn"
                        >

                            Send Message

                            <i class="fa-solid fa-arrow-right"></i>

                        </button>


                    </form>

                </div>



                <!-- =================================================
                     RIGHT SIDE SUPPORT
                ================================================== -->

                <aside class="contact-support-column">


                    <!-- EMERGENCY -->

                    <div class="emergency-contact-card">

                        <div class="emergency-icon">

                            <i class="fa-solid fa-phone-volume"></i>

                        </div>


                        <span>
                            MEDICAL EMERGENCY
                        </span>


                        <h3>
                            Need urgent medical help?
                        </h3>


                        <p>
                            For a medical emergency, please contact
                            your local emergency service immediately.
                        </p>


                        <a
                            href="tel:112"
                            class="emergency-call-btn"
                        >

                            <i class="fa-solid fa-phone"></i>

                            Emergency: 112

                        </a>

                    </div>



                    <!-- SUPPORT -->

                    <div class="support-card">

                        <div class="support-card-heading">

                            <div class="support-icon">

                                <i class="fa-solid fa-headset"></i>

                            </div>


                            <div>

                                <span>
                                    SUPPORT
                                </span>

                                <h3>
                                    Need platform help?
                                </h3>

                            </div>

                        </div>


                        <div class="support-list">


                            <div class="support-list-item">

                                <i class="fa-solid fa-circle-check"></i>

                                <span>
                                    Account assistance
                                </span>

                            </div>


                            <div class="support-list-item">

                                <i class="fa-solid fa-circle-check"></i>

                                <span>
                                    Appointment guidance
                                </span>

                            </div>


                            <div class="support-list-item">

                                <i class="fa-solid fa-circle-check"></i>

                                <span>
                                    Doctor search assistance
                                </span>

                            </div>


                            <div class="support-list-item">

                                <i class="fa-solid fa-circle-check"></i>

                                <span>
                                    Technical support
                                </span>

                            </div>


                        </div>


                        <a
                            href="mailto:support@medicore.com"
                            class="support-email-btn"
                        >

                            Email Support

                            <i class="fa-solid fa-arrow-right"></i>

                        </a>

                    </div>


                </aside>

            </div>

        </div>

    </section>



    <!-- =========================================================
         QUICK QUESTIONS
    ========================================================== -->

    <section class="contact-faq">

        <div class="contact-container">

            <div class="contact-section-heading">

                <span class="contact-section-label">
                    QUICK INFORMATION
                </span>


                <h2>
                    Before you contact us
                </h2>


                <p>
                    Here are answers to some common questions
                    about the MediCore platform.
                </p>

            </div>



            <div class="contact-faq-grid">


                <details class="contact-faq-item">

                    <summary>

                        How can I book an appointment?

                        <i class="fa-solid fa-plus"></i>

                    </summary>

                    <p>
                        Visit the Doctors section, choose a doctor
                        according to your healthcare requirement,
                        and continue with the appointment process.
                    </p>

                </details>



                <details class="contact-faq-item">

                    <summary>

                        Can I view doctors without an account?

                        <i class="fa-solid fa-plus"></i>

                    </summary>

                    <p>
                        Yes. Basic public information about doctors
                        can be explored without accessing private
                        patient information.
                    </p>

                </details>



                <details class="contact-faq-item">

                    <summary>

                        Is my medical information public?

                        <i class="fa-solid fa-plus"></i>

                    </summary>

                    <p>
                        No. Private healthcare information should
                        only be accessible through the appropriate
                        authenticated account.
                    </p>

                </details>



                <details class="contact-faq-item">

                    <summary>

                        How can I contact support?

                        <i class="fa-solid fa-plus"></i>

                    </summary>

                    <p>
                        You can use the contact form above or email
                        our support team directly.
                    </p>

                </details>


            </div>

        </div>

    </section>



    <!-- =========================================================
         FINAL CTA
    ========================================================== -->

    <section class="contact-cta">

        <div class="contact-container">

            <div class="contact-cta-content">

                <div>

                    <span class="contact-section-label">
                        MEDICORE HEALTHCARE
                    </span>


                    <h2>
                        Your health matters to us.
                    </h2>


                    <p>
                        Explore our doctors and healthcare services
                        or reach out to our team whenever you need help.
                    </p>

                </div>


                <div class="contact-cta-actions">

                    <a
                        href="/doctors"
                        class="contact-cta-primary"
                    >

                        Find a Doctor

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>


                    <a
                        href="/departments"
                        class="contact-cta-secondary"
                    >

                        Departments

                    </a>

                </div>

            </div>

        </div>

    </section>


</main>


<%- include("../layouts/footer") %>