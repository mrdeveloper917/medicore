
<%- include("../layouts/header", {
    title: "AI Help & Support | MediCore"
}) %>

<link rel="stylesheet" href="/css/help.css">

<main class="mc-help-page">

    <div class="mc-help-container">

        <!-- =====================================================
             HERO
        ====================================================== -->

        <section class="mc-help-hero">

            <span class="mc-help-badge">
                <i class="fa-solid fa-sparkles"></i>
                AI-POWERED SUPPORT
            </span>

            <h1>
                How can
                <span>MediCore AI</span>
                help you?
            </h1>

            <p>
                Ask anything about appointments,
                doctors, payments, prescriptions,
                reports, account settings and
                MediCore features.
            </p>

        </section>


        <!-- =====================================================
             AI ASSISTANT
        ====================================================== -->

        <section class="mc-ai-card">

            <!-- HEADER -->

            <div class="mc-ai-header">

                <div class="mc-ai-header-left">

                    <div class="mc-ai-header-icon">
                        <i class="fa-solid fa-robot"></i>
                    </div>

                    <div class="mc-ai-header-text">

                        <strong>
                            MediCore AI Assistant
                        </strong>

                        <small>
                            Instant help for your MediCore questions
                        </small>

                    </div>

                </div>

                <span class="mc-ai-online">

                    <span class="mc-ai-online-dot"></span>

                    AI Online

                </span>

            </div>


            <!-- =================================================
                 CHAT
            ================================================== -->

            <div
                class="mc-ai-chat"
                id="mcAiChat"
                aria-live="polite"
            >

                <!-- INITIAL AI MESSAGE -->

                <div class="mc-ai-message mc-ai-message-assistant">

                    <div class="mc-ai-avatar">
                        <i class="fa-solid fa-robot"></i>
                    </div>

                    <div class="mc-ai-bubble">

                        Hi! 👋
                        I'm
                        <strong>MediCore AI</strong>.

                        <br>
                        <br>

                        Ask me how to book an
                        appointment, make a payment,
                        find a doctor, view a prescription,
                        access a report, or use any
                        MediCore feature.

                    </div>

                </div>

            </div>


            <!-- =================================================
                 QUICK QUESTIONS
            ================================================== -->

            <div class="mc-ai-suggestions">

                <button
                    type="button"
                    class="mc-ai-suggestion"
                    data-ai-question="How do I book a doctor appointment?"
                >
                    📅 Book appointment
                </button>

                <button
                    type="button"
                    class="mc-ai-suggestion"
                    data-ai-question="How can I make a payment for my appointment?"
                >
                    💳 Payment help
                </button>

                <button
                    type="button"
                    class="mc-ai-suggestion"
                    data-ai-question="Where can I find my prescriptions?"
                >
                    💊 Prescriptions
                </button>

                <button
                    type="button"
                    class="mc-ai-suggestion"
                    data-ai-question="Where can I view my medical reports?"
                >
                    📄 Medical reports
                </button>

                <button
                    type="button"
                    class="mc-ai-suggestion"
                    data-ai-question="How can I cancel my appointment?"
                >
                    ❌ Cancel appointment
                </button>

                <button
                    type="button"
                    class="mc-ai-suggestion"
                    data-ai-question="How do I find a doctor by specialization?"
                >
                    🩺 Find a doctor
                </button>

            </div>


            <!-- =================================================
                 INPUT
            ================================================== -->

            <form
                class="mc-ai-form"
                id="mcAiForm"
                autocomplete="off"
            >

                <div class="mc-ai-input-wrap">

                    <input
                        type="text"
                        id="mcAiInput"
                        class="mc-ai-input"
                        maxlength="2000"
                        placeholder="Ask MediCore AI anything..."
                        aria-label="Ask MediCore AI"
                        required
                    >

                </div>

                <button
                    type="submit"
                    id="mcAiSend"
                    class="mc-ai-send"
                    aria-label="Send question"
                >
                    <i class="fa-solid fa-paper-plane"></i>
                </button>

            </form>


            <!-- =================================================
                 PRIVACY
            ================================================== -->

            <div class="mc-ai-privacy">

                <i class="fa-solid fa-shield-halved"></i>

                <span>
                    Never share passwords, OTPs,
                    API keys or other secrets.
                    Medical decisions should be
                    made with a qualified doctor.
                </span>

            </div>

        </section>

    </div>

</main>


<script
    src="/js/ai-assistant.js"
    defer
></script>

<%- include("../layouts/footer") %>

