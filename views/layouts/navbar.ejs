<!-- =========================================================
     MEDICORE NAVBAR CSS
========================================================= -->

<style>

:root {

    --mc-primary: #0f766e;

    --mc-primary-dark: #115e59;

    --mc-primary-light: #14b8a6;

    --mc-primary-soft: #ecfdf5;

    --mc-text: #0f172a;

    --mc-text-secondary: #475569;

    --mc-muted: #94a3b8;

    --mc-border: #e2e8f0;

    --mc-white: #ffffff;

}


/* =========================================================
   HEADER
========================================================= */

.mc-header {

    position: sticky;

    top: 0;

    z-index: 99999;

    width: 100%;

    background:
        rgba(255, 255, 255, 0.96);

    border-bottom:
        1px solid rgba(226, 232, 240, 0.85);

    backdrop-filter:
        blur(20px);

    -webkit-backdrop-filter:
        blur(20px);

    box-shadow:
        0 5px 25px rgba(15, 23, 42, 0.06);

}


/* =========================================================
   NAVBAR
========================================================= */

.mc-navbar {

    position: relative;

    width: 100%;

}


.mc-navbar-container {

    width:
        min(1400px, calc(100% - 48px));

    min-height: 76px;

    margin: auto;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 30px;

}


/* =========================================================
   LOGO
========================================================= */

.mc-logo {

    display: inline-flex;

    align-items: center;

    gap: 11px;

    flex-shrink: 0;

    text-decoration: none;

}


.mc-logo-icon {

    width: 45px;

    height: 45px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 14px;

    color: #ffffff;

    background:
        linear-gradient(
            135deg,
            var(--mc-primary),
            var(--mc-primary-light)
        );

    box-shadow:
        0 8px 22px rgba(15, 118, 110, .22);

    font-size: 21px;

    transition:
        transform .3s ease,
        box-shadow .3s ease;

}


.mc-logo:hover .mc-logo-icon {

    transform:
        rotate(-5deg)
        scale(1.04);

    box-shadow:
        0 12px 28px rgba(15, 118, 110, .28);

}


.mc-logo-content {

    display: flex;

    flex-direction: column;

    line-height: 1;

}


.mc-logo-name {

    color: var(--mc-text);

    font-size: 23px;

    font-weight: 800;

    letter-spacing: -.7px;

}


.mc-logo-name span {

    color: var(--mc-primary);

}


.mc-logo-tagline {

    margin-top: 5px;

    color: var(--mc-muted);

    font-size: 7px;

    font-weight: 700;

    letter-spacing: 1.4px;

}


/* =========================================================
   DESKTOP NAVIGATION
========================================================= */

.mc-desktop-navigation {

    display: flex;

    align-items: center;

    gap: 22px;

    margin-left: auto;

}


.mc-nav-links {

    display: flex;

    align-items: center;

    gap: 3px;

    margin: 0;

    padding: 0;

    list-style: none;

}


.mc-nav-links li {

    position: relative;

}


.mc-nav-links li a {

    position: relative;

    display: flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    min-height: 43px;

    padding: 9px 12px;

    color: var(--mc-text-secondary);

    border-radius: 11px;

    text-decoration: none;

    font-size: 13px;

    font-weight: 600;

    white-space: nowrap;

    transition:
        color .25s ease,
        background .25s ease,
        transform .25s ease;

}


.mc-nav-links li a i {

    color: #94a3b8;

    font-size: 13px;

    transition:
        color .25s ease,
        transform .25s ease;

}


.mc-nav-links li a:hover {

    color: var(--mc-primary);

    background: var(--mc-primary-soft);

    transform: translateY(-1px);

}


.mc-nav-links li a:hover i {

    color: var(--mc-primary);

    transform: translateY(-1px);

}


/* =========================================================
   ACTIVE
========================================================= */

.mc-nav-links li a.active {

    color: var(--mc-primary);

    background:
        linear-gradient(
            135deg,
            #ecfdf5,
            #f0fdfa
        );

}


.mc-nav-links li a.active i {

    color: var(--mc-primary);

}


.mc-nav-links li a.active::after {

    content: "";

    position: absolute;

    left: 50%;

    bottom: 2px;

    width: 22px;

    height: 3px;

    border-radius: 20px;

    background: var(--mc-primary-light);

    transform: translateX(-50%);

}


/* =========================================================
   AUTH BUTTONS
========================================================= */

.mc-auth-buttons {

    display: flex;

    align-items: center;

    gap: 8px;

}


.mc-login-button,
.mc-register-button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 7px;

    min-height: 43px;

    padding: 9px 15px;

    border-radius: 11px;

    text-decoration: none;

    font-size: 13px;

    font-weight: 700;

    white-space: nowrap;

    transition:
        transform .25s ease,
        box-shadow .25s ease,
        background .25s ease;

}


.mc-login-button {

    color: var(--mc-primary);

    background: var(--mc-primary-soft);

    border:
        1px solid #ccfbf1;

}


.mc-login-button:hover {

    transform: translateY(-2px);

    background: #dffaf4;

    box-shadow:
        0 8px 20px rgba(15, 118, 110, .10);

}


.mc-register-button {

    color: #ffffff;

    background:
        linear-gradient(
            135deg,
            var(--mc-primary),
            var(--mc-primary-light)
        );

    box-shadow:
        0 8px 20px rgba(15, 118, 110, .18);

}


.mc-register-button:hover {

    color: #ffffff;

    transform: translateY(-2px);

    box-shadow:
        0 12px 27px rgba(15, 118, 110, .27);

}


.mc-register-button i {

    font-size: 11px;

    transition:
        transform .25s ease;

}


.mc-register-button:hover i {

    transform:
        translateX(3px);

}


/* =========================================================
   MOBILE TOGGLE
========================================================= */

.mc-mobile-toggle {

    display: none;

    width: 46px;

    height: 46px;

    padding: 0;

    margin-left: auto;

    align-items: center;

    justify-content: center;

    border:
        1px solid #dbe7e5;

    border-radius: 13px;

    background: #ffffff;

    cursor: pointer;

    box-shadow:
        0 5px 15px rgba(15, 23, 42, .05);

    transition:
        background .25s ease,
        border-color .25s ease,
        transform .2s ease;

}


.mc-mobile-toggle:hover {

    background: var(--mc-primary-soft);

    border-color:
        rgba(20, 184, 166, .35);

}


.mc-mobile-toggle:active {

    transform:
        scale(.94);

}


.mc-hamburger {

    width: 22px;

    height: 18px;

    display: flex;

    flex-direction: column;

    justify-content: space-between;

}


.mc-hamburger span {

    display: block;

    width: 100%;

    height: 2px;

    border-radius: 20px;

    background: var(--mc-primary);

    transition:
        transform .3s ease,
        opacity .2s ease;

}


/* =========================================================
   HAMBURGER → X
========================================================= */

.mc-mobile-toggle.is-open
.mc-hamburger span:nth-child(1) {

    transform:
        translateY(8px)
        rotate(45deg);

}


.mc-mobile-toggle.is-open
.mc-hamburger span:nth-child(2) {

    opacity: 0;

}


.mc-mobile-toggle.is-open
.mc-hamburger span:nth-child(3) {

    transform:
        translateY(-8px)
        rotate(-45deg);

}


/* =========================================================
   MOBILE MENU
========================================================= */

.mc-mobile-menu {

    position: absolute;

    top: calc(100% + 9px);

    left: 12px;

    right: 12px;

    z-index: 99998;

    opacity: 0;

    visibility: hidden;

    pointer-events: none;

    transform:
        translateY(-12px)
        scale(.98);

    transform-origin:
        top center;

    transition:
        opacity .25s ease,
        visibility .25s ease,
        transform .25s ease;

}


.mc-mobile-menu.is-open {

    opacity: 1;

    visibility: visible;

    pointer-events: auto;

    transform:
        translateY(0)
        scale(1);

}


.mc-mobile-menu-inner {

    width: 100%;

    max-width: 620px;

    margin:
        0 auto;

    padding: 15px;

    background:
        rgba(255, 255, 255, .99);

    border:
        1px solid rgba(226, 232, 240, .95);

    border-radius: 20px;

    box-shadow:
        0 25px 60px rgba(15, 23, 42, .16);

    backdrop-filter:
        blur(24px);

    -webkit-backdrop-filter:
        blur(24px);

}


/* =========================================================
   MOBILE MENU HEADER
========================================================= */

.mc-mobile-menu-header {

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding:
        3px 4px 13px;

    margin-bottom: 5px;

    border-bottom:
        1px solid #eef2f2;

}


.mc-mobile-menu-title {

    display: flex;

    align-items: center;

    gap: 10px;

}


.mc-mobile-menu-icon {

    width: 37px;

    height: 37px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 11px;

    color: #ffffff;

    background:
        linear-gradient(
            135deg,
            var(--mc-primary),
            var(--mc-primary-light)
        );

    font-size: 16px;

}


.mc-mobile-menu-title div {

    display: flex;

    flex-direction: column;

}


.mc-mobile-menu-title strong {

    color: var(--mc-text);

    font-size: 14px;

    font-weight: 800;

}


.mc-mobile-menu-title small {

    margin-top: 2px;

    color: var(--mc-muted);

    font-size: 9px;

}


.mc-mobile-menu-label {

    padding:
        5px 9px;

    color: var(--mc-primary);

    background: var(--mc-primary-soft);

    border-radius: 20px;

    font-size: 8px;

    font-weight: 800;

    letter-spacing: 1px;

}


/* =========================================================
   MOBILE LINKS
========================================================= */

.mc-mobile-links {

    display: flex;

    flex-direction: column;

    gap: 5px;

    margin: 0;

    padding: 0;

    list-style: none;

}


.mc-mobile-links li {

    width: 100%;

}


.mc-mobile-links li a {

    position: relative;

    display: flex;

    align-items: center;

    width: 100%;

    min-height: 58px;

    padding:
        8px 10px;

    gap: 11px;

    color: var(--mc-text);

    text-decoration: none;

    border-radius: 13px;

    transition:
        background .2s ease,
        transform .2s ease;

}


.mc-mobile-links li a:hover {

    background:
        var(--mc-primary-soft);

    transform:
        translateX(2px);

}


.mc-mobile-links li a.active {

    background:
        linear-gradient(
            135deg,
            #ecfdf5,
            #f0fdfa
        );

}


.mc-mobile-link-icon {

    width: 40px;

    height: 40px;

    flex-shrink: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    color: var(--mc-primary);

    background:
        #f0fdfa;

    border:
        1px solid #d8f5ef;

    border-radius: 11px;

    font-size: 15px;

    transition:
        background .2s ease,
        transform .2s ease;

}


.mc-mobile-links a:hover
.mc-mobile-link-icon {

    background:
        #d9f7f0;

    transform:
        scale(1.04);

}


.mc-mobile-link-text {

    min-width: 0;

    display: flex;

    flex: 1;

    flex-direction: column;

}


.mc-mobile-link-text strong {

    color: var(--mc-text);

    font-size: 13px;

    font-weight: 700;

}


.mc-mobile-link-text small {

    margin-top: 2px;

    color: var(--mc-muted);

    font-size: 9px;

    white-space: nowrap;

}


.mc-arrow {

    margin-left: auto;

    color: #b0bdc5;

    font-size: 10px;

    transition:
        transform .2s ease,
        color .2s ease;

}


.mc-mobile-links a:hover
.mc-arrow {

    color: var(--mc-primary);

    transform:
        translateX(3px);

}


/* =========================================================
   ACTIVE LEFT INDICATOR
========================================================= */

.mc-mobile-links a.active::before {

    content: "";

    position: absolute;

    left: 0;

    top: 50%;

    width: 3px;

    height: 27px;

