    font-weight: 700;

}


.mc-mobile-login {

    color: var(--mc-primary);

    background:
        var(--mc-primary-soft);

    border:
        1px solid #ccfbf1;

}


.mc-mobile-register {

    color: #ffffff;

    background:
        linear-gradient(
            135deg,
