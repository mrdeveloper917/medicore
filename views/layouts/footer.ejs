<style>
/* =========================================================
   MEDICORE PREMIUM FOOTER
========================================================= */

.footer {
    position: relative;
    margin-top: 70px;
    color: #fff;
    background:
        radial-gradient(circle at 10% 20%, rgba(13,110,253,.16), transparent 28%),
        radial-gradient(circle at 90% 80%, rgba(32,201,151,.10), transparent 25%),
        linear-gradient(135deg, #061426 0%, #0a203b 50%, #0b2947 100%);
    overflow: hidden;
}

/* Top Gradient Line */
.footer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(
        90deg,
        #0d6efd,
        #00b4d8,
        #20c997,
        #0d6efd
    );
    background-size: 300% 100%;
    animation: footerGradient 6s linear infinite;
}

@keyframes footerGradient {
    0% {
        background-position: 0% 50%;
    }
    100% {
        background-position: 300% 50%;
    }
}

/* Decorative circles */
.footer::after {
    content: "";
    position: absolute;
    width: 300px;
    height: 300px;
    right: -150px;
    top: -150px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.06);
    box-shadow:
        0 0 0 40px rgba(255,255,255,.015),
        0 0 0 80px rgba(255,255,255,.01);
    pointer-events: none;
}

/* =========================================================
   CONTAINER
========================================================= */

.footer-container {
    position: relative;
    z-index: 2;

    width: 90%;
    max-width: 1250px;
    margin: auto;

    display: grid;
    grid-template-columns:
        1.5fr
        1fr
        1fr
        1.2fr;

    gap: 50px;

    padding: 70px 0 55px;
}

/* =========================================================
   FOOTER BOX
========================================================= */

.footer-box {
    position: relative;
}

.footer-box h2 {
    margin: 0;
    font-size: 28px;
    font-weight: 750;
    letter-spacing: .4px;
}

.footer-box h3 {
    position: relative;
    display: inline-block;

    margin: 5px 0 25px;

    font-size: 17px;
    font-weight: 650;
    letter-spacing: .3px;

    padding-bottom: 11px;
}

.footer-box h3::after {
    content: "";
    position: absolute;

    left: 0;
    bottom: 0;

    width: 38px;
    height: 3px;

    border-radius: 20px;

    background: linear-gradient(
        90deg,
        #0d6efd,
        #20c997
    );
}

/* =========================================================
   BRAND
========================================================= */

.footer-brand {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 20px;
}

.footer-logo {
    width: 48px;
    height: 48px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 14px;

    background: linear-gradient(
        135deg,
        #0d6efd,
        #00b4d8
    );

    font-size: 25px;
    font-weight: 800;

    box-shadow:
        0 10px 25px rgba(13,110,253,.28),
        inset 0 1px 1px rgba(255,255,255,.25);

    transition: .35s ease;
}

.footer-brand:hover .footer-logo {
    transform: translateY(-4px) rotate(-4deg);
    box-shadow:
        0 15px 35px rgba(13,110,253,.38);
}

.footer-tagline {
    max-width: 350px;
}

.footer-box p {
    color: #b9c7d8;

    font-size: 14px;
    line-height: 1.75;

    margin: 0 0 13px;
}

/* =========================================================
   QUICK LINKS / DEPARTMENTS
========================================================= */

.footer-box a {
    position: relative;

    display: flex;
    align-items: center;

    width: fit-content;

    margin-bottom: 14px;

    color: #b9c7d8;

    font-size: 14px;
    font-weight: 450;

    text-decoration: none;

    transition:
        color .25s ease,
        transform .25s ease;
}

.footer-box a::before {
    content: "›";

    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 22px;
    height: 22px;

    margin-right: 8px;

    color: #0d6efd;

    font-size: 19px;

    border-radius: 50%;

    transition: .25s ease;
}

.footer-box a:hover {
    color: #fff;
    transform: translateX(6px);
}

.footer-box a:hover::before {
    color: #20c997;

    background: rgba(32,201,151,.10);

    transform: translateX(2px);
}

/* =========================================================
   CONTACT
========================================================= */

.contact-item {
    display: flex;
    align-items: center;

    gap: 13px;

    margin-bottom: 16px;

    padding: 9px 10px;

    border-radius: 12px;

    transition: .3s ease;
}

.contact-item:hover {
    background: rgba(255,255,255,.045);
    transform: translateX(4px);
}

.contact-icon {
    flex-shrink: 0;

    width: 36px;
    height: 36px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    color: #7dc8ff;

    background: rgba(13,110,253,.13);

    border: 1px solid rgba(13,110,253,.16);

    font-size: 15px;

    transition: .3s ease;
}

.contact-item:hover .contact-icon {
    color: #fff;

    background: linear-gradient(
        135deg,
        #0d6efd,
        #00b4d8
    );

    transform: scale(1.05);
}

.contact-item p {
    margin: 0;
    color: #c7d3e1;
}

/* =========================================================
   AVAILABILITY BADGE
========================================================= */

.availability {
    display: inline-flex;

    align-items: center;
    gap: 8px;

    margin-top: 5px;

    padding: 8px 13px;

    border-radius: 30px;

    font-size: 12px;
    font-weight: 600;

    color: #7ff0c6;

    background: rgba(32,201,151,.08);

    border: 1px solid rgba(32,201,151,.16);
}

.availability-dot {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: #20c997;

    box-shadow:
        0 0 0 4px rgba(32,201,151,.10),
        0 0 12px rgba(32,201,151,.5);

    animation: pulseDot 2s infinite;
}

@keyframes pulseDot {
    0%, 100% {
        opacity: 1;
        transform: scale(1);
    }

    50% {
        opacity: .55;
        transform: scale(.85);
    }
}

/* =========================================================
   SOCIAL ICONS
========================================================= */

.footer-social {
    display: flex;
    gap: 10px;

    margin-top: 23px;
}

.footer-social a {
    width: 36px;
    height: 36px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin: 0;

    border-radius: 10px;

    color: #b9c7d8;

    background: rgba(255,255,255,.05);

    border: 1px solid rgba(255,255,255,.08);

    font-size: 14px;

    transition: .3s ease;
}

.footer-social a::before {
    display: none;
}

.footer-social a:hover {
    color: #fff;

    background: linear-gradient(
        135deg,
        #0d6efd,
        #00b4d8
    );

    border-color: transparent;

    transform: translateY(-4px);
}

/* =========================================================
   FOOTER BOTTOM
========================================================= */

.footer-bottom {
    position: relative;
    z-index: 2;

    width: 90%;
    max-width: 1250px;

    margin: auto;

    padding: 22px 0;

    border-top: 1px solid rgba(255,255,255,.09);

    display: flex;
    justify-content: space-between;
    align-items: center;

    gap: 20px;

    color: #8293a8;

    font-size: 13px;
}

.footer-bottom p {
    margin: 0;
}

.footer-bottom strong {
    color: #fff;
}

.footer-credit {
    color: #8293a8;
}

.footer-credit span {
    margin: 0 5px;

    color: #20c997;
    font-weight: 700;
}

/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1000px) {

    .footer-container {
        grid-template-columns: repeat(2, 1fr);
        gap: 45px;
    }
}

@media (max-width: 600px) {

    .footer {
        margin-top: 50px;
    }

    .footer-container {
        width: 88%;

        grid-template-columns: 1fr;

        gap: 35px;

        padding: 50px 0 35px;
    }

    .footer-box h2 {
        font-size: 25px;
    }

    .footer-box h3 {
        margin-bottom: 20px;
    }

    .footer-tagline {
        max-width: 100%;
    }

    .footer-bottom {
        width: 88%;

        flex-direction: column;

        text-align: center;

        padding: 20px 0;
    }

    .footer-social {
        margin-top: 18px;
    }
}

@media (prefers-reduced-motion: reduce) {

    .footer::before,
    .availability-dot {
        animation: none;
    }

    .footer-box a,
    .contact-item,
    .footer-logo,
    .footer-social a {
        transition: none;
    }
}
</style>

