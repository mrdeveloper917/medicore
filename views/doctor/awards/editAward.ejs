<%- include("../../layouts/doctorHeader") %>

    <div class="awards-container">

        <div class="awards-header">

            <h2 class="awards-title">
                ✏️ Edit Award
            </h2>

            <a href="/doctor/awards" class="back-btn">
                ← Back
            </a>

        </div>

        <% if (typeof error !=="undefined" && error) { %>

            <div class="error-message">
                <%= error %>
            </div>

            <% } %>

                <div class="award-form-card">

                    <form action="/doctor/awards/update/<%= award._id %>" method="POST" enctype="multipart/form-data">

                        <div class="form-group">

                            <label>Award Title</label>

                            <input type="text" name="title" class="award-input" value="<%= award.title %>" required>

                        </div>

                        <div class="form-group">

                            <label>Organization</label>

                            <input type="text" name="organization" class="award-input" value="<%= award.organization %>"
                                required>

                        </div>

                        <div class="form-group">

                            <label>Award Date</label>

                            <input type="date" name="awardDate" class="award-input"
                                value="<%= award.awardDate.toISOString().split('T')[0] %>" required>

                        </div>

                        <div class="form-group">

                            <label>Description</label>

                            <textarea name="description" class="award-textarea"
                                rows="5"><%= award.description || "" %></textarea>

                        </div>

                        <div class="form-group">

                            <label>Current Certificate</label>

                            <div class="certificate-preview">

                                <% if (award.certificate) { %>

                                    <% if (award.certificate.endsWith(".pdf")) { %>

                                        <img src="<%= (user && user.profileImage) ? user.profileImage : '/images/default-user.png' %>"
                                            alt="Profile">

                                        📄 View PDF

                                        </a>

                                        <% } else { %>

                                            <img src="/uploads/doctors/awards/<%= award.certificate %>"
                                                class="certificate-img" alt="Certificate">

                                            <% } %>

                                                <% } else { %>

                                                    <p class="text-muted">
                                                        No Certificate Uploaded
                                                    </p>

                                                    <% } %>

                            </div>

                        </div>

                        <div class="form-group">

                            <label>Replace Certificate</label>

                            <input type="file" name="certificate" class="award-file" accept=".jpg,.jpeg,.png,.pdf">

                        </div>

                        <div class="button-group">

                            <button type="submit" class="save-btn">

                                💾 Update Award

                            </button>

                            <a href="/doctor/awards" class="cancel-btn">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

    </div>

    <%- include("../../layouts/footer") %>