<%- include("../../layouts/doctorHeader") %>

<div class="awards-container">

    <div class="awards-header">
        <h2 class="awards-title">
            🏆 Add Award
        </h2>

        <a href="/doctor/awards" class="back-btn">
            ← Back to Awards
        </a>
    </div>

    <% if (typeof success !== "undefined" && success) { %>
        <div class="success-message">
            <%= success %>
        </div>
    <% } %>

    <% if (typeof error !== "undefined" && error) { %>
        <div class="error-message">
            <%= error %>
        </div>
    <% } %>

    <div class="award-form-card">

        <form action="/doctor/awards/add" method="POST" enctype="multipart/form-data">

            <div class="form-group">
                <label>Award Title</label>

                <input
                    type="text"
                    name="title"
                    class="award-input"
                    placeholder="Enter Award Title"
                    value="<%= typeof old !== 'undefined' ? old.title : '' %>"
                    required>
            </div>

            <div class="form-group">
                <label>Organization</label>

                <input
                    type="text"
                    name="organization"
                    class="award-input"
                    placeholder="Organization Name"
                    value="<%= typeof old !== 'undefined' ? old.organization : '' %>"
                    required>
            </div>

            <div class="form-group">
                <label>Award Date</label>

                <input
                    type="date"
                    name="awardDate"
                    class="award-input"
                    value="<%= typeof old !== 'undefined' ? old.awardDate : '' %>"
                    required>
            </div>

            <div class="form-group">
                <label>Description</label>

                <textarea
                    name="description"
                    class="award-textarea"
                    rows="5"
                    placeholder="Write Award Description"><%= typeof old !== 'undefined' ? old.description : '' %></textarea>
            </div>

            <div class="form-group">

                <label>Certificate (JPG, PNG, PDF)</label>

                <input
                    type="file"
                    name="certificate"
                    class="award-file"
                    accept=".jpg,.jpeg,.png,.pdf">

            </div>

            <div class="button-group">

                <button type="submit" class="save-btn">
                    💾 Save Award
                </button>

                <a href="/doctor/awards" class="cancel-btn">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

<%- include("../../layouts/doctorFooter") %>