<%- include("../../layouts/doctorHeader") %>

<style>
    .patient-page {
        padding: 25px;
        background: #f5f7fb;
        min-height: calc(100vh - 100px);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .page-header h1 {
        margin: 0;
        font-size: 28px;
        color: #1f2937;
    }

    .page-header p {
        margin: 6px 0 0;
        color: #6b7280;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 18px;
        border-radius: 10px;
        background: #ffffff;
        color: #374151;
        text-decoration: none;
        border: 1px solid #e5e7eb;
        transition: 0.2s;
    }

    .back-btn:hover {
        background: #f3f4f6;
    }

    .profile-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 25px;
        display: flex;
        align-items: center;
        gap: 22px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
        margin-bottom: 25px;
    }

    .profile-image {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #eef2ff;
    }

    .profile-placeholder {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: #eef2ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 40px;
        color: #6366f1;
        font-weight: 700;
    }

    .profile-info h2 {
        margin: 0 0 8px;
        color: #111827;
        font-size: 24px;
    }

    .profile-info p {
        margin: 5px 0;
        color: #6b7280;
    }

    .profile-info i {
        width: 20px;
        color: #6366f1;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: #ffffff;
        border-radius: 15px;
        padding: 20px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
    }

    .stat-card .icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        background: #eef2ff;
        color: #6366f1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin-bottom: 12px;
    }

    .stat-card h3 {
        margin: 0;
        font-size: 27px;
        color: #111827;
    }

    .stat-card p {
        margin: 5px 0 0;
        color: #6b7280;
    }

    .content-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
    }

    .card {
        background: #ffffff;
        border-radius: 16px;
        padding: 22px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.05);
    }

    .card.full {
        grid-column: 1 / -1;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .card-header h3 {
        margin: 0;
        color: #1f2937;
        font-size: 19px;
    }

    .view-all {
        color: #6366f1;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }

    .appointment-item {
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 12px;
    }

    .appointment-item:last-child {
        margin-bottom: 0;
    }

    .appointment-top {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 8px;
    }

    .appointment-date {
        font-weight: 600;
        color: #111827;
    }

    .appointment-meta {
        color: #6b7280;
        font-size: 14px;
        margin-top: 5px;
    }

    .status {
        display: inline-flex;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status.approved {
        background: #dcfce7;
        color: #166534;
    }

    .status.completed {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .status.pending {
        background: #fef3c7;
        color: #92400e;
    }

    .status.cancelled {
        background: #fee2e2;
        color: #991b1b;
    }

    .record-item {
        border-left: 4px solid #6366f1;
        background: #f8fafc;
        padding: 15px;
        border-radius: 0 10px 10px 0;
        margin-bottom: 12px;
    }

    .record-item:last-child {
        margin-bottom: 0;
    }

    .record-item h4 {
        margin: 0 0 7px;
        color: #111827;
    }

    .record-item p {
        margin: 5px 0;
        color: #6b7280;
        font-size: 14px;
    }

    .empty-state {
        text-align: center;
        padding: 30px 15px;
        color: #9ca3af;
    }

    .empty-state i {
        font-size: 35px;
        margin-bottom: 10px;
    }

    .action-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 10px 15px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: 0.2s;
    }

    .primary-btn {
        background: #6366f1;
        color: #ffffff;
    }

    .secondary-btn {
        background: #eef2ff;
        color: #4f46e5;
    }

    @media (max-width: 1000px) {
        .stats-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .content-grid {
            grid-template-columns: 1fr;
        }

        .card.full {
            grid-column: auto;
        }
    }

    @media (max-width: 650px) {
        .patient-page {
            padding: 15px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .profile-card {
            flex-direction: column;
            text-align: center;
        }

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .appointment-top {
            flex-direction: column;
        }
    }
</style>

<div class="patient-page">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div>
            <h1>Patient Details</h1>
            <p>View patient's profile, appointments and medical history</p>
        </div>

        <a href="/doctor/patients" class="back-btn">
            <i class="fas fa-arrow-left"></i>
            Back to Patients
        </a>
    </div>


    <!-- PATIENT PROFILE -->
    <div class="profile-card">

        <% 
            const patientName =
                ((patient?.firstName || "") + " " + (patient?.lastName || "")).trim()
                || "Patient";
        %>

        <% if (patient?.profileImage) { %>

            <img
                src="<%= patient.profileImage %>"
                alt="Patient"
                class="profile-image"
            >

        <% } else { %>

            <div class="profile-placeholder">
                <%= patientName.charAt(0).toUpperCase() %>
            </div>

        <% } %>

        <div class="profile-info">

            <h2><%= patientName %></h2>

            <p>
                <i class="fas fa-envelope"></i>
                <%= patient?.email || "Email not available" %>
            </p>

            <p>
                <i class="fas fa-phone"></i>
                <%= patient?.phone || "Phone not available" %>
            </p>

        </div>

    </div>


    <!-- STATISTICS -->
    <div class="stats-grid">

        <div class="stat-card">
            <div class="icon">
                <i class="fas fa-calendar-check"></i>
            </div>

            <h3><%= stats?.total ?? 0 %></h3>
            <p>Total Appointments</p>
        </div>


        <div class="stat-card">
            <div class="icon">
                <i class="fas fa-check-circle"></i>
            </div>

            <h3><%= stats?.completed ?? 0 %></h3>
            <p>Completed</p>
        </div>


        <div class="stat-card">
            <div class="icon">
                <i class="fas fa-clock"></i>
            </div>

            <h3><%= stats?.pending ?? 0 %></h3>
            <p>Pending</p>
        </div>


        <div class="stat-card">
            <div class="icon">
                <i class="fas fa-user-check"></i>
            </div>

            <h3><%= stats?.approved ?? 0 %></h3>
            <p>Approved</p>
        </div>

    </div>


    <!-- CONTENT -->
    <div class="content-grid">


        <!-- LAST APPOINTMENT -->
        <div class="card">

            <div class="card-header">

                <h3>
                    <i class="fas fa-calendar-day"></i>
                    Last Appointment
                </h3>

            </div>


            <% if (lastAppointment) { %>

                <div class="appointment-item">

                    <div class="appointment-top">

                        <div class="appointment-date">

                            <%= lastAppointment.appointmentDate
                                ? new Date(lastAppointment.appointmentDate).toLocaleDateString("en-IN", {
                                    day: "numeric",
                                    month: "short",
                                    year: "numeric"
                                })
                                : "Date not available"
                            %>

                        </div>


                        <span class="status <%= String(lastAppointment.status || "").toLowerCase() %>">
                            <%= lastAppointment.status || "Unknown" %>
                        </span>

                    </div>


                    <div class="appointment-meta">

                        <i class="fas fa-clock"></i>

                        <%= lastAppointment.appointmentTime || "Time not available" %>

                    </div>


                    <div class="appointment-meta">

                        <i class="fas fa-stethoscope"></i>

                        <%= lastAppointment.department || "Department not available" %>

                    </div>

                </div>


            <% } else { %>

                <div class="empty-state">

                    <i class="fas fa-calendar-times"></i>

                    <p>No appointment found.</p>

                </div>

            <% } %>

        </div>


        <!-- QUICK ACTIONS -->
        <div class="card">

            <div class="card-header">

                <h3>
                    <i class="fas fa-bolt"></i>
                    Quick Actions
                </h3>

            </div>


            <div class="action-buttons">

                <a
                    href="/doctor/patients/<%= patient._id %>/appointments"
                    class="action-btn primary-btn"
                >
                    <i class="fas fa-calendar"></i>
                    Appointments
                </a>


                <a
                    href="/doctor/patients/<%= patient._id %>/medical-history"
                    class="action-btn secondary-btn"
                >
                    <i class="fas fa-file-medical"></i>
                    Medical History
                </a>

            </div>

        </div>


        <!-- APPOINTMENT HISTORY -->
        <div class="card full">

            <div class="card-header">

                <h3>
                    <i class="fas fa-history"></i>
                    Recent Appointments
                </h3>


                <a
                    href="/doctor/patients/<%= patient._id %>/appointments"
                    class="view-all"
                >
                    View All
                </a>

            </div>


            <% if (appointments && appointments.length > 0) { %>

                <% appointments.slice(0, 5).forEach(function(appointment) { %>

                    <div class="appointment-item">

                        <div class="appointment-top">

                            <div class="appointment-date">

                                <%= appointment.appointmentDate
                                    ? new Date(appointment.appointmentDate).toLocaleDateString("en-IN", {
                                        day: "numeric",
                                        month: "short",
                                        year: "numeric"
                                    })
                                    : "Date not available"
                                %>

                            </div>


                            <span class="status <%= String(appointment.status || "").toLowerCase() %>">
                                <%= appointment.status || "Unknown" %>
                            </span>

                        </div>


                        <div class="appointment-meta">

                            <i class="fas fa-clock"></i>

                            <%= appointment.appointmentTime || "Time not available" %>

                        </div>


                        <div class="appointment-meta">

                            <i class="fas fa-building"></i>

                            <%= appointment.department || "Department not available" %>

                        </div>

                    </div>

                <% }); %>


            <% } else { %>

                <div class="empty-state">

                    <i class="fas fa-calendar-times"></i>

                    <p>No appointment history available.</p>

                </div>

            <% } %>

        </div>


        <!-- MEDICAL HISTORY -->
        <div class="card full">

            <div class="card-header">

                <h3>
                    <i class="fas fa-notes-medical"></i>
                    Medical History
                </h3>


                <a
                    href="/doctor/patients/<%= patient._id %>/medical-history"
                    class="view-all"
                >
                    View All
                </a>

            </div>


            <% if (medicalHistory && medicalHistory.length > 0) { %>

                <% medicalHistory.slice(0, 5).forEach(function(record) { %>

                    <div class="record-item">

                        <h4>
                            <i class="fas fa-diagnoses"></i>
                            <%= record.diagnosis || "Diagnosis not available" %>
                        </h4>


                        <p>

                            <strong>Visit Date:</strong>

                            <%= record.visitDate
                                ? new Date(record.visitDate).toLocaleDateString("en-IN", {
                                    day: "numeric",
                                    month: "short",
                                    year: "numeric"
                                })
                                : "Not available"
                            %>

                        </p>


                        <% if (record.symptoms) { %>

                            <p>
                                <strong>Symptoms:</strong>
                                <%= record.symptoms %>
                            </p>

                        <% } %>


                        <% if (record.treatment) { %>

                            <p>
                                <strong>Treatment:</strong>
                                <%= record.treatment %>
                            </p>

                        <% } %>

                    </div>

                <% }); %>


            <% } else { %>

                <div class="empty-state">

                    <i class="fas fa-file-medical"></i>

                    <p>No medical history available.</p>

                </div>

            <% } %>

        </div>

    </div>

</div>


<%- include("../../layouts/doctorFooter") %>