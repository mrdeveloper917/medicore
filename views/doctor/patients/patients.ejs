<%- include("../../layouts/doctorHeader") %>

<style>
    /* =========================================================
       DOCTOR PATIENTS PAGE
       ========================================================= */

    .patients-page {
        width: 100%;
        padding: 28px;
        box-sizing: border-box;
    }

    /* =========================================================
       PAGE HEADER
       ========================================================= */

    .patients-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .patients-page-title {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #172033;
    }

    .patients-page-subtitle {
        margin: 7px 0 0;
        color: #718096;
        font-size: 14px;
    }

    /* =========================================================
       STAT CARDS
       ========================================================= */

    .patient-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 25px;
    }

    .patient-stat-card {
        background: #ffffff;
        border: 1px solid #e8edf3;
        border-radius: 16px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 5px 18px rgba(30, 50, 80, 0.05);
    }

    .patient-stat-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef6ff;
        color: #1976d2;
        font-size: 21px;
    }

    .patient-stat-info {
        min-width: 0;
    }

    .patient-stat-number {
        display: block;
        font-size: 24px;
        font-weight: 700;
        color: #172033;
        line-height: 1.2;
    }

    .patient-stat-label {
        display: block;
        margin-top: 4px;
        color: #718096;
        font-size: 13px;
    }

    /* =========================================================
       MAIN CARD
       ========================================================= */

    .patients-card {
        background: #ffffff;
        border: 1px solid #e8edf3;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(30, 50, 80, 0.05);
    }

    /* =========================================================
       TOOLBAR
       ========================================================= */

    .patients-toolbar {
        padding: 20px;
        border-bottom: 1px solid #edf1f5;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .patients-toolbar-left h3 {
        margin: 0;
        font-size: 18px;
        color: #172033;
    }

    .patients-toolbar-left p {
        margin: 5px 0 0;
        font-size: 13px;
        color: #718096;
    }

    .patient-search-wrapper {
        position: relative;
        width: 310px;
        max-width: 100%;
    }

    .patient-search-wrapper i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #8a96a8;
        pointer-events: none;
    }

    #patientSearch {
        width: 100%;
        height: 44px;
        padding: 0 15px 0 42px;
        border: 1px solid #dce3eb;
        border-radius: 10px;
        outline: none;
        font-size: 14px;
        color: #263247;
        box-sizing: border-box;
        transition: 0.2s ease;
        background: #ffffff;
    }

    #patientSearch:focus {
        border-color: #1976d2;
        box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.08);
    }

    /* =========================================================
       TABLE
       ========================================================= */

    .patients-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .patients-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 850px;
    }

    .patients-table thead {
        background: #f8fafc;
    }

    .patients-table th {
        text-align: left;
        padding: 15px 18px;
        color: #64748b;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        white-space: nowrap;
        border-bottom: 1px solid #e9eef4;
    }

    .patients-table td {
        padding: 17px 18px;
        border-bottom: 1px solid #edf1f5;
        vertical-align: middle;
        color: #354052;
        font-size: 14px;
    }

    .patients-table tbody tr {
        transition: background 0.2s ease;
    }

    .patients-table tbody tr:hover {
        background: #fafcff;
    }

    .patients-table tbody tr:last-child td {
        border-bottom: none;
    }

    /* =========================================================
       PATIENT PROFILE
       ========================================================= */

    .patient-profile {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 210px;
    }

    .patient-avatar {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 50%;
        overflow: hidden;
        background: #edf4fb;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1976d2;
        font-size: 17px;
        font-weight: 700;
        border: 1px solid #e0e9f2;
    }

    .patient-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .patient-name {
        font-size: 14px;
        font-weight: 700;
        color: #172033;
        margin: 0 0 4px;
    }

    .patient-id {
        font-size: 11px;
        color: #8a96a8;
        margin: 0;
    }

    /* =========================================================
       CONTACT INFO
       ========================================================= */

    .patient-email {
        color: #526074;
        white-space: nowrap;
    }

    .patient-phone {
        color: #526074;
        white-space: nowrap;
    }

    .no-data {
        color: #a0a9b8;
    }

    /* =========================================================
       APPOINTMENT COUNT
       ========================================================= */

    .appointment-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 36px;
        height: 32px;
        padding: 0 10px;
        border-radius: 8px;
        background: #eef6ff;
        color: #1976d2;
        font-size: 13px;
        font-weight: 700;
    }

    /* =========================================================
       LAST APPOINTMENT
       ========================================================= */

    .last-appointment {
        white-space: nowrap;
    }

    .last-appointment-date {
        display: block;
        color: #354052;
        font-weight: 600;
        font-size: 13px;
    }

    .last-appointment-time {
        display: block;
        margin-top: 3px;
        color: #8a96a8;
        font-size: 12px;
    }

    /* =========================================================
       STATUS
       ========================================================= */

    .patient-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .patient-status.active {
        background: #eaf8f0;
        color: #18864b;
    }

    .patient-status.inactive {
        background: #f2f4f7;
        color: #687386;
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }

    /* =========================================================
       VIEW BUTTON
       ========================================================= */

    .view-patient-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        height: 36px;
        padding: 0 13px;
        border-radius: 8px;
        border: 1px solid #d7e5f3;
        background: #f5faff;
        color: #1976d2;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: all 0.2s ease;
        white-space: nowrap;
    }

    .view-patient-btn:hover {
        background: #1976d2;
        color: #ffffff;
        border-color: #1976d2;
        transform: translateY(-1px);
    }

    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .patients-empty {
        padding: 65px 25px;
        text-align: center;
    }

    .patients-empty-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #f1f6fb;
        color: #7b8da3;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .patients-empty h3 {
        margin: 0;
        color: #263247;
        font-size: 18px;
    }

    .patients-empty p {
        margin: 8px auto 0;
        max-width: 450px;
        color: #8792a3;
        font-size: 13px;
        line-height: 1.6;
    }

    /* =========================================================
       SEARCH EMPTY
       ========================================================= */

    #searchEmpty {
        display: none;
        padding: 50px 20px;
        text-align: center;
    }

    #searchEmpty i {
        font-size: 28px;
        color: #9aa6b6;
        margin-bottom: 12px;
    }

    #searchEmpty h4 {
        margin: 0;
        color: #334155;
        font-size: 16px;
    }

    #searchEmpty p {
        margin: 6px 0 0;
        color: #8a96a8;
        font-size: 13px;
    }

    /* =========================================================
       MOBILE PATIENT CARDS
       ========================================================= */

    .mobile-patients {
        display: none;
        padding: 15px;
    }

    .mobile-patient-card {
        border: 1px solid #e5eaf0;
        border-radius: 14px;
        padding: 16px;
        margin-bottom: 13px;
        background: #ffffff;
    }

    .mobile-patient-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
    }

    .mobile-patient-info {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .mobile-patient-name {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
        color: #172033;
    }

    .mobile-patient-email {
        margin: 4px 0 0;
        color: #8792a3;
        font-size: 11px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 180px;
    }

    .mobile-patient-details {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        margin-top: 16px;
        padding-top: 14px;
        border-top: 1px solid #edf1f5;
    }

    .mobile-detail-item span {
        display: block;
        font-size: 10px;
        color: #8a96a8;
        margin-bottom: 4px;
        text-transform: uppercase;
        font-weight: 700;
    }

    .mobile-detail-item strong {
        display: block;
        font-size: 12px;
        color: #354052;
    }

    .mobile-patient-action {
        margin-top: 15px;
    }

    .mobile-patient-action .view-patient-btn {
        width: 100%;
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @media (max-width: 1100px) {

        .patient-stats {
            grid-template-columns: repeat(2, 1fr);
        }

    }


    @media (max-width: 800px) {

        .patients-page {
            padding: 20px 15px;
        }

        .patients-page-header {
            align-items: flex-start;
        }

        .patients-page-title {
            font-size: 24px;
        }

        .patients-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .patient-search-wrapper {
            width: 100%;
        }

        .patients-table-wrapper {
            display: none;
        }

        .mobile-patients {
            display: block;
        }

    }


    @media (max-width: 600px) {

        .patient-stats {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .patient-stat-card {
            padding: 16px;
        }

        .patients-page-header {
            margin-bottom: 18px;
        }

        .patients-page-title {
            font-size: 22px;
        }

        .patients-page-subtitle {
            font-size: 12px;
        }

        .patients-toolbar {
            padding: 16px;
        }

        .patients-toolbar-left h3 {
            font-size: 16px;
        }

        .mobile-patient-details {
            grid-template-columns: 1fr 1fr;
        }

    }


    @media (max-width: 400px) {

        .patients-page {
            padding: 15px 10px;
        }

        .mobile-patient-details {
            grid-template-columns: 1fr;
        }

        .patient-stat-number {
            font-size: 21px;
        }

    }
</style>


<!-- =========================================================
     PAGE WRAPPER
     ========================================================= -->

<div class="patients-page">


    <!-- =======================================================
         PAGE HEADER
         ======================================================= -->

    <div class="patients-page-header">

        <div>

            <h1 class="patients-page-title">
                My Patients
            </h1>

            <p class="patients-page-subtitle">
                View and manage patients who have appointments with you.
            </p>

        </div>

    </div>


    <!-- =======================================================
         STATISTICS
         ======================================================= -->

    <div class="patient-stats">


        <!-- Total Patients -->

        <div class="patient-stat-card">

            <div class="patient-stat-icon">
                <i class="fa-solid fa-users"></i>
            </div>

            <div class="patient-stat-info">

                <span class="patient-stat-number" id="totalPatients">
                    <%= Array.isArray(patients) ? patients.length : 0 %>
                </span>

                <span class="patient-stat-label">
                    Total Patients
                </span>

            </div>

        </div>


        <!-- Total Appointments -->

        <div class="patient-stat-card">

            <div class="patient-stat-icon">
                <i class="fa-solid fa-calendar-check"></i>
            </div>

            <div class="patient-stat-info">

                <span class="patient-stat-number">
                    <%
                        let totalPatientAppointments = 0;

                        if (Array.isArray(patients)) {
                            patients.forEach(function(item) {
                                totalPatientAppointments +=
                                    Number(item.totalAppointments || 0);
                            });
                        }
                    %>

                    <%= totalPatientAppointments %>
                </span>

                <span class="patient-stat-label">
                    Total Appointments
                </span>

            </div>

        </div>


        <!-- Active Patients -->

        <div class="patient-stat-card">

            <div class="patient-stat-icon">
                <i class="fa-solid fa-user-check"></i>
            </div>

            <div class="patient-stat-info">

                <span class="patient-stat-number">
                    <%
                        let activePatientCount = 0;

                        if (Array.isArray(patients)) {
                            patients.forEach(function(item) {
                                if (
                                    String(item.status || "")
                                        .toLowerCase() === "active"
                                ) {
                                    activePatientCount++;
                                }
                            });
                        }
                    %>

                    <%= activePatientCount %>
                </span>

                <span class="patient-stat-label">
                    Active Patients
                </span>

            </div>

        </div>

    </div>


    <!-- =======================================================
         PATIENT MAIN CARD
         ======================================================= -->

    <div class="patients-card">


        <!-- ===================================================
             TOOLBAR
             =================================================== -->

        <div class="patients-toolbar">

            <div class="patients-toolbar-left">

                <h3>
                    Patient Directory
                </h3>

                <p>
                    Search and view your patients
                </p>

            </div>


            <!-- Search -->

            <div class="patient-search-wrapper">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input
                    type="text"
                    id="patientSearch"
                    placeholder="Search patient..."
                    autocomplete="off"
                >

            </div>

        </div>


        <% if (Array.isArray(patients) && patients.length > 0) { %>


            <!-- =================================================
                 DESKTOP TABLE
                 ================================================= -->

            <div class="patients-table-wrapper">

                <table class="patients-table">

                    <thead>

                        <tr>

                            <th>
                                Patient
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Phone
                            </th>

                            <th>
                                Appointments
                            </th>

                            <th>
                                Last Appointment
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody id="patientsTableBody">

                        <% patients.forEach(function(item) { %>

                            <%
                                const patient = item.patient || {};

                                const firstName =
                                    patient.firstName || "";

                                const lastName =
                                    patient.lastName || "";

                                const fullName =
                                    `${firstName} ${lastName}`
                                        .trim() || "Unknown Patient";

                                const email =
                                    patient.email || "";

                                const phone =
                                    patient.phone || "";

                                const profileImage =
                                    patient.profileImage || "";

                                const totalAppointments =
                                    item.totalAppointments || 0;

                                const status =
                                    item.status || "Active";

                                const patientInitial =
                                    fullName.charAt(0).toUpperCase();

                                let lastDate = "";
                                let lastTime = "";

                                if (item.lastAppointment) {

                                    if (
                                        item.lastAppointment.appointmentDate
                                    ) {

                                        const date =
                                            new Date(
                                                item.lastAppointment
                                                    .appointmentDate
                                            );

                                        if (!isNaN(date.getTime())) {

                                            lastDate =
                                                date.toLocaleDateString(
                                                    "en-IN",
                                                    {
                                                        day: "2-digit",
                                                        month: "short",
                                                        year: "numeric"
                                                    }
                                                );

                                        }

                                    }

                                    lastTime =
                                        item.lastAppointment
                                            .appointmentTime || "";

                                }
                            %>


                            <tr
                                class="patient-row"
                                data-name="<%= fullName.toLowerCase() %>"
                                data-email="<%= email.toLowerCase() %>"
                                data-phone="<%= phone.toLowerCase() %>"
                            >


                                <!-- Patient -->

                                <td>

                                    <div class="patient-profile">

                                        <div class="patient-avatar">

                                            <% if (profileImage) { %>

                                                <img
                                                    src="<%= profileImage %>"
                                                    alt="<%= fullName %>"
                                                    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                                >

                                                <span style="display:none;">
                                                    <%= patientInitial %>
                                                </span>

                                            <% } else { %>

                                                <span>
                                                    <%= patientInitial %>
                                                </span>

                                            <% } %>

                                        </div>


                                        <div>

                                            <p class="patient-name">
                                                <%= fullName %>
                                            </p>

                                            <p class="patient-id">
                                                Patient ID:
                                                <%= String(patient._id || "")
                                                    .slice(-8)
                                                    .toUpperCase() || "N/A" %>
                                            </p>

                                        </div>

                                    </div>

                                </td>


                                <!-- Email -->

                                <td>

                                    <% if (email) { %>

                                        <span class="patient-email">
                                            <%= email %>
                                        </span>

                                    <% } else { %>

                                        <span class="no-data">
                                            Not available
                                        </span>

                                    <% } %>

                                </td>


                                <!-- Phone -->

                                <td>

                                    <% if (phone) { %>

                                        <span class="patient-phone">
                                            <%= phone %>
                                        </span>

                                    <% } else { %>

                                        <span class="no-data">
                                            Not available
                                        </span>

                                    <% } %>

                                </td>


                                <!-- Appointments -->

                                <td>

                                    <span class="appointment-count">
                                        <%= totalAppointments %>
                                    </span>

                                </td>


                                <!-- Last Appointment -->

                                <td>

                                    <% if (lastDate) { %>

                                        <div class="last-appointment">

                                            <span class="last-appointment-date">
                                                <%= lastDate %>
                                            </span>

                                            <% if (lastTime) { %>

                                                <span class="last-appointment-time">
                                                    <%= lastTime %>
                                                </span>

                                            <% } %>

                                        </div>

                                    <% } else { %>

                                        <span class="no-data">
                                            No appointment
                                        </span>

                                    <% } %>

                                </td>


                                <!-- Status -->

                                <td>

                                    <span
                                        class="patient-status <%= String(status).toLowerCase() === 'active' ? 'active' : 'inactive' %>"
                                    >

                                        <span class="status-dot"></span>

                                        <%= status %>

                                    </span>

                                </td>


                                <!-- Action -->

                                <td>

                                    <a
                                        href="/doctor/patients/<%= patient._id %>"
                                        class="view-patient-btn"
                                    >

                                        <i class="fa-solid fa-eye"></i>

                                        View

                                    </a>

                                </td>

                            </tr>

                        <% }); %>

                    </tbody>

                </table>


                <!-- Search Empty -->

                <div id="searchEmpty">

                    <i class="fa-solid fa-user-slash"></i>

                    <h4>
                        No patients found
                    </h4>

                    <p>
                        Try searching with another name, email or phone number.
                    </p>

                </div>

            </div>


            <!-- =================================================
                 MOBILE PATIENT LIST
                 ================================================= -->

            <div
                class="mobile-patients"
                id="mobilePatients"
            >

                <% patients.forEach(function(item) { %>

                    <%
                        const patient = item.patient || {};

                        const firstName =
                            patient.firstName || "";

                        const lastName =
                            patient.lastName || "";

                        const fullName =
                            `${firstName} ${lastName}`
                                .trim() || "Unknown Patient";

                        const email =
                            patient.email || "";

                        const phone =
                            patient.phone || "";

                        const profileImage =
                            patient.profileImage || "";

                        const totalAppointments =
                            item.totalAppointments || 0;

                        const status =
                            item.status || "Active";

                        const patientInitial =
                            fullName.charAt(0).toUpperCase();

                        let lastDate = "";
                        let lastTime = "";

                        if (item.lastAppointment) {

                            if (
                                item.lastAppointment.appointmentDate
                            ) {

                                const date =
                                    new Date(
                                        item.lastAppointment
                                            .appointmentDate
                                    );

                                if (!isNaN(date.getTime())) {

                                    lastDate =
                                        date.toLocaleDateString(
                                            "en-IN",
                                            {
                                                day: "2-digit",
                                                month: "short",
                                                year: "numeric"
                                            }
                                        );

                                }

                            }

                            lastTime =
                                item.lastAppointment
                                    .appointmentTime || "";

                        }
                    %>


                    <div
                        class="mobile-patient-card patient-row-mobile"
                        data-name="<%= fullName.toLowerCase() %>"
                        data-email="<%= email.toLowerCase() %>"
                        data-phone="<%= phone.toLowerCase() %>"
                    >


                        <!-- Top -->

                        <div class="mobile-patient-top">

                            <div class="mobile-patient-info">

                                <div class="patient-avatar">

                                    <% if (profileImage) { %>

                                        <img
                                            src="<%= profileImage %>"
                                            alt="<%= fullName %>"
                                            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                                        >

                                        <span style="display:none;">
                                            <%= patientInitial %>
                                        </span>

                                    <% } else { %>

                                        <span>
                                            <%= patientInitial %>
                                        </span>

                                    <% } %>

                                </div>


                                <div>

                                    <h4 class="mobile-patient-name">
                                        <%= fullName %>
                                    </h4>

                                    <p class="mobile-patient-email">
                                        <%= email || "Email not available" %>
                                    </p>

                                </div>

                            </div>


                            <span
                                class="patient-status <%= String(status).toLowerCase() === 'active' ? 'active' : 'inactive' %>"
                            >

                                <span class="status-dot"></span>

                                <%= status %>

                            </span>

                        </div>


                        <!-- Details -->

                        <div class="mobile-patient-details">


                            <div class="mobile-detail-item">

                                <span>
                                    Phone
                                </span>

                                <strong>
                                    <%= phone || "Not available" %>
                                </strong>

                            </div>


                            <div class="mobile-detail-item">

                                <span>
                                    Visits
                                </span>

                                <strong>
                                    <%= totalAppointments %>
                                </strong>

                            </div>


                            <div class="mobile-detail-item">

                                <span>
                                    Last Visit
                                </span>

                                <strong>
                                    <%= lastDate || "No visit" %>
                                </strong>

                            </div>


                            <div class="mobile-detail-item">

                                <span>
                                    Time
                                </span>

                                <strong>
                                    <%= lastTime || "—" %>
                                </strong>

                            </div>


                        </div>


                        <!-- Action -->

                        <div class="mobile-patient-action">

                            <a
                                href="/doctor/patients/<%= patient._id %>"
                                class="view-patient-btn"
                            >

                                <i class="fa-solid fa-eye"></i>

                                View Patient

                            </a>

                        </div>

                    </div>

                <% }); %>

            </div>


        <% } else { %>


            <!-- =================================================
                 NO PATIENTS
                 ================================================= -->

            <div class="patients-empty">

                <div class="patients-empty-icon">

                    <i class="fa-solid fa-user-group"></i>

                </div>

                <h3>
                    No Patients Yet
                </h3>

                <p>
                    Patients will appear here once they have
                    appointments with you.
                </p>

            </div>


        <% } %>


    </div>


</div>


<!-- =========================================================
     SEARCH SCRIPT
     ========================================================= -->

<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {

        const searchInput =
            document.getElementById(
                "patientSearch"
            );


        const desktopRows =
            document.querySelectorAll(
                ".patient-row"
            );


        const mobileRows =
            document.querySelectorAll(
                ".patient-row-mobile"
            );


        const searchEmpty =
            document.getElementById(
                "searchEmpty"
            );


        if (!searchInput) {
            return;
        }


        searchInput.addEventListener(
            "input",
            function () {

                const searchValue =
                    this.value
                        .trim()
                        .toLowerCase();


                let desktopVisible = 0;

                let mobileVisible = 0;


                // ---------------------------------------------
                // Desktop
                // ---------------------------------------------

                desktopRows.forEach(
                    function (row) {

                        const name =
                            row.dataset.name || "";

                        const email =
                            row.dataset.email || "";

                        const phone =
                            row.dataset.phone || "";


                        const matched =
                            name.includes(searchValue) ||
                            email.includes(searchValue) ||
                            phone.includes(searchValue);


                        if (matched) {

                            row.style.display = "";

                            desktopVisible++;

                        } else {

                            row.style.display = "none";

                        }

                    }
                );


                // ---------------------------------------------
                // Mobile
                // ---------------------------------------------

                mobileRows.forEach(
                    function (card) {

                        const name =
                            card.dataset.name || "";

                        const email =
                            card.dataset.email || "";

                        const phone =
                            card.dataset.phone || "";


                        const matched =
                            name.includes(searchValue) ||
                            email.includes(searchValue) ||
                            phone.includes(searchValue);


                        if (matched) {

                            card.style.display = "";

                            mobileVisible++;

                        } else {

                            card.style.display = "none";

                        }

                    }
                );


                // ---------------------------------------------
                // Search Empty State
                // ---------------------------------------------

                if (
                    searchValue !== "" &&
                    desktopVisible === 0 &&
                    mobileVisible === 0
                ) {

                    if (searchEmpty) {

                        searchEmpty.style.display =
                            "block";

                    }

                } else {

                    if (searchEmpty) {

                        searchEmpty.style.display =
                            "none";

                    }

                }

            }
        );

    }
);

</script>


