<%- include("../../layouts/doctorHeader") %>

<style>
    .details-page {
        padding: 25px;
        background: #f5f7fb;
        min-height: calc(100vh - 100px);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
    }

    .page-header h1 {
        margin: 0;
        color: #1f2937;
    }

    .back-btn {
        padding: 11px 17px;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        color: #374151;
        text-decoration: none;
    }

    .report-sheet {
        max-width: 850px;
        margin: auto;
        background: #fff;
        padding: 35px;
        border-radius: 18px;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
    }

    .report-heading {
        text-align: center;
        border-bottom: 1px solid #e5e7eb;
        padding-bottom: 25px;
    }

    .report-heading i {
        font-size: 42px;
        color: #6366f1;
    }

    .report-heading h2 {
        margin: 10px 0 5px;
        color: #111827;
    }

    .report-heading p {
        margin: 0;
        color: #6b7280;
    }

    .patient-box {
        margin: 25px 0;
        padding: 18px;
        background: #f9fafb;
        border-radius: 12px;
    }

    .patient-box h3 {
        margin: 0 0 8px;
        color: #111827;
    }

    .patient-box p {
        margin: 4px 0;
        color: #6b7280;
    }

    .detail-row {
        padding: 18px 0;
        border-bottom: 1px solid #e5e7eb;
    }

    .label {
        color: #9ca3af;
        font-size: 12px;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .value {
        color: #1f2937;
        font-size: 16px;
        font-weight: 600;
    }

    .file-section {
        margin-top: 25px;
        padding: 20px;
        background: #eef2ff;
        border-radius: 12px;
    }

    .file-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 10px;
        padding: 11px 17px;
        background: #6366f1;
        color: white;
        border-radius: 9px;
        text-decoration: none;
        font-weight: 600;
    }

    .no-file {
        color: #6b7280;
    }

    .actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 25px;
    }

    .delete-btn {
        border: none;
        background: #fee2e2;
        color: #991b1b;
        padding: 11px 17px;
        border-radius: 9px;
        cursor: pointer;
        font-weight: 600;
    }

    @media (max-width: 600px) {

        .details-page {
            padding: 15px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .report-sheet {
            padding: 20px;
        }
    }
</style>


<div class="details-page">

    <div class="page-header">

        <h1>Report Details</h1>

        <a
            href="/doctor/reports"
            class="back-btn"
        >
            <i class="fas fa-arrow-left"></i>
            Back to Reports
        </a>

    </div>


    <%
        const patientName =
            report.patient
            ? (
                (report.patient.firstName || "") +
                " " +
                (report.patient.lastName || "")
              ).trim() || "Patient"
            : "Patient";
    %>


    <div class="report-sheet">

        <div class="report-heading">

            <i class="fas fa-file-medical"></i>

            <h2>
                <%= report.title || "Medical Report" %>
            </h2>

            <p>MediCore Medical Report</p>

        </div>


        <!-- PATIENT -->
        <div class="patient-box">

            <h3>
                <i class="fas fa-user"></i>
                <%= patientName %>
            </h3>

            <p>
                <i class="fas fa-envelope"></i>
                <%= report.patient?.email || "Email not available" %>
            </p>

            <p>
                <i class="fas fa-phone"></i>
                <%= report.patient?.phone || "Phone not available" %>
            </p>

        </div>


        <!-- REPORT TITLE -->
        <div class="detail-row">

            <div class="label">
                Report Title
            </div>

            <div class="value">
                <%= report.title || "Not available" %>
            </div>

        </div>


        <!-- REPORT DATE -->
        <div class="detail-row">

            <div class="label">
                Report Date
            </div>

            <div class="value">

                <%= report.reportDate
                    ? new Date(
                        report.reportDate
                      ).toLocaleDateString("en-IN", {
                          day: "numeric",
                          month: "long",
                          year: "numeric"
                      })
                    : "Date unavailable"
                %>

            </div>

        </div>


        <!-- FILE -->
        <div class="file-section">

            <div class="label">
                Report File
            </div>


            <% if (report.file) { %>

                <a
                    href="<%= report.file %>"
                    target="_blank"
                    class="file-btn"
                >
                    <i class="fas fa-file-arrow-up"></i>
                    Open Report File
                </a>

            <% } else { %>

                <div class="no-file">
                    <i class="fas fa-file-circle-xmark"></i>
                    No file attached to this report.
                </div>

            <% } %>

        </div>


        <!-- DELETE -->
        <div class="actions">

            <form
                action="/doctor/reports/<%= report._id %>/delete"
                method="POST"
                onsubmit="return confirm('Are you sure you want to delete this report?');"
            >

                <button
                    type="submit"
                    class="delete-btn"
                >
                    <i class="fas fa-trash"></i>
                    Delete Report
                </button>

            </form>

        </div>

    </div>

</div>


<%- include("../../layouts/doctorHeader") %>