<%- include("../../layouts/doctorHeader") %>

<style>
    .reports-page {
        padding: 25px;
        background: #f5f7fb;
        min-height: calc(100vh - 100px);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .page-header h1 {
        margin: 0;
        font-size: 28px;
        color: #1f2937;
    }

    .page-header p {
        margin: 6px 0 0;
        color: #6b7280;
    }

    .create-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 18px;
        border-radius: 10px;
        background: #6366f1;
        color: #fff;
        text-decoration: none;
        font-weight: 600;
    }

    .create-btn:hover {
        background: #4f46e5;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: #fff;
        padding: 20px;
        border-radius: 15px;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
    }

    .stat-icon {
        width: 45px;
        height: 45px;
        border-radius: 11px;
        background: #eef2ff;
        color: #6366f1;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
    }

    .stat-card h2 {
        margin: 0;
        color: #111827;
    }

    .stat-card p {
        margin: 5px 0 0;
        color: #6b7280;
    }

    .reports-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .report-card {
        background: #fff;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
    }

    .report-icon {
        width: 55px;
        height: 55px;
        border-radius: 13px;
        background: #eef2ff;
        color: #6366f1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
        margin-bottom: 16px;
    }

    .report-card h3 {
        margin: 0 0 8px;
        color: #111827;
        font-size: 18px;
    }

    .patient {
        color: #6b7280;
        font-size: 14px;
        margin-bottom: 12px;
    }

    .patient i {
        color: #6366f1;
    }

    .report-date {
        color: #9ca3af;
        font-size: 13px;
        margin-bottom: 18px;
    }

    .card-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid #e5e7eb;
        padding-top: 15px;
    }

    .view-btn {
        color: #6366f1;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
    }

    .view-btn:hover {
        color: #4f46e5;
    }

    .file-badge {
        font-size: 12px;
        padding: 5px 9px;
        border-radius: 7px;
        background: #dcfce7;
        color: #166534;
    }

    .no-file {
        background: #f3f4f6;
        color: #6b7280;
    }

    .empty-state {
        grid-column: 1 / -1;
        background: #fff;
        padding: 70px 20px;
        text-align: center;
        border-radius: 16px;
        color: #9ca3af;
    }

    .empty-state i {
        font-size: 50px;
        margin-bottom: 15px;
    }

    .empty-state h3 {
        color: #374151;
        margin: 5px 0;
    }

    @media (max-width: 1000px) {
        .reports-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (max-width: 700px) {
        .reports-page {
            padding: 15px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .stats {
            grid-template-columns: 1fr;
        }

        .reports-grid {
            grid-template-columns: 1fr;
        }

        .create-btn {
            width: 100%;
            justify-content: center;
        }
    }
</style>


<div class="reports-page">

    <!-- HEADER -->
    <div class="page-header">

        <div>
            <h1>Medical Reports</h1>
            <p>Manage patient medical reports</p>
        </div>

        <a
            href="/doctor/reports/create"
            class="create-btn"
        >
            <i class="fas fa-plus"></i>
            Add Report
        </a>

    </div>


    <!-- STATS -->
    <%
        const totalReports =
            reports ? reports.length : 0;

        const patientsCount = reports
            ? new Set(
                reports
                    .filter(r => r.patient)
                    .map(r => r.patient._id.toString())
              ).size
            : 0;

        const filesCount = reports
            ? reports.filter(r => r.file).length
            : 0;
    %>


    <div class="stats">

        <div class="stat-card">

            <div class="stat-icon">
                <i class="fas fa-file-medical"></i>
            </div>

            <h2>
                <%= totalReports %>
            </h2>

            <p>Total Reports</p>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                <i class="fas fa-users"></i>
            </div>

            <h2>
                <%= patientsCount %>
            </h2>

            <p>Patients</p>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                <i class="fas fa-file-circle-check"></i>
            </div>

            <h2>
                <%= filesCount %>
            </h2>

            <p>Uploaded Files</p>

        </div>

    </div>


    <!-- REPORTS -->
    <div class="reports-grid">

        <% if (reports && reports.length > 0) { %>

            <% reports.forEach(function(report) { %>

                <%
                    const patientName =
                        report.patient
                        ? (
                            (report.patient.firstName || "") +
                            " " +
                            (report.patient.lastName || "")
                          ).trim() || "Patient"
                        : "Patient";
                %>


                <div class="report-card">

                    <div class="report-icon">
                        <i class="fas fa-file-medical"></i>
                    </div>


                    <h3>
                        <%= report.title || "Untitled Report" %>
                    </h3>


                    <div class="patient">

                        <i class="fas fa-user"></i>

                        <%= patientName %>

                    </div>


                    <div class="report-date">

                        <i class="fas fa-calendar"></i>

                        <%= report.reportDate
                            ? new Date(
                                report.reportDate
                              ).toLocaleDateString("en-IN", {
                                  day: "numeric",
                                  month: "short",
                                  year: "numeric"
                              })
                            : "Date unavailable"
                        %>

                    </div>


                    <% if (report.file) { %>

                        <span class="file-badge">
                            <i class="fas fa-paperclip"></i>
                            File Attached
                        </span>

                    <% } else { %>

                        <span class="file-badge no-file">
                            No File
                        </span>

                    <% } %>


                    <div class="card-actions">

                        <a
                            href="/doctor/reports/<%= report._id %>"
                            class="view-btn"
                        >
                            View Details
                            <i class="fas fa-arrow-right"></i>
                        </a>

                    </div>

                </div>

            <% }); %>


        <% } else { %>

            <div class="empty-state">

                <i class="fas fa-file-circle-exclamation"></i>

                <h3>No Reports Found</h3>

                <p>
                    You have not added any patient reports yet.
                </p>

            </div>

        <% } %>

    </div>

</div>


<%- include("../../layouts/doctorFooter") %>