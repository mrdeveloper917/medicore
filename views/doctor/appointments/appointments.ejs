<%- include("../../layouts/doctorHeader", { title: "Appointments", user }) %>

<style>
/* =========================================================
   MEDICORE — DOCTOR APPOINTMENTS
   Modern Premium UI
========================================================= */

:root {
    --mc-primary: #2563eb;
    --mc-primary-dark: #1d4ed8;
    --mc-text: #172033;
    --mc-muted: #7d8799;
    --mc-border: #e8edf3;
    --mc-bg: #f7f9fc;
    --mc-shadow: 0 10px 30px rgba(18, 35, 58, .06);
}

/* ================= PAGE ================= */

.appointments-page {
    max-width: 1450px;
    margin: 0 auto;
    padding: 30px;
}

/* ================= HEADER ================= */

.appointments-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
}

.appointments-heading {
    display: flex;
    align-items: center;
    gap: 15px;
}

.appointments-heading-icon {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border-radius: 16px;
    color: #2563eb;
    background: linear-gradient(145deg, #eff6ff, #dbeafe);
    box-shadow: inset 0 0 0 1px #dbeafe;
    font-size: 21px;
}

.appointments-heading h2 {
    margin: 0 0 5px;
    color: var(--mc-text);
    font-size: 27px;
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -.5px;
}

.appointments-heading p {
    margin: 0;
    color: var(--mc-muted);
    font-size: 13px;
}

/* ================= STATS ================= */

.appointment-stats {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 14px;
    margin-bottom: 24px;
}

.appointment-stat {
    position: relative;
    overflow: hidden;
    min-height: 88px;
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 17px;
    background: #fff;
    border: 1px solid var(--mc-border);
    border-radius: 16px;
    box-shadow: var(--mc-shadow);
    transition:
        transform .22s ease,
        box-shadow .22s ease,
        border-color .22s ease;
}

.appointment-stat::after {
    content: "";
    position: absolute;
    width: 70px;
    height: 70px;
    right: -28px;
    bottom: -35px;
    border-radius: 50%;
    background: currentColor;
    opacity: .035;
}

.appointment-stat:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 34px rgba(18, 35, 58, .09);
    border-color: #dce4ee;
}

.stat-icon {
    width: 45px;
    height: 45px;
    flex: 0 0 45px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    font-size: 17px;
}

.stat-icon.total {
    background: #eff6ff;
    color: #2563eb;
}

.stat-icon.pending {
    background: #fff7e6;
    color: #d99000;
}

.stat-icon.approved {
    background: #ecfdf3;
    color: #159447;
}

.stat-icon.completed {
    background: #ecfeff;
    color: #087f83;
}

.stat-icon.cancelled {
    background: #fff1f2;
    color: #dc3545;
}

.stat-info span {
    display: block;
    margin-bottom: 4px;
    color: #8b95a6;
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .35px;
}

.stat-info strong {
    color: #202a3b;
    font-size: 21px;
    line-height: 1;
}

/* ================= MAIN CARD ================= */

.appointments-card {
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--mc-border);
    border-radius: 20px;
    box-shadow: var(--mc-shadow);
}

/* ================= TOOLBAR ================= */

.appointments-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 20px 22px;
    background: linear-gradient(180deg, #fff, #fcfdff);
    border-bottom: 1px solid #edf1f5;
}

.toolbar-title h3 {
    margin: 0 0 4px;
    color: #1e293b;
    font-size: 17px;
    font-weight: 800;
}

.toolbar-title p {
    margin: 0;
    color: #8a94a5;
    font-size: 12px;
}

.toolbar-controls {
    display: flex;
    align-items: center;
    gap: 10px;
}

.search-box {
    position: relative;
}

.search-box i {
    position: absolute;
    left: 13px;
    top: 50%;
    transform: translateY(-50%);
    color: #9aa5b5;
    pointer-events: none;
    font-size: 12px;
}

.search-input,
.status-filter {
    height: 42px;
    border: 1px solid #dfe5ed;
    border-radius: 11px;
    background: #fff;
    outline: none;
    color: #273244;
    font-family: inherit;
    font-size: 12px;
    transition:
        border-color .2s ease,
        box-shadow .2s ease;
}

.search-input {
    width: 245px;
    padding: 0 13px 0 37px;
}

.status-filter {
    min-width: 135px;
    padding: 0 12px;
    cursor: pointer;
}

.search-input:focus,
.status-filter:focus {
    border-color: #60a5fa;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, .09);
}

/* ================= TABLE ================= */

.table-wrapper {
    width: 100%;
    overflow-x: auto;
}

.appointments-table {
    width: 100%;
    min-width: 920px;
    border-collapse: separate;
    border-spacing: 0;
}

.appointments-table th {
    padding: 13px 20px;
    text-align: left;
    background: #f9fafc;
    border-bottom: 1px solid #e9eef4;
    color: #7d8798;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: .55px;
    white-space: nowrap;
}

.appointments-table td {
    padding: 16px 20px;
    border-bottom: 1px solid #eef1f5;
    color: #3d4859;
    font-size: 12px;
    vertical-align: middle;
}

.appointments-table tbody tr {
    transition: background .18s ease;
}

.appointments-table tbody tr:hover {
    background: #fbfdff;
}

.appointments-table tbody tr:last-child td {
    border-bottom: 0;
}

/* ================= PATIENT ================= */

.patient-cell {
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 205px;
}

.patient-avatar {
    width: 43px;
    height: 43px;
    flex: 0 0 43px;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid #e8f0fb;
    background: #f3f6fa;
}

.patient-name {
    margin: 0 0 3px;
    color: #202a3b;
    font-size: 12px;
    font-weight: 800;
}

.patient-email {
    max-width: 180px;
    margin: 0;
    overflow: hidden;
    color: #929cab;
    font-size: 10px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* ================= DATE / TIME ================= */

.date-cell strong {
    display: block;
    margin-bottom: 3px;
    color: #303b4c;
    font-size: 12px;
}

.date-cell span {
    color: #929baa;
    font-size: 10px;
}

.time-cell,
.department {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #4b5668;
    white-space: nowrap;
}

.time-cell i,
.department i {
    color: #3b82f6;
}

/* ================= STATUS ================= */

.status-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 10px;
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .2px;
    white-space: nowrap;
}

.status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    box-shadow: 0 0 0 3px currentColor;
    opacity: .28;
}

.status-pending {
    background: #fff8e8;
    border-color: #ffedbd;
    color: #b97900;
}

.status-pending .status-dot {
    background: #e3a21a;
}

.status-approved {
    background: #edfbf2;
    border-color: #d5f2df;
    color: #16864b;
}

.status-approved .status-dot {
    background: #20a45b;
}

.status-completed {
    background: #ecfbfb;
    border-color: #d3f0f0;
    color: #117d80;
}

.status-completed .status-dot {
    background: #15999d;
}

.status-cancelled {
    background: #fff2f2;
    border-color: #ffdede;
    color: #d73535;
}

.status-cancelled .status-dot {
    background: #e33b3b;
}

/* ================= ACTIONS ================= */

.table-actions,
.mobile-actions {
    display: flex;
    align-items: center;
    gap: 7px;
    flex-wrap: wrap;
}

.action-form {
    margin: 0;
}

.action-btn {
    height: 33px;
    padding: 0 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 1px solid transparent;
    border-radius: 9px;
    font-family: inherit;
    font-size: 10px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition:
        transform .18s ease,
        background .18s ease,
        color .18s ease,
        border-color .18s ease;
}

.action-btn:hover {
    transform: translateY(-1px);
}

.view-btn {
    color: #2563eb;
    background: #eff6ff;
    border-color: #dbeafe;
}

.view-btn:hover {
    color: #fff;
    background: #2563eb;
    border-color: #2563eb;
}

.approve-btn {
    color: #16864b;
    background: #ecfdf3;
    border-color: #d5f3e0;
}

.approve-btn:hover {
    color: #fff;
    background: #16864b;
    border-color: #16864b;
}

.complete-btn {
    color: #117d80;
    background: #ecfbfb;
    border-color: #d4f0f0;
}

.complete-btn:hover {
    color: #fff;
    background: #117d80;
    border-color: #117d80;
}

.cancel-btn {
    color: #d73535;
    background: #fff2f2;
    border-color: #ffdddd;
}

.cancel-btn:hover {
    color: #fff;
    background: #d73535;
    border-color: #d73535;
}

/* ================= EMPTY STATE ================= */

.empty-state,
.no-results {
    text-align: center;
    padding: 72px 20px;
}

.empty-state-icon {
    width: 78px;
    height: 78px;
    display: grid;
    place-items: center;
    margin: 0 auto 17px;
    border-radius: 23px;
    background: #eff6ff;
    color: #2563eb;
    box-shadow: inset 0 0 0 1px #dbeafe;
    font-size: 28px;
}

.empty-state h3,
.no-results h3 {
    margin: 0 0 7px;
    color: #202a3b;
    font-size: 18px;
    font-weight: 800;
}

.empty-state p,
.no-results p {
    margin: 0;
    color: #8a94a5;
    font-size: 12px;
}

.no-results {
    display: none;
}

.no-results i {
    display: block;
    margin-bottom: 12px;
    color: #a5afbd;
    font-size: 28px;
}

/* ================= MOBILE ================= */

.mobile-appointments {
    display: none;
}

.appointment-mobile-card {
    padding: 18px;
    border-bottom: 1px solid #edf1f5;
    background: #fff;
}

.appointment-mobile-card:last-child {
    border-bottom: 0;
}

.mobile-patient {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
}

.mobile-patient-info {
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
}

.mobile-patient-info img {
    width: 45px;
    height: 45px;
    flex: 0 0 45px;
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid #e8f0fb;
}

.mobile-patient-info h4 {
    margin: 0 0 3px;
    color: #202a3b;
    font-size: 13px;
    font-weight: 800;
}

.mobile-patient-info p {
    margin: 0;
    color: #909aaa;
    font-size: 10px;
}

.mobile-info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 9px;
    margin: 17px 0;
}

.mobile-info-item {
    padding: 11px 10px;
    border: 1px solid #edf1f5;
    border-radius: 11px;
    background: #fafbfd;
}

.mobile-info-item span {
    display: block;
    margin-bottom: 5px;
    color: #9aa3b1;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
}

.mobile-info-item strong {
    color: #3b4657;
    font-size: 11px;
}

.mobile-actions .action-btn {
    flex: 1;
    min-width: 80px;
}

/* ================= MODAL ================= */

.appointment-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(15, 23, 42, .52);
    backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transition:
        opacity .22s ease,
        visibility .22s ease;
}

.appointment-modal.show {
    opacity: 1;
    visibility: visible;
}

.modal-card {
    width: min(430px, 100%);
    padding: 30px;
    text-align: center;
    background: rgba(255, 255, 255, .98);
    border: 1px solid rgba(255, 255, 255, .8);
    border-radius: 22px;
    box-shadow: 0 28px 70px rgba(15, 23, 42, .2);
    transform: translateY(12px) scale(.98);
    transition: transform .22s ease;
}

.appointment-modal.show .modal-card {
    transform: translateY(0) scale(1);
}

.modal-icon {
    width: 58px;
    height: 58px;
    display: grid;
    place-items: center;
    margin: 0 auto 16px;
    border-radius: 17px;
    background: #fff1f2;
    color: #dc3545;
    font-size: 22px;
}

.modal-card h3 {
    margin: 0 0 9px;
    color: #1e293b;
    font-size: 20px;
    font-weight: 800;
}

.modal-card p {
    margin: 0;
    color: #7f8999;
    font-size: 12px;
    line-height: 1.7;
}

.modal-card p strong {
    color: #d73535;
}

.modal-actions {
    display: flex;
    justify-content: center;
    gap: 9px;
    margin-top: 23px;
}

.modal-btn {
    min-height: 40px;
    padding: 0 16px;
    border-radius: 10px;
    font-family: inherit;
    font-size: 11px;
    font-weight: 800;
    cursor: pointer;
    transition: .18s ease;
}

.modal-close {
    border: 1px solid #dfe5ec;
    background: #fff;
    color: #4b5668;
}

.modal-close:hover {
    background: #f8fafc;
}

.modal-confirm {
    border: 1px solid #dc3545;
    background: #dc3545;
    color: #fff;
}

.modal-confirm:hover {
    background: #bb2635;
}

.modal-actions form {
    margin: 0;
}

/* ================= RESPONSIVE ================= */

@media (max-width: 1180px) {
    .appointment-stats {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 850px) {
    .appointments-page {
        padding: 22px 15px;
    }

    .appointments-header {
        align-items: flex-start;
    }

    .appointments-heading h2 {
        font-size: 23px;
    }

    .appointments-heading-icon {
        width: 48px;
        height: 48px;
    }

    .appointments-toolbar {
        align-items: flex-start;
        flex-direction: column;
    }

    .toolbar-controls {
        width: 100%;
    }

    .search-box {
        flex: 1;
    }

    .search-input {
        width: 100%;
    }
}

@media (max-width: 650px) {
    .appointment-stats {
        grid-template-columns: 1fr 1fr;
    }

    .appointments-toolbar {
        padding: 17px;
    }

    .toolbar-title {
        width: 100%;
    }

    .toolbar-controls {
        display: grid;
        grid-template-columns: 1fr 1fr;
        width: 100%;
    }

    .search-box {
        width: 100%;
    }

    .status-filter {
        width: 100%;
        min-width: 0;
    }

    .table-wrapper {
        display: none;
    }

    .mobile-appointments {
        display: block;
    }

    .mobile-info-grid {
        grid-template-columns: 1fr 1fr;
    }
}

@media (max-width: 430px) {
    .appointments-page {
        padding: 17px 10px;
    }

    .appointments-heading {
        gap: 11px;
    }

    .appointments-heading h2 {
        font-size: 20px;
    }

    .appointments-heading p {
        font-size: 11px;
    }

    .appointments-heading-icon {
        width: 43px;
        height: 43px;
        border-radius: 13px;
        font-size: 17px;
    }

    .appointment-stat {
        min-height: 76px;
        padding: 13px;
    }

    .stat-icon {
        width: 39px;
        height: 39px;
        flex-basis: 39px;
        font-size: 15px;
    }

    .stat-info strong {
        font-size: 18px;
    }

    .stat-info span {
        font-size: 9px;
    }

    .toolbar-controls {
        grid-template-columns: 1fr;
    }

    .mobile-patient {
        align-items: flex-start;
    }

    .status-badge {
        padding: 5px 8px;
        font-size: 8px;
    }

    .mobile-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
    }

    .mobile-actions .action-btn {
        width: 100%;
    }

    .modal-card {
        padding: 24px 19px;
    }

    .modal-actions {
        flex-direction: column-reverse;
    }

    .modal-btn {
        width: 100%;
    }
}

/* ================= ACCESSIBILITY ================= */

.action-btn:focus-visible,
.modal-btn:focus-visible,
.search-input:focus-visible,
.status-filter:focus-visible {
    outline: 3px solid rgba(37, 99, 235, .18);
    outline-offset: 2px;
}
</style>

<div class="page-content appointments-page">

    <!-- HEADER -->
    <div class="appointments-header">

        <div class="appointments-heading">

            <div class="appointments-heading-icon">
                <i class="fa-solid fa-calendar-check"></i>
            </div>

            <div>
                <h2>Appointments</h2>
                <p>
                    Manage your patient appointments and consultations
                </p>
            </div>

        </div>

    </div>

    <!-- STATISTICS -->
    <div class="appointment-stats">

        <!-- TOTAL -->
        <div class="appointment-stat">

            <div class="stat-icon total">
                <i class="fa-solid fa-calendar-days"></i>
            </div>

            <div class="stat-info">
                <span>Total Appointments</span>
                <strong>
                    <%= stats?.total ?? 0 %>
                </strong>
            </div>

        </div>

        <!-- PENDING -->
        <div class="appointment-stat">

            <div class="stat-icon pending">
                <i class="fa-solid fa-hourglass-half"></i>
            </div>

            <div class="stat-info">
                <span>Pending</span>
                <strong>
                    <%= stats?.pending ?? 0 %>
                </strong>
            </div>

        </div>

        <!-- APPROVED -->
        <div class="appointment-stat">

            <div class="stat-icon approved">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="stat-info">
                <span>Approved</span>
                <strong>
                    <%= stats?.approved ?? 0 %>
                </strong>
            </div>

        </div>

        <!-- COMPLETED -->
        <div class="appointment-stat">

            <div class="stat-icon completed">
                <i class="fa-solid fa-check-double"></i>
            </div>

            <div class="stat-info">
                <span>Completed</span>
                <strong>
                    <%= stats?.completed ?? 0 %>
                </strong>
            </div>

        </div>

        <!-- CANCELLED -->
        <div class="appointment-stat">

            <div class="stat-icon cancelled">
                <i class="fa-solid fa-calendar-xmark"></i>
            </div>

            <div class="stat-info">
                <span>Cancelled</span>
                <strong>
                    <%= stats?.cancelled ?? 0 %>
                </strong>
            </div>

        </div>

    </div>

    <!-- MAIN CARD -->
    <div class="appointments-card">

        <!-- TOOLBAR -->
        <div class="appointments-toolbar">

            <div class="toolbar-title">

                <h3>
                    All Appointments
                </h3>

                <p>
                    View and manage your complete appointment schedule
                </p>

            </div>

            <div class="toolbar-controls">

                <!-- SEARCH -->
                <div class="search-box">

                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input
                        type="text"
                        id="appointmentSearch"
                        class="search-input"
                        placeholder="Search patient..."
                        autocomplete="off">

                </div>

                <!-- STATUS -->
                <select
                    id="statusFilter"
                    class="status-filter">

                    <option value="all">
                        All Status
                    </option>

                    <option value="Pending">
                        Pending
                    </option>

                    <option value="Approved">
                        Approved
                    </option>

                    <option value="Completed">
                        Completed
                    </option>

                    <option value="Cancelled">
                        Cancelled
                    </option>

                </select>

            </div>

        </div>

        <% if (appointments && appointments.length > 0) { %>

            <!-- DESKTOP TABLE -->
            <div class="table-wrapper">

                <table class="appointments-table">

                    <thead>

                        <tr>
                            <th>Patient</th>
                            <th>Date</th>
                            <th>Time</th>
                            <th>Department</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>

                    </thead>

                    <tbody id="appointmentTableBody">

                        <% appointments.forEach(item => { %>

                            <%
                                const patient = item.patient || {};

                                const patientName =
                                    `${patient.firstName || ""} ${patient.lastName || ""}`
                                    .trim() || "Unknown Patient";

                                const email =
                                    patient.email || "No email available";

                                const image =
                                    patient.profileImage ||
                                    "/images/default-user.png";
                            %>

                            <tr
                                class="appointment-row"
                                data-name="<%= patientName.toLowerCase() %>"
                                data-status="<%= item.status %>">

                                <!-- PATIENT -->
                                <td>

                                    <div class="patient-cell">

                                        <img
                                            src="<%= image %>"
                                            class="patient-avatar"
                                            alt="Patient"
                                            onerror="this.src='/images/default-user.png'">

                                        <div>

                                            <p class="patient-name">
                                                <%= patientName %>
                                            </p>

                                            <p class="patient-email">
                                                <%= email %>
                                            </p>

                                        </div>

                                    </div>

                                </td>

                                <!-- DATE -->
                                <td>

                                    <div class="date-cell">

                                        <strong>
                                            <%= item.appointmentDate
                                                ? new Date(item.appointmentDate)
                                                    .toLocaleDateString("en-IN", {
                                                        day: "2-digit",
                                                        month: "short",
                                                        year: "numeric"
                                                    })
                                                : "Date not available"
                                            %>
                                        </strong>

                                        <span>
                                            <%= item.appointmentDate
                                                ? new Date(item.appointmentDate)
                                                    .toLocaleDateString("en-IN", {
                                                        weekday: "long"
                                                    })
                                                : ""
                                            %>
                                        </span>

                                    </div>

                                </td>

                                <!-- TIME -->
                                <td>

                                    <span class="time-cell">

                                        <i class="fa-regular fa-clock"></i>

                                        <%= item.appointmentTime ||
                                            "Time not available" %>

                                    </span>

                                </td>

                                <!-- DEPARTMENT -->
                                <td>

                                    <span class="department">

                                        <i class="fa-solid fa-stethoscope"></i>

                                        <%= item.department || "General" %>

                                    </span>

                                </td>

                                <!-- STATUS -->
                                <td>

                                    <% if (item.status === "Pending") { %>

                                        <span class="status-badge status-pending">
                                            <span class="status-dot"></span>
                                            Pending
                                        </span>

                                    <% } else if (item.status === "Approved") { %>

                                        <span class="status-badge status-approved">
                                            <span class="status-dot"></span>
                                            Approved
                                        </span>

                                    <% } else if (item.status === "Completed") { %>

                                        <span class="status-badge status-completed">
                                            <span class="status-dot"></span>
                                            Completed
                                        </span>

                                    <% } else { %>

                                        <span class="status-badge status-cancelled">
                                            <span class="status-dot"></span>
                                            Cancelled
                                        </span>

                                    <% } %>

                                </td>

                                <!-- ACTIONS -->
                                <td>

                                    <div class="table-actions">

                                        <a
                                            href="/doctor/appointments/<%= item._id %>"
                                            class="action-btn view-btn">

                                            <i class="fa-regular fa-eye"></i>
                                            View

                                        </a>

                                        <% if (item.status === "Pending") { %>

                                            <!-- APPROVE -->
                                            <form
                                                action="/doctor/appointments/<%= item._id %>/approve"
                                                method="POST"
                                                class="action-form">

                                                <button
                                                    type="submit"
                                                    class="action-btn approve-btn">

                                                    <i class="fa-solid fa-check"></i>
                                                    Approve

                                                </button>

                                            </form>

                                            <!-- CANCEL -->
                                            <button
                                                type="button"
                                                class="action-btn cancel-btn"
                                                onclick="openCancelModal('<%= item._id %>')">

                                                <i class="fa-solid fa-xmark"></i>
                                                Cancel

                                            </button>

                                        <% } %>

                                        <% if (item.status === "Approved") { %>

                                            <!-- COMPLETE -->
                                            <form
                                                action="/doctor/appointments/<%= item._id %>/complete"
                                                method="POST"
                                                class="action-form">

                                                <button
                                                    type="submit"
                                                    class="action-btn complete-btn">

                                                    <i class="fa-solid fa-check-double"></i>
                                                    Complete

                                                </button>

                                            </form>

                                            <!-- CANCEL -->
                                            <button
                                                type="button"
                                                class="action-btn cancel-btn"
                                                onclick="openCancelModal('<%= item._id %>')">

                                                <i class="fa-solid fa-xmark"></i>
                                                Cancel

                                            </button>

                                        <% } %>

                                    </div>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

            </div>

            <!-- =====================================================
                 MOBILE APPOINTMENTS
            ====================================================== -->

            <div class="mobile-appointments" id="mobileAppointments">

                <% appointments.forEach(item => { %>

                    <%
                        const patient = item.patient || {};

                        const patientName =
                            `${patient.firstName || ""} ${patient.lastName || ""}`
                            .trim() || "Unknown Patient";

                        const image =
                            patient.profileImage ||
                            "/images/default-user.png";
                    %>

                    <div
                        class="appointment-mobile-card appointment-mobile-item"
                        data-name="<%= patientName.toLowerCase() %>"
                        data-status="<%= item.status %>">

                        <!-- Patient Header -->
                        <div class="mobile-patient">

                            <div class="mobile-patient-info">

                                <img
                                    src="<%= image %>"
                                    alt="Patient"
                                    onerror="this.src='/images/default-user.png'">

                                <div>
                                    <h4>
                                        <%= patientName %>
                                    </h4>

                                    <p>
                                        <%= item.department || "General" %>
                                    </p>
                                </div>

                            </div>


                            <!-- Status -->
                            <% if (item.status === "Pending") { %>

                                <span class="status-badge status-pending">
                                    <span class="status-dot"></span>
                                    Pending
                                </span>

                            <% } else if (item.status === "Approved") { %>

                                <span class="status-badge status-approved">
                                    <span class="status-dot"></span>
                                    Approved
                                </span>

                            <% } else if (item.status === "Completed") { %>

                                <span class="status-badge status-completed">
                                    <span class="status-dot"></span>
                                    Completed
                                </span>

                            <% } else { %>

                                <span class="status-badge status-cancelled">
                                    <span class="status-dot"></span>
                                    Cancelled
                                </span>

                            <% } %>

                        </div>


                        <!-- Appointment Information -->
                        <div class="mobile-info-grid">

                            <!-- Date -->
                            <div class="mobile-info-item">

                                <span>Date</span>

                                <strong>
                                    <%= item.appointmentDate
                                        ? new Date(item.appointmentDate)
                                            .toLocaleDateString("en-IN", {
                                                day: "2-digit",
                                                month: "short",
                                                year: "numeric"
                                            })
                                        : "Date not available"
                                    %>
                                </strong>

                            </div>


                            <!-- Time -->
                            <div class="mobile-info-item">

                                <span>Time</span>

                                <strong>
                                    <%= item.appointmentTime ||
                                        "Time not available" %>
                                </strong>

                            </div>


                            <!-- Department -->
                            <div class="mobile-info-item">

                                <span>Department</span>

                                <strong>
                                    <%= item.department || "General" %>
                                </strong>

                            </div>

                        </div>


                        <!-- Mobile Actions -->
                        <div class="mobile-actions">

                            <!-- View -->
                            <a
                                href="/doctor/appointments/<%= item._id %>"
                                class="action-btn view-btn">

                                <i class="fa-regular fa-eye"></i>
                                View

                            </a>


                            <!-- Pending Actions -->
                            <% if (item.status === "Pending") { %>

                                <form
                                    action="/doctor/appointments/<%= item._id %>/approve"
                                    method="POST"
                                    class="action-form">

                                    <button
                                        type="submit"
                                        class="action-btn approve-btn">

                                        <i class="fa-solid fa-check"></i>
                                        Approve

                                    </button>

                                </form>


                                <button
                                    type="button"
                                    class="action-btn cancel-btn"
                                    onclick="openCancelModal('<%= item._id %>')">

                                    <i class="fa-solid fa-xmark"></i>
                                    Cancel

                                </button>

                            <% } %>


                            <!-- Approved Actions -->
                            <% if (item.status === "Approved") { %>

                                <form
                                    action="/doctor/appointments/<%= item._id %>/complete"
                                    method="POST"
                                    class="action-form">

                                    <button
                                        type="submit"
                                        class="action-btn complete-btn">

                                        <i class="fa-solid fa-check-double"></i>
                                        Complete

                                    </button>

                                </form>


                                <button
                                    type="button"
                                    class="action-btn cancel-btn"
                                    onclick="openCancelModal('<%= item._id %>')">

                                    <i class="fa-solid fa-xmark"></i>
                                    Cancel

                                </button>

                            <% } %>

                        </div>

                    </div>

                <% }) %>

            </div>


            <!-- =====================================================
                 NO SEARCH RESULTS
            ====================================================== -->

            <div
                id="noResults"
                class="no-results">

                <i class="fa-solid fa-magnifying-glass"></i>

                <h3>
                    No appointments found
                </h3>

                <p>
                    Try changing your search or status filter.
                </p>

            </div>


        <% } else { %>


            <!-- =====================================================
                 EMPTY STATE
            ====================================================== -->

            <div class="empty-state">

                <div class="empty-state-icon">

                    <i class="fa-regular fa-calendar-xmark"></i>

                </div>

                <h3>
                    No Appointments Yet
                </h3>

                <p>
                    You don't have any patient appointments
                    at the moment.
                </p>

            </div>


        <% } %>

    </div>

</div>


<!-- =============================================================
     CANCEL APPOINTMENT MODAL
============================================================== -->

<div
    id="cancelModal"
    class="appointment-modal"
    aria-hidden="true">

    <div
        class="modal-card"
        role="dialog"
        aria-modal="true"
        aria-labelledby="cancelTitle">


        <!-- Warning Icon -->
        <div class="modal-icon">

            <i class="fa-solid fa-triangle-exclamation"></i>

        </div>


        <!-- Title -->
        <h3 id="cancelTitle">
            Cancel Appointment?
        </h3>


        <!-- Description -->
        <p>

            Are you sure you want to cancel this appointment?

            This action will change the appointment status to
            <strong>Cancelled</strong>.

        </p>


        <!-- Modal Actions -->
        <div class="modal-actions">


            <!-- Close -->
            <button
                type="button"
                class="modal-btn modal-close"
                onclick="closeCancelModal()">

                Keep Appointment

            </button>


            <!-- Confirm -->
            <form
                id="cancelAppointmentForm"
                method="POST">

                <button
                    type="submit"
                    class="modal-btn modal-confirm">

                    Yes, Cancel

                </button>

            </form>

        </div>

    </div>

</div>



<script>

/* =============================================================
   SEARCH + STATUS FILTER
============================================================= */

document.addEventListener("DOMContentLoaded", function () {


    const searchInput =
        document.getElementById("appointmentSearch");


    const statusFilter =
        document.getElementById("statusFilter");


    const rows =
        document.querySelectorAll(".appointment-row");


    const mobileItems =
        document.querySelectorAll(
            ".appointment-mobile-item"
        );


    const noResults =
        document.getElementById("noResults");



    function filterAppointments() {


        const searchValue =
            searchInput
                ? searchInput.value
                    .toLowerCase()
                    .trim()
                : "";


        const statusValue =
            statusFilter
                ? statusFilter.value
                : "all";


        let visibleCount = 0;



        /* =====================================================
           DESKTOP TABLE
        ====================================================== */

        rows.forEach(function (row) {


            const name =
                (row.dataset.name || "")
                    .toLowerCase();


            const status =
                row.dataset.status || "";


            const matchesSearch =
                name.includes(searchValue);


            const matchesStatus =
                statusValue === "all" ||
                status === statusValue;


            const visible =
                matchesSearch &&
                matchesStatus;


            row.style.display =
                visible ? "" : "none";


            if (visible) {

                visibleCount++;

            }

        });



        /* =====================================================
           MOBILE CARDS
        ====================================================== */

        mobileItems.forEach(function (item) {


            const name =
                (item.dataset.name || "")
                    .toLowerCase();


            const status =
                item.dataset.status || "";


            const matchesSearch =
                name.includes(searchValue);


            const matchesStatus =
                statusValue === "all" ||
                status === statusValue;


            item.style.display =
                matchesSearch && matchesStatus
                    ? ""
                    : "none";

        });



        /* =====================================================
           NO RESULTS MESSAGE
        ====================================================== */

        if (noResults) {


            noResults.style.display =
                visibleCount === 0
                    ? "block"
                    : "none";

        }

    }



    /* =========================================================
       SEARCH EVENT
    ========================================================== */

    if (searchInput) {

        searchInput.addEventListener(
            "input",
            filterAppointments
        );

    }



    /* =========================================================
       STATUS FILTER EVENT
    ========================================================== */

    if (statusFilter) {

        statusFilter.addEventListener(
            "change",
            filterAppointments
        );

    }



    /* =========================================================
       INITIAL FILTER
    ========================================================== */

    filterAppointments();

});



/* =============================================================
   OPEN CANCEL MODAL
============================================================= */

function openCancelModal(appointmentId) {


    const modal =
        document.getElementById(
            "cancelModal"
        );


    const form =
        document.getElementById(
            "cancelAppointmentForm"
        );


    if (!modal || !form) {

        return;

    }



    /*
     * IMPORTANT
     * Existing backend route is preserved.
     */

    form.action =
        "/doctor/appointments/" +
        appointmentId +
        "/cancel";



    /* Show Modal */

    modal.classList.add("show");


    modal.setAttribute(
        "aria-hidden",
        "false"
    );


    /* Prevent background scrolling */

    document.body.style.overflow =
        "hidden";



    /* =========================================================
       Focus Confirm Button
    ========================================================== */

    const confirmButton =
        modal.querySelector(
            ".modal-confirm"
        );


    if (confirmButton) {


        setTimeout(function () {

            confirmButton.focus();

        }, 80);

    }

}



/* =============================================================
   CLOSE CANCEL MODAL
============================================================= */

function closeCancelModal() {


    const modal =
        document.getElementById(
            "cancelModal"
        );


    if (!modal) {

        return;

    }



    modal.classList.remove("show");


    modal.setAttribute(
        "aria-hidden",
        "true"
    );


    /* Restore scrolling */

    document.body.style.overflow =
        "";

}



/* =============================================================
   CLICK OUTSIDE MODAL
============================================================= */

const cancelModal =
    document.getElementById(
        "cancelModal"
    );


if (cancelModal) {


    cancelModal.addEventListener(
        "click",
        function (event) {


            if (event.target === this) {

                closeCancelModal();

            }

        }
    );

}



/* =============================================================
   ESC KEY
============================================================= */

document.addEventListener(
    "keydown",
    function (event) {


        if (event.key === "Escape") {

            closeCancelModal();

        }

    }
);

</script>



<!-- =============================================================
     DOCTOR FOOTER
============================================================== -->

<%- include("../../layouts/footer") %>