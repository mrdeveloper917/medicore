<%- include("../../layouts/doctorHeader", {
    title: "Add Medical Record",
    user: user
}) %>


<div class="medical-record-page">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="page-header">

        <div class="page-title">

            <div class="page-title-icon">
                <i class="fa-solid fa-file-medical"></i>
            </div>

            <div>

                <h1>
                    Add Medical Record
                </h1>

                <p>
                    Add medical details for this patient visit.
                </p>

            </div>

        </div>


        <a
            href="/doctor/appointments/<%= appointment._id %>"
            class="back-btn"
        >

            <i class="fa-solid fa-arrow-left"></i>

            <span>Back</span>

        </a>

    </div>



    <!-- =====================================================
         PATIENT CARD
    ====================================================== -->

    <div class="patient-card">

        <div class="patient-image">

            <% if (appointment.patient?.profileImage) { %>

                <img
                    src="<%= appointment.patient.profileImage %>"
                    alt="Patient"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
                >

                <div
                    class="patient-placeholder"
                    style="display:none;"
                >
                    <i class="fa-solid fa-user"></i>
                </div>

            <% } else { %>

                <div class="patient-placeholder">

                    <i class="fa-solid fa-user"></i>

                </div>

            <% } %>

        </div>


        <div class="patient-info">

            <span class="patient-label">
                PATIENT
            </span>

            <h2>

                <%= appointment.patient?.firstName || "" %>

                <%= appointment.patient?.lastName || "" %>

            </h2>

            <div class="patient-contact">

                <span>

                    <i class="fa-regular fa-envelope"></i>

                    <%= appointment.patient?.email || "No email" %>

                </span>


                <% if (appointment.patient?.phone) { %>

                    <span>

                        <i class="fa-solid fa-phone"></i>

                        <%= appointment.patient.phone %>

                    </span>

                <% } %>

            </div>

        </div>

    </div>



    <!-- =====================================================
         APPOINTMENT INFORMATION
    ====================================================== -->

    <div class="appointment-card">


        <!-- DEPARTMENT -->

        <div class="appointment-info">

            <div class="appointment-icon">

                <i class="fa-solid fa-stethoscope"></i>

            </div>

            <div>

                <span>
                    Department
                </span>

                <strong>
                    <%= appointment.department %>
                </strong>

            </div>

        </div>


        <!-- DATE -->

        <div class="appointment-info">

            <div class="appointment-icon">

                <i class="fa-regular fa-calendar"></i>

            </div>

            <div>

                <span>
                    Date
                </span>

                <strong>

                    <%= new Date(
                        appointment.appointmentDate
                    ).toLocaleDateString(
                        "en-IN",
                        {
                            day:"2-digit",
                            month:"short",
                            year:"numeric"
                        }
                    ) %>

                </strong>

            </div>

        </div>


        <!-- TIME -->

        <div class="appointment-info">

            <div class="appointment-icon">

                <i class="fa-regular fa-clock"></i>

            </div>

            <div>

                <span>
                    Time
                </span>

                <strong>
                    <%= appointment.appointmentTime %>
                </strong>

            </div>

        </div>


        <!-- STATUS -->

        <div class="appointment-info">

            <div class="appointment-icon status-icon">

                <i class="fa-solid fa-circle-check"></i>

            </div>

            <div>

                <span>
                    Status
                </span>

                <strong class="approved">
                    <%= appointment.status %>
                </strong>

            </div>

        </div>


    </div>



    <!-- =====================================================
         MEDICAL RECORD FORM
    ====================================================== -->

    <form
        action="/doctor/appointments/<%= appointment._id %>/medical-record"
        method="POST"
        class="medical-form"
        id="medicalRecordForm"
    >


        <!-- FORM HEADER -->

        <div class="form-header">

            <div class="form-header-icon">

                <i class="fa-solid fa-notes-medical"></i>

            </div>

            <div>

                <h2>
                    Medical Information
                </h2>

                <p>
                    Enter the patient's medical information carefully.
                </p>

            </div>

        </div>



        <div class="form-section">


            <!-- =================================================
                 VISIT DATE
            ================================================== -->

            <div class="form-group">

                <label for="visitDate">

                    <span class="label-icon">
                        <i class="fa-regular fa-calendar"></i>
                    </span>

                    Visit Date

                </label>

                <input
                    type="date"
                    id="visitDate"
                    name="visitDate"
                    value="<%= new Date(
                        appointment.appointmentDate
                    ).toISOString().split('T')[0] %>"
                >

            </div>



            <!-- =================================================
                 DIAGNOSIS
            ================================================== -->

            <div class="form-group">

                <label for="diagnosis">

                    <span class="label-icon">
                        <i class="fa-solid fa-stethoscope"></i>
                    </span>

                    Diagnosis

                    <span class="required">
                        *
                    </span>

                </label>

                <textarea
                    id="diagnosis"
                    name="diagnosis"
                    rows="4"
                    placeholder="Enter diagnosis..."
                    required
                ></textarea>

                <small>
                    Provide the primary diagnosis identified during the consultation.
                </small>

            </div>



            <!-- =================================================
                 SYMPTOMS
            ================================================== -->

            <div class="form-group">

                <label for="symptoms">

                    <span class="label-icon">
                        <i class="fa-solid fa-virus"></i>
                    </span>

                    Symptoms

                </label>

                <textarea
                    id="symptoms"
                    name="symptoms"
                    rows="4"
                    placeholder="Enter patient's symptoms..."
                ></textarea>

                <small>
                    Mention the symptoms reported or observed during the visit.
                </small>

            </div>



            <!-- =================================================
                 TREATMENT
            ================================================== -->

            <div class="form-group">

                <label for="treatment">

                    <span class="label-icon">
                        <i class="fa-solid fa-hand-holding-medical"></i>
                    </span>

                    Treatment

                </label>

                <textarea
                    id="treatment"
                    name="treatment"
                    rows="4"
                    placeholder="Enter treatment details..."
                ></textarea>

                <small>
                    Add the treatment or procedures recommended for the patient.
                </small>

            </div>



            <!-- =================================================
                 MEDICINES
            ================================================== -->

            <div class="form-group">

                <label for="medicines">

                    <span class="label-icon">
                        <i class="fa-solid fa-pills"></i>
                    </span>

                    Medicines

                </label>

                <textarea
                    id="medicines"
                    name="medicines"
                    rows="4"
                    placeholder="Enter prescribed medicines..."
                ></textarea>

                <small>
                    Enter prescribed medicines and relevant instructions.
                </small>

            </div>



            <!-- =================================================
                 DOCTOR NOTES
            ================================================== -->

            <div class="form-group">

                <label for="notes">

                    <span class="label-icon">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </span>

                    Doctor's Notes

                </label>

                <textarea
                    id="notes"
                    name="notes"
                    rows="5"
                    placeholder="Add additional notes..."
                ></textarea>

                <small>
                    Add any additional observations or follow-up instructions.
                </small>

            </div>


        </div>



        <!-- =================================================
             FORM ACTIONS
        ================================================== -->

        <div class="form-actions">

            <a
                href="/doctor/appointments/<%= appointment._id %>"
                class="cancel-btn"
            >

                <i class="fa-solid fa-xmark"></i>

                Cancel

            </a>


            <button
                type="submit"
                class="save-btn"
                id="saveMedicalRecordBtn"
            >

                <i class="fa-solid fa-check"></i>

                Save Medical Record

            </button>

        </div>


    </form>

</div>



<style>

/* =========================================================
   MEDICORE — ADD MEDICAL RECORD
========================================================= */

.medical-record-page{
    max-width:1150px;
    margin:0 auto;
    padding:30px;
    color:#273143;
}


/* =========================================================
   PAGE HEADER
========================================================= */

.page-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:20px;
    margin-bottom:24px;
}

.page-title{
    display:flex;
    align-items:center;
    gap:14px;
}

.page-title-icon{
    width:52px;
    height:52px;

    display:grid;
    place-items:center;

    border-radius:15px;

    background:linear-gradient(
        145deg,
        #f3efff,
        #e9e1ff
    );

    color:#7c3aed;

    font-size:21px;

    box-shadow:
        inset 0 0 0 1px #e5d9ff;
}

.page-title h1{
    margin:0 0 4px;

    color:#182234;

    font-size:25px;
    font-weight:750;

    letter-spacing:-.3px;
}

.page-title p{
    margin:0;

    color:#8a94a5;

    font-size:12px;
}

.back-btn{
    height:42px;

    padding:0 16px;

    display:inline-flex;
    align-items:center;

    gap:8px;

    border:1px solid #e2e8f0;

    border-radius:10px;

    background:#fff;

    color:#596579;

    text-decoration:none;

    font-size:12px;
    font-weight:650;

    box-shadow:
        0 3px 12px rgba(20,34,56,.035);

    transition:.2s ease;
}

.back-btn:hover{
    color:#1976d2;

    border-color:#cfe1f7;

    background:#f8fbff;

    transform:translateY(-1px);
}


/* =========================================================
   PATIENT CARD
========================================================= */

.patient-card{
    position:relative;

    overflow:hidden;

    display:flex;
    align-items:center;

    gap:18px;

    padding:21px;

    margin-bottom:18px;

    border:1px solid #e5ebf2;

    border-radius:17px;

    background:
        linear-gradient(
            135deg,
            #ffffff,
            #f8fbff
        );

    box-shadow:
        0 7px 24px rgba(20,34,56,.045);
}

.patient-card::after{
    content:"";

    position:absolute;

    width:150px;
    height:150px;

    right:-60px;
    top:-75px;

    border-radius:50%;

    background:#f0f7ff;

    pointer-events:none;
}

.patient-image{
    position:relative;
    z-index:1;

    flex-shrink:0;
}

.patient-image img,
.patient-placeholder{
    width:76px;
    height:76px;

    border-radius:50%;
}

.patient-image img{
    display:block;

    object-fit:cover;

    border:3px solid #edf5ff;

    padding:2px;

    background:#fff;

    box-shadow:
        0 5px 16px rgba(25,118,210,.08);
}

.patient-placeholder{
    display:flex;

    align-items:center;
    justify-content:center;

    background:#eef6ff;

    color:#1976d2;

    border:3px solid #e0efff;

    font-size:25px;
}

.patient-info{
    position:relative;
    z-index:1;

    min-width:0;
}

.patient-label{
    display:block;

    margin-bottom:4px;

    color:#929baa;

    font-size:9px;
    font-weight:700;

    letter-spacing:.7px;

    text-transform:uppercase;
}

.patient-info h2{
    margin:0 0 7px;

    color:#1d2738;

    font-size:20px;

    font-weight:750;
}

.patient-contact{
    display:flex;
    flex-wrap:wrap;

    gap:12px;
}

.patient-contact span{
    display:inline-flex;
    align-items:center;

    gap:6px;

    color:#7f899a;

    font-size:10px;
}

.patient-contact i{
    color:#1976d2;
}


/* =========================================================
   APPOINTMENT CARD
========================================================= */

.appointment-card{
    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:0;

    margin-bottom:22px;

    border:1px solid #e5ebf2;

    border-radius:16px;

    background:#fff;

    overflow:hidden;

    box-shadow:
        0 7px 24px rgba(20,34,56,.04);
}

.appointment-info{
    min-width:0;

    display:flex;
    align-items:center;

    gap:11px;

    padding:17px;

    border-right:1px solid #edf0f4;
}

.appointment-info:last-child{
    border-right:0;
}

.appointment-icon{
    width:36px;
    height:36px;

    flex-shrink:0;

    display:grid;
    place-items:center;

    border-radius:10px;

    background:#eef6ff;

    color:#1976d2;

    font-size:13px;
}

.status-icon{
    color:#168b55;

    background:#eaf8f0;
}

.appointment-info span{
    display:block;

    margin-bottom:4px;

    color:#929baa;

    font-size:9px;
    font-weight:650;

    text-transform:uppercase;

    letter-spacing:.35px;
}

.appointment-info strong{
    display:block;

    color:#303a4c;

    font-size:12px;

    font-weight:700;

    word-break:break-word;
}

.appointment-info .approved{
    color:#16884c;
}


/* =========================================================
   MEDICAL FORM
========================================================= */

.medical-form{
    overflow:hidden;

    border:1px solid #e5ebf2;

    border-radius:18px;

    background:#fff;

    box-shadow:
        0 8px 28px rgba(20,34,56,.05);
}

.form-header{
    display:flex;
    align-items:center;

    gap:12px;

    padding:19px 23px;

    border-bottom:1px solid #edf1f5;

    background:
        linear-gradient(
            180deg,
            #fff,
            #fcfdff
        );
}

.form-header-icon{
    width:38px;
    height:38px;

    display:grid;
    place-items:center;

    border-radius:10px;

    background:#f3efff;

    color:#7c3aed;

    font-size:14px;
}

.form-header h2{
    margin:0 0 3px;

    color:#273143;

    font-size:15px;

    font-weight:750;
}

.form-header p{
    margin:0;

    color:#929baa;

    font-size:10px;
}

.form-section{
    padding:25px;
}


/* =========================================================
   FORM GROUP
========================================================= */

.form-group{
    margin-bottom:22px;
}

.form-group:last-child{
    margin-bottom:0;
}

.form-group label{
    display:flex;
    align-items:center;

    gap:7px;

    margin-bottom:8px;

    color:#374151;

    font-size:11px;

    font-weight:700;
}

.label-icon{
    width:24px;
    height:24px;

    display:grid;
    place-items:center;

    border-radius:7px;

    background:#f3f7fc;

    color:#1976d2;

    font-size:10px;
}

.required{
    color:#dc2626;

    font-size:13px;
}

.form-group input,
.form-group textarea{
    display:block;

    width:100%;

    box-sizing:border-box;

    padding:13px 14px;

    border:1px solid #dfe5ec;

    border-radius:10px;

    outline:none;

    background:#fcfdff;

    color:#303a4c;

    font-family:inherit;

    font-size:12px;

    transition:
        border-color .2s ease,
        box-shadow .2s ease,
        background .2s ease;
}

.form-group input{
    min-height:44px;
}

.form-group textarea{
    min-height:105px;

    resize:vertical;

    line-height:1.55;
}

.form-group input::placeholder,
.form-group textarea::placeholder{
    color:#b0b7c2;
}

.form-group input:hover,
.form-group textarea:hover{
    border-color:#cbd6e2;

    background:#fff;
}

.form-group input:focus,
.form-group textarea:focus{
    border-color:#1976d2;

    background:#fff;

    box-shadow:
        0 0 0 3px rgba(25,118,210,.09);
}

.form-group small{
    display:block;

    margin-top:6px;

    color:#a0a8b5;

    font-size:9px;

    line-height:1.5;
}


/* =========================================================
   FORM ACTIONS
========================================================= */

.form-actions{
    display:flex;

    align-items:center;
    justify-content:flex-end;

    gap:10px;

    padding:17px 25px;

    border-top:1px solid #edf1f5;

    background:#fcfdff;
}

.cancel-btn,
.save-btn{
    min-height:42px;

    padding:0 18px;

    display:inline-flex;

    align-items:center;
    justify-content:center;

    gap:8px;

    border-radius:10px;

    font-family:inherit;

    font-size:11px;

    font-weight:700;

    text-decoration:none;

    cursor:pointer;

    transition:.2s ease;
}

.cancel-btn{
    border:1px solid #e1e6ec;

    background:#f5f6f8;

    color:#596477;
}

.cancel-btn:hover{
    background:#eceff3;

    transform:translateY(-1px);
}

.save-btn{
    border:1px solid #1976d2;

    background:
        linear-gradient(
            135deg,
            #2583dd,
            #1976d2
        );

    color:#fff;

    box-shadow:
        0 5px 14px rgba(25,118,210,.16);
}

.save-btn:hover{
    background:#145fa9;

    transform:translateY(-1px);

    box-shadow:
        0 7px 18px rgba(25,118,210,.22);
}

.save-btn:disabled{
    opacity:.65;

    cursor:not-allowed;

    transform:none;

    box-shadow:none;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:900px){

    .appointment-card{
        grid-template-columns:1fr 1fr;
    }

    .appointment-info:nth-child(2){
        border-right:0;
    }

    .appointment-info:nth-child(-n+2){
        border-bottom:1px solid #edf0f4;
    }

}


@media(max-width:650px){

    .medical-record-page{
        padding:18px 13px;
    }

    .page-header{
        align-items:flex-start;

        gap:12px;
    }

    .page-title{
        gap:10px;
    }

    .page-title-icon{
        width:43px;
        height:43px;

        font-size:18px;
    }

    .page-title h1{
        font-size:20px;
    }

    .page-title p{
        font-size:10px;
    }

    .back-btn{
        width:40px;

        padding:0;

        justify-content:center;

        font-size:0;
    }

    .back-btn i{
        font-size:13px;
    }

    .patient-card{
        align-items:flex-start;

        padding:17px;
    }

    .patient-image img,
    .patient-placeholder{
        width:62px;
        height:62px;
    }

    .patient-info h2{
        font-size:17px;
    }

    .patient-contact{
        flex-direction:column;

        gap:5px;
    }

    .appointment-card{
        grid-template-columns:1fr;
    }

    .appointment-info,
    .appointment-info:nth-child(2){
        border-right:0;

        border-bottom:1px solid #edf0f4;
    }

    .appointment-info:last-child{
        border-bottom:0;
    }

    .form-header{
        padding:16px 17px;
    }

    .form-section{
        padding:18px 17px;
    }

    .form-actions{
        padding:15px 17px;

        flex-direction:column-reverse;
    }

    .cancel-btn,
    .save-btn{
        width:100%;
    }

}


@media(prefers-reduced-motion:reduce){

    *,
    *::before,
    *::after{
        animation-duration:.01ms !important;

        transition-duration:.01ms !important;

        scroll-behavior:auto !important;
    }

}

</style>
<script>

/* =========================================================
   SAVE MEDICAL RECORD — BUTTON LOADING STATE
========================================================= */

document.addEventListener(
    "DOMContentLoaded",
    function(){

        const form =
            document.getElementById(
                "medicalRecordForm"
            );

        const button =
            document.getElementById(
                "saveMedicalRecordBtn"
            );


        if(!form || !button){
            return;
        }


        form.addEventListener(
            "submit",
            function(){

                button.disabled = true;

                button.innerHTML = `
                    <i class="fa-solid fa-spinner fa-spin"></i>
                    Saving Medical Record...
                `;

            }
        );

    }
);

</script>


<%- include("../../layouts/doctorFooter") %>