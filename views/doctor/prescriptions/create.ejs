<%- include("../../layouts/doctorHeader") %>

<style>
    .create-page {
        padding: 25px;
        background: #f5f7fb;
        min-height: calc(100vh - 100px);
    }

    .page-header {
        margin-bottom: 25px;
    }

    .page-header h1 {
        margin: 0;
        color: #1f2937;
    }

    .page-header p {
        color: #6b7280;
        margin-top: 6px;
    }

    .form-card {
        max-width: 850px;
        margin: auto;
        background: white;
        padding: 30px;
        border-radius: 18px;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #374151;
        font-weight: 600;
    }

    .required {
        color: #ef4444;
    }

    .form-control {
        width: 100%;
        box-sizing: border-box;
        padding: 13px 14px;
        border: 1px solid #d1d5db;
        border-radius: 10px;
        outline: none;
        font-size: 14px;
        background: white;
    }

    .form-control:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99,102,241,.1);
    }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 25px;
    }

    .btn {
        padding: 12px 20px;
        border-radius: 10px;
        border: none;
        text-decoration: none;
        cursor: pointer;
        font-weight: 600;
    }

    .cancel-btn {
        background: #f3f4f6;
        color: #374151;
    }

    .submit-btn {
        background: #6366f1;
        color: white;
    }

    .submit-btn:hover {
        background: #4f46e5;
    }

    .empty-message {
        padding: 20px;
        background: #fff7ed;
        color: #9a3412;
        border-radius: 10px;
        margin-bottom: 20px;
    }

    @media (max-width: 600px) {
        .create-page {
            padding: 15px;
        }

        .form-card {
            padding: 20px;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn {
            width: 100%;
            text-align: center;
        }
    }
</style>


<div class="create-page">

    <div class="page-header">

        <h1>Create Prescription</h1>

        <p>
            Create a new prescription for your patient.
        </p>

    </div>


    <div class="form-card">

        <% if (!patients || patients.length === 0) { %>

            <div class="empty-message">

                <i class="fas fa-circle-exclamation"></i>

                No patients are available.
                A patient must have an appointment with you
                before you can create a prescription.

            </div>

        <% } %>


        <form
            action="/doctor/prescriptions/create"
            method="POST"
        >

            <!-- PATIENT -->
            <div class="form-group">

                <label for="patient">
                    Patient
                    <span class="required">*</span>
                </label>

                <select
                    name="patient"
                    id="patient"
                    class="form-control"
                    required
                >

                    <option value="">
                        Select Patient
                    </option>

                    <% if (patients) { %>

                        <% patients.forEach(function(patient) { %>

                            <option value="<%= patient._id %>">

                                <%= (patient.firstName || "") + " " + (patient.lastName || "") %>

                                <% if (patient.email) { %>
                                    — <%= patient.email %>
                                <% } %>

                            </option>

                        <% }); %>

                    <% } %>

                </select>

            </div>


            <!-- MEDICINE -->
            <div class="form-group">

                <label for="medicine">
                    Medicine
                    <span class="required">*</span>
                </label>

                <input
                    type="text"
                    id="medicine"
                    name="medicine"
                    class="form-control"
                    placeholder="Enter medicine name"
                    maxlength="200"
                    required
                >

            </div>


            <!-- DOSAGE -->
            <div class="form-group">

                <label for="dosage">
                    Dosage
                    <span class="required">*</span>
                </label>

                <input
                    type="text"
                    id="dosage"
                    name="dosage"
                    class="form-control"
                    placeholder="Example: 1 tablet twice daily after meals"
                    maxlength="200"
                    required
                >

            </div>


            <!-- NOTES -->
            <div class="form-group">

                <label for="notes">
                    Notes
                </label>

                <textarea
                    id="notes"
                    name="notes"
                    class="form-control"
                    placeholder="Additional instructions for the patient..."
                    maxlength="1000"
                ></textarea>

            </div>


            <!-- ACTIONS -->
            <div class="form-actions">

                <a
                    href="/doctor/prescriptions"
                    class="btn cancel-btn"
                >
                    Cancel
                </a>

                <button
                    type="submit"
                    class="btn submit-btn"
                    <%= (!patients || patients.length === 0) ? "disabled" : "" %>
                >
                    <i class="fas fa-prescription-bottle-medical"></i>
                    Create Prescription
                </button>

            </div>

        </form>

    </div>

</div>


<%- include("../../layouts/footer") %>