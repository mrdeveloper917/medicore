<%- include("../../layouts/doctorHeader", { title: "Edit Experience", user }) %>

<style>
    /* =========================================
       EDIT EXPERIENCE PAGE
    ========================================= */

    .experience-form-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 28px;
    }

    /* ---------- Page Header ---------- */

    .form-page-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
    }

    .form-page-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #e8f3ff, #dceeff);
        color: #1976d2;
        font-size: 22px;
    }

    .form-page-header h2 {
        margin: 0 0 5px;
        font-size: 26px;
        font-weight: 700;
        color: #172033;
    }

    .form-page-header p {
        margin: 0;
        color: #7b8497;
        font-size: 14px;
    }

    /* ---------- Main Card ---------- */

    .experience-form-card {
        background: #fff;
        border: 1px solid #e9edf3;
        border-radius: 18px;
        box-shadow: 0 7px 25px rgba(20, 34, 56, 0.06);
        overflow: hidden;
    }

    .form-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 22px 25px;
        border-bottom: 1px solid #edf0f4;
        background: #fcfdff;
    }

    .form-card-heading {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .small-card-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef6ff;
        color: #1976d2;
        font-size: 15px;
    }

    .form-card-top h3 {
        margin: 0 0 4px;
        color: #20293a;
        font-size: 17px;
        font-weight: 700;
    }

    .form-card-top p {
        margin: 0;
        color: #8992a3;
        font-size: 13px;
    }

    .editing-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        border-radius: 20px;
        background: #f0f7ff;
        color: #1976d2;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

    .editing-badge i {
        font-size: 10px;
    }

    /* ---------- Form ---------- */

    .experience-form {
        padding: 28px 25px;
    }

    /* ---------- Error ---------- */

    .form-errors {
        margin-bottom: 24px;
        padding: 15px 17px;
        border: 1px solid #ffd5d5;
        border-radius: 11px;
        background: #fff5f5;
        color: #c62828;
    }

    .form-errors-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 700;
    }

    .form-errors ul {
        margin: 0;
        padding-left: 25px;
    }

    .form-errors li {
        margin: 4px 0;
        font-size: 13px;
    }

    /* ---------- Form Grid ---------- */

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
    }

    .form-group {
        margin-bottom: 0;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        color: #30394a;
        font-size: 13px;
        font-weight: 600;
    }

    .required {
        color: #e53935;
    }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #9aa5b6;
        font-size: 14px;
        pointer-events: none;
        transition: color 0.2s ease;
    }

    .form-control-custom {
        width: 100%;
        height: 46px;
        padding: 0 14px 0 42px;
        border: 1px solid #dfe4eb;
        border-radius: 10px;
        background: #fff;
        color: #273143;
        font-family: inherit;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

    .form-control-custom:hover {
        border-color: #c7d1df;
    }

    .form-control-custom:focus {
        border-color: #1976d2;
        box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.10);
    }

    .input-wrapper:focus-within .input-icon {
        color: #1976d2;
    }

    /* ---------- Current Job ---------- */

    .current-job-box {
        grid-column: 1 / -1;
        margin-top: 2px;
        padding: 16px 18px;
        border: 1px solid #e4ebf3;
        border-radius: 12px;
        background: #f8fbff;
        transition: all 0.2s ease;
    }

    .current-job-box.active {
        border-color: #cfe2f7;
        background: #f4f9ff;
    }

    .current-job-content {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .current-checkbox {
        width: 20px;
        height: 20px;
        margin: 0;
        accent-color: #1976d2;
        cursor: pointer;
        flex-shrink: 0;
    }

    .current-job-text {
        cursor: pointer;
        user-select: none;
    }

    .current-job-title {
        display: block;
        margin-bottom: 3px;
        color: #293447;
        font-size: 14px;
        font-weight: 600;
    }

    .current-job-description {
        display: block;
        color: #8993a4;
        font-size: 12px;
    }

    /* ---------- End Date ---------- */

    .end-date-hidden {
        display: none;
    }

    .helper-text {
        margin-top: 7px;
        color: #9099a9;
        font-size: 11px;
    }

    /* ---------- Buttons ---------- */

    .form-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 30px;
        padding-top: 22px;
        border-top: 1px solid #edf0f4;
    }

    .action-left,
    .action-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .back-btn,
    .update-btn {
        min-height: 42px;
        padding: 0 18px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .back-btn {
        color: #626d7f;
        background: #f5f6f8;
        border: 1px solid #e5e8ed;
    }

    .back-btn:hover {
        color: #303a4c;
        background: #eceef2;
    }

    .update-btn {
        color: #fff;
        background: #1976d2;
        border: 1px solid #1976d2;
        box-shadow: 0 6px 16px rgba(25, 118, 210, 0.20);
    }

    .update-btn:hover {
        background: #1565c0;
        border-color: #1565c0;
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(25, 118, 210, 0.27);
    }

    /* ---------- Info ---------- */

    .experience-tip {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-top: 20px;
        padding: 15px 17px;
        border-radius: 12px;
        background: #f8f9fc;
        border: 1px solid #edf0f4;
    }

    .tip-icon {
        color: #1976d2;
        font-size: 15px;
        margin-top: 2px;
    }

    .experience-tip p {
        margin: 0;
        color: #7d8798;
        font-size: 12px;
        line-height: 1.6;
    }

    .experience-tip strong {
        color: #4d586b;
    }

    /* ---------- Responsive ---------- */

    @media (max-width: 700px) {

        .experience-form-page {
            padding: 20px 14px;
        }

        .form-page-header h2 {
            font-size: 21px;
        }

        .form-page-header p {
            font-size: 12px;
        }

        .form-page-icon {
            width: 44px;
            height: 44px;
            border-radius: 11px;
            font-size: 18px;
        }

        .form-card-top {
            padding: 18px;
        }

        .form-card-top p {
            display: none;
        }

        .experience-form {
            padding: 22px 18px;
        }

        .form-grid {
            grid-template-columns: 1fr;
            gap: 19px;
        }

        .form-group.full-width,
        .current-job-box {
            grid-column: auto;
        }

        .editing-badge {
            display: none;
        }

        .form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .action-left,
        .action-right {
            width: 100%;
        }

        .back-btn,
        .update-btn {
            width: 100%;
        }

        .current-job-content {
            align-items: flex-start;
        }

        .current-checkbox {
            margin-top: 2px;
        }
    }
</style>


<div class="page-content experience-form-page">

    <!-- ================= PAGE HEADER ================= -->

    <div class="form-page-header">

        <div class="form-page-icon">
            <i class="fa-solid fa-pen-to-square"></i>
        </div>

        <div>
            <h2>Edit Experience</h2>
            <p>Update your professional work history</p>
        </div>

    </div>


    <!-- ================= MAIN CARD ================= -->

    <div class="experience-form-card">

        <div class="form-card-top">

            <div class="form-card-heading">

                <div class="small-card-icon">
                    <i class="fa-solid fa-hospital"></i>
                </div>

                <div>
                    <h3>Professional Experience</h3>
                    <p>Update the details of your position below.</p>
                </div>

            </div>

            <div class="editing-badge">
                <i class="fa-solid fa-pen"></i>
                Editing Experience
            </div>

        </div>


        <form
            action="/doctor/experience/update/<%= experience._id %>"
            method="POST"
            class="experience-form"
        >

            <!-- ================= ERRORS ================= -->

            <% if (errors && errors.length) { %>

                <div class="form-errors">

                    <div class="form-errors-title">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        Please fix the following errors
                    </div>

                    <ul>

                        <% errors.forEach(error => { %>

                            <li>
                                <%= error.msg %>
                            </li>

                        <% }) %>

                    </ul>

                </div>

            <% } %>


            <% if (typeof error !== "undefined" && error) { %>

                <div class="form-errors">

                    <div class="form-errors-title">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        Something went wrong
                    </div>

                    <div style="font-size:13px;">
                        <%= error %>
                    </div>

                </div>

            <% } %>


            <!-- ================= FORM FIELDS ================= -->

            <div class="form-grid">


                <!-- Hospital -->

                <div class="form-group full-width">

                    <label
                        class="form-label"
                        for="hospital"
                    >
                        Hospital / Organization
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-solid fa-hospital input-icon"></i>

                        <input
                            type="text"
                            id="hospital"
                            name="hospital"
                            class="form-control-custom"
                            value="<%= experience.hospital || '' %>"
                            placeholder="e.g. City Hospital, Apollo Hospital"
                            required
                        >

                    </div>

                </div>


                <!-- Position -->

                <div class="form-group">

                    <label
                        class="form-label"
                        for="position"
                    >
                        Position / Designation
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-solid fa-user-doctor input-icon"></i>

                        <input
                            type="text"
                            id="position"
                            name="position"
                            class="form-control-custom"
                            value="<%= experience.position || '' %>"
                            placeholder="e.g. Senior Cardiologist"
                            required
                        >

                    </div>

                </div>


                <!-- Start Date -->

                <div class="form-group">

                    <label
                        class="form-label"
                        for="startDate"
                    >
                        Start Date
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-regular fa-calendar input-icon"></i>

                        <input
                            type="date"
                            id="startDate"
                            name="startDate"
                            class="form-control-custom"
                            value="<%= experience.startDate
                                ? new Date(experience.startDate).toISOString().split('T')[0]
                                : '' %>"
                            required
                        >

                    </div>

                </div>


                <!-- End Date -->

                <div
                    class="form-group"
                    id="endDateGroup"
                >

                    <label
                        class="form-label"
                        for="endDate"
                    >
                        End Date
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-regular fa-calendar-check input-icon"></i>

                        <input
                            type="date"
                            id="endDate"
                            name="endDate"
                            class="form-control-custom"
                            value="<%= experience.endDate
                                ? new Date(experience.endDate).toISOString().split('T')[0]
                                : '' %>"
                        >

                    </div>

                    <div class="helper-text">
                        Not required for your current position.
                    </div>

                </div>


                <!-- Current Job -->

                <div
                    class="current-job-box"
                    id="currentJobBox"
                >

                    <div class="current-job-content">

                        <input
                            type="checkbox"
                            name="current"
                            id="currentJob"
                            class="current-checkbox"
                            <%= experience.current ? "checked" : "" %>
                        >

                        <label
                            for="currentJob"
                            class="current-job-text"
                        >

                            <span class="current-job-title">
                                I currently work here
                            </span>

                            <span class="current-job-description">
                                Select this if this is your current hospital or organization.
                            </span>

                        </label>

                    </div>

                </div>

            </div>


            <!-- ================= ACTION BUTTONS ================= -->

            <div class="form-actions">

                <div class="action-left">

                    <a
                        href="/doctor/experience"
                        class="back-btn"
                    >
                        <i class="fa-solid fa-arrow-left"></i>
                        Back to Experience
                    </a>

                </div>


                <div class="action-right">

                    <button
                        type="submit"
                        class="update-btn"
                    >
                        <i class="fa-solid fa-check"></i>
                        Update Experience
                    </button>

                </div>

            </div>

        </form>

    </div>


    <!-- ================= PROFILE TIP ================= -->

    <div class="experience-tip">

        <div class="tip-icon">
            <i class="fa-solid fa-circle-info"></i>
        </div>

        <p>
            <strong>Profile tip:</strong>
            Keep your experience information accurate and up to date.
            This helps patients understand your professional background
            and expertise.
        </p>

    </div>

</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const currentJob = document.getElementById("currentJob");
        const endDateGroup = document.getElementById("endDateGroup");
        const endDate = document.getElementById("endDate");
        const currentJobBox = document.getElementById("currentJobBox");

        if (!currentJob || !endDateGroup || !endDate) {
            return;
        }


        function toggleEndDate() {

            if (currentJob.checked) {

                /*
                 * Current job:
                 * Hide end date and clear its value.
                 */

                endDateGroup.classList.add("end-date-hidden");

                endDate.value = "";

                endDate.removeAttribute("required");

                if (currentJobBox) {
                    currentJobBox.classList.add("active");
                }

            } else {

                /*
                 * Previous job:
                 * Show end date.
                 */

                endDateGroup.classList.remove("end-date-hidden");

                if (currentJobBox) {
                    currentJobBox.classList.remove("active");
                }

            }
        }


        /* Initial state */

        toggleEndDate();


        /* Toggle when checkbox changes */

        currentJob.addEventListener(
            "change",
            toggleEndDate
        );

    });
</script>


<%- include("../../layouts/doctorFooter") %>
