<%- include("../../layouts/doctorHeader") %>

<style>
    /* =========================================
       ADD EXPERIENCE PAGE
    ========================================= */

    .experience-form-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 28px;
    }

    /* ---------- Page Header ---------- */

    .form-page-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 25px;
    }

    .form-page-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #e8f3ff, #dceeff);
        color: #1976d2;
        font-size: 22px;
    }

    .form-page-header h2 {
        margin: 0 0 5px;
        font-size: 26px;
        font-weight: 700;
        color: #172033;
    }

    .form-page-header p {
        margin: 0;
        color: #7b8497;
        font-size: 14px;
    }

    /* ---------- Main Card ---------- */

    .experience-form-card {
        background: #fff;
        border: 1px solid #e9edf3;
        border-radius: 18px;
        box-shadow: 0 7px 25px rgba(20, 34, 56, 0.06);
        overflow: hidden;
    }

    .form-card-top {
        padding: 22px 25px;
        border-bottom: 1px solid #edf0f4;
        background: #fcfdff;
    }

    .form-card-top h3 {
        margin: 0 0 5px;
        color: #20293a;
        font-size: 17px;
        font-weight: 700;
    }

    .form-card-top p {
        margin: 0;
        color: #8992a3;
        font-size: 13px;
    }

    .experience-form {
        padding: 28px 25px;
    }

    /* ---------- Error ---------- */

    .form-errors {
        margin-bottom: 24px;
        padding: 15px 17px;
        border: 1px solid #ffd5d5;
        border-radius: 11px;
        background: #fff5f5;
        color: #c62828;
    }

    .form-errors-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        font-size: 14px;
        font-weight: 700;
    }

    .form-errors ul {
        margin: 0;
        padding-left: 25px;
    }

    .form-errors li {
        margin: 4px 0;
        font-size: 13px;
    }

    /* ---------- Form Grid ---------- */

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
    }

    .form-group {
        margin-bottom: 0;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        color: #30394a;
        font-size: 13px;
        font-weight: 600;
    }

    .required {
        color: #e53935;
    }

    .input-wrapper {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #9aa5b6;
        font-size: 14px;
        pointer-events: none;
        transition: color 0.2s ease;
    }

    .form-control-custom {
        width: 100%;
        height: 46px;
        padding: 0 14px 0 42px;
        border: 1px solid #dfe4eb;
        border-radius: 10px;
        background: #fff;
        color: #273143;
        font-family: inherit;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

    .form-control-custom::placeholder {
        color: #a8afbb;
    }

    .form-control-custom:hover {
        border-color: #c7d1df;
    }

    .form-control-custom:focus {
        border-color: #1976d2;
        box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.10);
    }

    .input-wrapper:focus-within .input-icon {
        color: #1976d2;
    }

    /* Date Input */

    input[type="date"].form-control-custom {
        padding-right: 12px;
    }

    /* ---------- Current Job ---------- */

    .current-job-box {
        grid-column: 1 / -1;
        margin-top: 2px;
        padding: 16px 18px;
        border: 1px solid #e4ebf3;
        border-radius: 12px;
        background: #f8fbff;
        transition: all 0.2s ease;
    }

    .current-job-box:hover {
        border-color: #cfe2f7;
        background: #f5faff;
    }

    .current-job-content {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .current-checkbox {
        width: 20px;
        height: 20px;
        margin: 0;
        accent-color: #1976d2;
        cursor: pointer;
    }

    .current-job-text {
        cursor: pointer;
        user-select: none;
    }

    .current-job-title {
        display: block;
        margin-bottom: 3px;
        color: #293447;
        font-size: 14px;
        font-weight: 600;
    }

    .current-job-description {
        display: block;
        color: #8993a4;
        font-size: 12px;
    }

    /* ---------- End Date Disabled ---------- */

    .form-control-custom.disabled-field {
        background: #f5f6f8;
        color: #9aa1ad;
        cursor: not-allowed;
    }

    /* ---------- Helper Text ---------- */

    .helper-text {
        margin-top: 7px;
        color: #9099a9;
        font-size: 11px;
    }

    /* ---------- Buttons ---------- */

    .form-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 30px;
        padding-top: 22px;
        border-top: 1px solid #edf0f4;
    }

    .back-btn,
    .save-btn {
        min-height: 42px;
        padding: 0 18px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .back-btn {
        color: #626d7f;
        background: #f5f6f8;
        border: 1px solid #e5e8ed;
    }

    .back-btn:hover {
        color: #303a4c;
        background: #eceef2;
    }

    .save-btn {
        color: #fff;
        background: #1976d2;
        border: 1px solid #1976d2;
        box-shadow: 0 6px 16px rgba(25, 118, 210, 0.20);
    }

    .save-btn:hover {
        background: #1565c0;
        border-color: #1565c0;
        transform: translateY(-1px);
        box-shadow: 0 8px 20px rgba(25, 118, 210, 0.27);
    }

    /* ---------- Tips ---------- */

    .experience-tip {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        margin-top: 20px;
        padding: 15px 17px;
        border-radius: 12px;
        background: #f8f9fc;
        border: 1px solid #edf0f4;
    }

    .tip-icon {
        color: #1976d2;
        font-size: 15px;
        margin-top: 2px;
    }

    .experience-tip p {
        margin: 0;
        color: #7d8798;
        font-size: 12px;
        line-height: 1.6;
    }

    .experience-tip strong {
        color: #4d586b;
    }

    /* ---------- Responsive ---------- */

    @media (max-width: 700px) {

        .experience-form-page {
            padding: 20px 14px;
        }

        .form-page-header h2 {
            font-size: 21px;
        }

        .form-page-header p {
            font-size: 12px;
        }

        .form-page-icon {
            width: 44px;
            height: 44px;
            border-radius: 11px;
            font-size: 18px;
        }

        .form-card-top {
            padding: 18px;
        }

        .experience-form {
            padding: 22px 18px;
        }

        .form-grid {
            grid-template-columns: 1fr;
            gap: 19px;
        }

        .form-group.full-width,
        .current-job-box {
            grid-column: auto;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .back-btn,
        .save-btn {
            width: 100%;
        }

        .current-job-content {
            align-items: flex-start;
        }

        .current-checkbox {
            margin-top: 2px;
        }
    }
</style>


<div class="page-content experience-form-page">

    <!-- ================= PAGE HEADER ================= -->

    <div class="form-page-header">

        <div class="form-page-icon">
            <i class="fa-solid fa-briefcase-medical"></i>
        </div>

        <div>
            <h2>Add Experience</h2>
            <p>Add your professional hospital or healthcare experience</p>
        </div>

    </div>


    <!-- ================= FORM CARD ================= -->

    <div class="experience-form-card">

        <div class="form-card-top">
            <h3>Professional Experience</h3>
            <p>Enter accurate details about your previous or current position.</p>
        </div>


        <form
            action="/doctor/experience/add"
            method="POST"
            class="experience-form"
        >

            <!-- ================= ERRORS ================= -->

            <% if (errors && errors.length) { %>

                <div class="form-errors">

                    <div class="form-errors-title">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        Please fix the following errors
                    </div>

                    <ul>
                        <% errors.forEach(error => { %>

                            <li>
                                <%= error.msg %>
                            </li>

                        <% }) %>
                    </ul>

                </div>

            <% } %>


            <% if (typeof error !== "undefined" && error) { %>

                <div class="form-errors">

                    <div class="form-errors-title">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        Something went wrong
                    </div>

                    <div style="font-size:13px;">
                        <%= error %>
                    </div>

                </div>

            <% } %>


            <!-- ================= FORM FIELDS ================= -->

            <div class="form-grid">


                <!-- Hospital -->

                <div class="form-group full-width">

                    <label class="form-label" for="hospital">
                        Hospital / Organization
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-solid fa-hospital input-icon"></i>

                        <input
                            type="text"
                            id="hospital"
                            name="hospital"
                            class="form-control-custom"
                            placeholder="e.g. City Hospital, Apollo Hospital"
                            value="<%= old && old.hospital ? old.hospital : '' %>"
                            required
                        >

                    </div>

                </div>


                <!-- Position -->

                <div class="form-group">

                    <label class="form-label" for="position">
                        Position / Designation
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-solid fa-user-doctor input-icon"></i>

                        <input
                            type="text"
                            id="position"
                            name="position"
                            class="form-control-custom"
                            placeholder="e.g. Senior Cardiologist"
                            value="<%= old && old.position ? old.position : '' %>"
                            required
                        >

                    </div>

                </div>


                <!-- Start Date -->

                <div class="form-group">

                    <label class="form-label" for="startDate">
                        Start Date
                        <span class="required">*</span>
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-regular fa-calendar input-icon"></i>

                        <input
                            type="date"
                            id="startDate"
                            name="startDate"
                            class="form-control-custom"
                            value="<%= old && old.startDate ? old.startDate : '' %>"
                            required
                        >

                    </div>

                </div>


                <!-- End Date -->

                <div class="form-group">

                    <label class="form-label" for="endDate">
                        End Date
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-regular fa-calendar-check input-icon"></i>

                        <input
                            type="date"
                            id="endDate"
                            name="endDate"
                            class="form-control-custom"
                            value="<%= old && old.endDate ? old.endDate : '' %>"
                        >

                    </div>

                    <div class="helper-text">
                        Leave empty if this is your current position.
                    </div>

                </div>


                <!-- Current Job -->

                <div class="current-job-box">

                    <div class="current-job-content">

                        <input
                            type="checkbox"
                            name="current"
                            id="currentJob"
                            class="current-checkbox"
                            <%= old && old.current ? "checked" : "" %>
                        >

                        <label
                            for="currentJob"
                            class="current-job-text"
                        >
                            <span class="current-job-title">
                                I currently work here
                            </span>

                            <span class="current-job-description">
                                Select this if you are still working at this hospital or organization.
                            </span>
                        </label>

                    </div>

                </div>

            </div>


            <!-- ================= ACTIONS ================= -->

            <div class="form-actions">

                <a
                    href="/doctor/experience"
                    class="back-btn"
                >
                    <i class="fa-solid fa-arrow-left"></i>
                    Back to Experience
                </a>


                <button
                    type="submit"
                    class="save-btn"
                >
                    <i class="fa-solid fa-check"></i>
                    Save Experience
                </button>

            </div>

        </form>

    </div>


    <!-- ================= TIP ================= -->

    <div class="experience-tip">

        <div class="tip-icon">
            <i class="fa-solid fa-circle-info"></i>
        </div>

        <p>
            <strong>Profile tip:</strong>
            Keeping your professional experience up to date helps patients
            understand your expertise and builds trust in your MediCore profile.
        </p>

    </div>

</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const currentJob = document.getElementById("currentJob");
        const endDate = document.getElementById("endDate");

        if (!currentJob || !endDate) return;


        function updateEndDate() {

            if (currentJob.checked) {

                endDate.value = "";
                endDate.disabled = true;
                endDate.classList.add("disabled-field");

            } else {

                endDate.disabled = false;
                endDate.classList.remove("disabled-field");

            }

        }


        currentJob.addEventListener("change", updateEndDate);

        updateEndDate();

    });
</script>


<%- include("../../layouts/footer") %>