<%- include("../layouts/patientHeader", {
title: "My Medical Reports",
user: user
}) %>

<div class="reports-page">


<div class="reports-container">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <section class="reports-hero">

        <div class="hero-left">

            <a href="/patient/dashboard" class="back-link">
                <i class="fa-solid fa-arrow-left"></i>
                Back to Dashboard
            </a>

            <div class="hero-title-row">

                <div class="hero-icon">
                    <i class="fa-solid fa-file-medical"></i>
                </div>

                <div>
                    <h1>My Medical Reports</h1>

                    <p>
                        Securely view and download your medical
                        reports and health documents.
                    </p>
                </div>

            </div>

        </div>


        <div class="secure-badge">

            <div class="secure-icon">
                <i class="fa-solid fa-shield-heart"></i>
            </div>

            <div>
                <strong>Private & Secure</strong>
                <span>Your health records are protected</span>
            </div>

        </div>

    </section>


    <!-- =====================================================
         SUMMARY
    ====================================================== -->

    <section class="summary-grid">

        <div class="summary-card">

            <div class="summary-icon">
                <i class="fa-solid fa-folder-open"></i>
            </div>

            <div class="summary-content">

                <span>Available Reports</span>

                <strong>
                    <%= reports ? reports.length : 0 %>
                </strong>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon green">
                <i class="fa-solid fa-lock"></i>
            </div>

            <div class="summary-content">

                <span>Access</span>

                <strong class="summary-text">
                    Protected
                </strong>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon purple">
                <i class="fa-solid fa-cloud-arrow-down"></i>
            </div>

            <div class="summary-content">

                <span>Available Action</span>

                <strong class="summary-text">
                    Download
                </strong>

            </div>

        </div>

    </section>


    <!-- =====================================================
         SEARCH
    ====================================================== -->

    <% if (reports && reports.length > 0) { %>

        <section class="search-section">

            <div class="search-header">

                <div>

                    <h2>
                        <i class="fa-solid fa-file-medical"></i>
                        Your Reports
                    </h2>

                    <p>
                        Search through your medical documents.
                    </p>

                </div>

            </div>


            <div class="search-box">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input
                    type="text"
                    id="reportSearch"
                    placeholder="Search by report title or description..."
                    autocomplete="off"
                >

                <button
                    type="button"
                    id="clearSearch"
                    class="clear-search"
                    aria-label="Clear search"
                >
                    <i class="fa-solid fa-xmark"></i>
                </button>

            </div>

        </section>

    <% } %>


    <!-- =====================================================
         EMPTY STATE
    ====================================================== -->

    <% if (!reports || reports.length === 0) { %>

        <section class="empty-reports">

            <div class="empty-visual">

                <div class="floating-icon floating-one">
                    <i class="fa-solid fa-file-medical"></i>
                </div>

                <div class="floating-icon floating-two">
                    <i class="fa-solid fa-heart-pulse"></i>
                </div>

                <div class="empty-icon">
                    <i class="fa-solid fa-folder-open"></i>
                </div>

            </div>


            <span class="empty-label">
                <i class="fa-solid fa-circle-info"></i>
                No records available
            </span>


            <h2>No Medical Reports Yet</h2>


            <p>
                Your medical reports will appear here when they
                are added to your account by the healthcare team.
            </p>


            <a
                href="/patient/dashboard"
                class="primary-btn"
            >
                <i class="fa-solid fa-house"></i>
                Back to Dashboard
            </a>

        </section>


    <% } else { %>


        <!-- =====================================================
             REPORT GRID
        ====================================================== -->

        <section
            class="reports-grid"
            id="reportsContainer"
        >

            <% reports.forEach((report, index) => { %>

                <article
                    class="report-item"
                    data-title="<%= (report.title || '').toLowerCase() %>"
                    data-description="<%= (report.description || '').toLowerCase() %>"
                >

                    <div class="report-card">


                        <!-- CARD HEADER -->
                        <div class="report-card-header">

                            <div class="report-type-icon">
                                <i class="fa-solid fa-file-medical"></i>
                            </div>


                            <div class="report-index">
                                #<%= String(index + 1).padStart(2, "0") %>
                            </div>

                        </div>


                        <!-- CARD BODY -->
                        <div class="report-card-body">

                            <div class="report-label">
                                <i class="fa-solid fa-file-lines"></i>
                                Medical Document
                            </div>


                            <h2 class="report-title">
                                <%= report.title || "Medical Report" %>
                            </h2>


                            <!-- DATE -->

                            <div class="report-date">

                                <span class="date-icon">
                                    <i class="fa-regular fa-calendar-days"></i>
                                </span>

                                <div>
                                    <small>Report Date</small>

                                    <strong>
                                        <%= report.reportDate
                                            ? new Date(
                                                report.reportDate
                                            ).toLocaleDateString(
                                                "en-IN",
                                                {
                                                    day: "2-digit",
                                                    month: "short",
                                                    year: "numeric"
                                                }
                                            )
                                            : "Date not available"
                                        %>
                                    </strong>
                                </div>

                            </div>


                            <!-- DESCRIPTION -->

                            <% if (report.description) { %>

                                <div class="report-description">

                                    <div class="description-icon">
                                        <i class="fa-solid fa-align-left"></i>
                                    </div>

                                    <div>

                                        <span>Description</span>

                                        <p>
                                            <%= report.description %>
                                        </p>

                                    </div>

                                </div>

                            <% } %>


                            <!-- FILE -->

                            <% if (report.file) { %>

                                <div class="file-preview">

                                    <div class="file-icon">
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </div>


                                    <div class="file-info">

                                        <span>Attached Document</span>

                                        <strong>
                                            <%= report.file
                                                .split("/")
                                                .pop()
                                                .split("\\")
                                                .pop()
                                            %>
                                        </strong>

                                    </div>


                                    <div class="file-status">
                                        <i class="fa-solid fa-check"></i>
                                    </div>

                                </div>

                            <% } %>

                        </div>


                        <!-- CARD FOOTER -->

                        <% if (report._id && report.file) { %>

                            <div class="report-card-footer">

                                <a
                                    href="/patient/reports/<%= report._id %>/download"
                                    class="download-btn"
                                >

                                    <span>
                                        <i class="fa-solid fa-download"></i>
                                        Download Report
                                    </span>

                                    <i class="fa-solid fa-arrow-right"></i>

                                </a>

                            </div>

                        <% } %>


                    </div>

                </article>

            <% }); %>

        </section>


        <!-- =====================================================
             NO SEARCH RESULT
        ====================================================== -->

        <section
            id="noSearchResult"
            class="no-search-result"
        >

            <div class="no-result-icon">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>

            <h2>No Reports Found</h2>

            <p>
                We couldn't find any report matching your search.
                Try a different keyword.
            </p>

            <button
                type="button"
                id="resetSearch"
                class="reset-btn"
            >
                <i class="fa-solid fa-rotate-left"></i>
                Clear Search
            </button>

        </section>

    <% } %>


</div>


</div>

<style>

/* =========================================================
   MEDICORE REPORTS
========================================================= */

.reports-page {

    --primary: #0f766e;
    --primary-dark: #115e59;
    --primary-light: #14b8a6;
    --primary-soft: #ecfdf5;

    --blue: #2563eb;
    --blue-soft: #eff6ff;

    --purple: #7c3aed;
    --purple-soft: #f5f3ff;

    --text: #0f172a;
    --text-secondary: #475569;
    --muted: #94a3b8;

    --border: #e2e8f0;
    --background: #f8fafc;

    min-height: calc(100vh - 80px);

    padding: 32px 20px 70px;

    background:
        radial-gradient(
            circle at 5% 5%,
            rgba(20, 184, 166, 0.06),
            transparent 28%
        ),
        #f8fafc;
}


.reports-container {

    width: 100%;
    max-width: 1180px;

    margin: 0 auto;
}


/* =========================================================
   HERO
========================================================= */

.reports-hero {

    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 25px;

    padding: 30px;

    margin-bottom: 22px;

    border-radius: 24px;

    background:
        radial-gradient(
            circle at 90% 15%,
            rgba(20, 184, 166, 0.15),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #ffffff,
            #f0fdfa
        );

    border: 1px solid #ccfbf1;

    box-shadow:
        0 15px 40px rgba(15, 118, 110, 0.07);
}


.back-link {

    display: inline-flex;

    align-items: center;

    gap: 8px;

    margin-bottom: 18px;

    color: var(--primary);

    text-decoration: none;

    font-size: 13px;

    font-weight: 700;

    transition: .2s ease;
}


.back-link:hover {

    color: var(--primary-dark);

    transform: translateX(-3px);
}


.hero-title-row {

    display: flex;

    align-items: center;

    gap: 16px;
}


.hero-icon {

    width: 60px;
    height: 60px;

    flex-shrink: 0;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 18px;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--primary-light)
        );

    color: #fff;

    font-size: 24px;

    box-shadow:
        0 10px 25px rgba(15, 118, 110, .20);
}


.hero-title-row h1 {

    margin: 0 0 5px;

    color: var(--text);

    font-size: 30px;

    font-weight: 800;

    letter-spacing: -.6px;
}


.hero-title-row p {

    margin: 0;

    max-width: 560px;

    color: var(--text-secondary);

    font-size: 13px;

    line-height: 1.6;
}


/* =========================================================
   SECURITY BADGE
========================================================= */

.secure-badge {

    display: flex;

    align-items: center;

    gap: 11px;

    padding: 12px 15px;

    border-radius: 15px;

    background: rgba(255,255,255,.9);

    border: 1px solid #bbf7d0;

    box-shadow:
        0 7px 20px rgba(15,23,42,.04);
}


.secure-icon {

    width: 39px;
    height: 39px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 11px;

    background: #dcfce7;

    color: #15803d;
}


.secure-badge strong {

    display: block;

    margin-bottom: 2px;

    color: #166534;

    font-size: 12px;
}


.secure-badge span {

    display: block;

    color: #65a30d;

    font-size: 10px;
}


/* =========================================================
   SUMMARY
========================================================= */

.summary-grid {

    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 15px;

    margin-bottom: 22px;
}


.summary-card {

    display: flex;

    align-items: center;

    gap: 13px;

    padding: 17px;

    background: #fff;

    border: 1px solid var(--border);

    border-radius: 17px;

    box-shadow:
        0 7px 25px rgba(15,23,42,.045);
}


.summary-icon {

    width: 46px;
    height: 46px;

    flex-shrink: 0;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 13px;

    background: var(--blue-soft);

    color: var(--blue);

    font-size: 17px;
}


.summary-icon.green {

    background: var(--primary-soft);

    color: var(--primary);
}


.summary-icon.purple {

    background: var(--purple-soft);

    color: var(--purple);
}


.summary-content span {

    display: block;

    margin-bottom: 3px;

    color: var(--muted);

    font-size: 10px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: .45px;
}


.summary-content strong {

    color: var(--text);

    font-size: 20px;

    font-weight: 800;
}


.summary-text {

    font-size: 13px !important;
}


/* =========================================================
   SEARCH
========================================================= */

.search-section {

    margin-bottom: 22px;

    padding: 20px;

    background: #fff;

    border: 1px solid var(--border);

    border-radius: 18px;

    box-shadow:
        0 7px 25px rgba(15,23,42,.04);
}


.search-header {

    margin-bottom: 13px;
}


.search-header h2 {

    margin: 0 0 4px;

    color: var(--text);

    font-size: 15px;

    font-weight: 800;
}


.search-header h2 i {

    margin-right: 6px;

    color: var(--primary);
}


.search-header p {

    margin: 0;

    color: var(--muted);

    font-size: 11px;
}


.search-box {

    position: relative;
}


.search-box > i {

    position: absolute;

    left: 16px;
    top: 50%;

    transform: translateY(-50%);

    color: var(--muted);

    font-size: 14px;

    pointer-events: none;
}


.search-box input {

    width: 100%;

    height: 47px;

    padding: 0 45px;

    border: 1px solid #dbe3ec;

    border-radius: 12px;

    outline: none;

    background: #f8fafc;

    color: var(--text);

    font-size: 13px;

    transition: .2s ease;
}


.search-box input:focus {

    background: #fff;

    border-color: var(--primary-light);

    box-shadow:
        0 0 0 4px rgba(20,184,166,.10);
}


.search-box input::placeholder {

    color: #a0aaba;
}


.clear-search {

    position: absolute;

    right: 9px;
    top: 50%;

    transform: translateY(-50%);

    width: 30px;
    height: 30px;

    display: none;

    align-items: center;
    justify-content: center;

    border: 0;

    border-radius: 8px;

    background: #e2e8f0;

    color: #64748b;

    cursor: pointer;
}


.clear-search.show {

    display: flex;
}


.clear-search:hover {

    background: #cbd5e1;

    color: var(--text);
}


/* =========================================================
   REPORT GRID
========================================================= */

.reports-grid {

    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 18px;
}


.report-item {

    min-width: 0;
}


.report-card {

    height: 100%;

    display: flex;

    flex-direction: column;

    overflow: hidden;

    background: #fff;

    border: 1px solid var(--border);

    border-radius: 20px;

    box-shadow:
        0 8px 28px rgba(15,23,42,.05);

    transition:
        transform .25s ease,
        box-shadow .25s ease,
        border-color .25s ease;
}


.report-card:hover {

    transform: translateY(-5px);

    border-color: #b7ebe4;

    box-shadow:
        0 18px 42px rgba(15,118,110,.10);
}


/* =========================================================
   CARD HEADER
========================================================= */

.report-card-header {

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 20px 20px 0;
}


.report-type-icon {

    width: 52px;
    height: 52px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 15px;

    background:
        linear-gradient(
            135deg,
            #ecfdf5,
            #eff6ff
        );

    color: var(--primary);

    font-size: 21px;
}


.report-index {

    display: inline-flex;

    align-items: center;
    justify-content: center;

    min-width: 40px;

    padding: 6px 9px;

    border-radius: 8px;

    background: #f8fafc;

    color: var(--muted);

    font-size: 10px;

    font-weight: 800;
}


/* =========================================================
   CARD BODY
========================================================= */

.report-card-body {

    flex: 1;

    padding: 18px 20px 20px;
}


.report-label {

    display: flex;

    align-items: center;

    gap: 6px;

    margin-bottom: 7px;

    color: var(--primary);

    font-size: 9px;

    font-weight: 800;

    text-transform: uppercase;

    letter-spacing: .55px;
}


.report-title {

    margin: 0 0 15px;

    color: var(--text);

    font-size: 17px;

    font-weight: 800;

    line-height: 1.4;

    word-break: break-word;
}


/* =========================================================
   DATE
========================================================= */

.report-date {

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 11px;

    margin-bottom: 13px;

    border-radius: 12px;

    background: #f8fafc;

    border: 1px solid #eef2f7;
}


.date-icon {

    width: 35px;
    height: 35px;

    flex-shrink: 0;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 9px;

    background: var(--blue-soft);

    color: var(--blue);

    font-size: 13px;
}


.report-date small {

    display: block;

    margin-bottom: 2px;

    color: var(--muted);

    font-size: 9px;

    font-weight: 700;

    text-transform: uppercase;

    letter-spacing: .3px;
}


.report-date strong {

    color: var(--text-secondary);

    font-size: 12px;
}


/* =========================================================
   DESCRIPTION
========================================================= */

.report-description {

    display: flex;

    align-items: flex-start;

    gap: 9px;

    padding: 12px;

    margin-bottom: 13px;

    border-radius: 12px;

    background: #fffbeb;

    border: 1px solid #fef3c7;
}


.description-icon {

    width: 28px;
    height: 28px;

    flex-shrink: 0;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 8px;

    background: #fef3c7;

    color: #d97706;

    font-size: 11px;
}


.report-description span {

    display: block;

    margin-bottom: 3px;

    color: #a16207;

    font-size: 9px;

    font-weight: 800;

    text-transform: uppercase;
}


.report-description p {

    margin: 0;

    color: #78716c;

    font-size: 11px;

    line-height: 1.6;

    word-break: break-word;
}


/* =========================================================
   FILE
========================================================= */

.file-preview {

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 11px;

    border: 1px dashed #cbd5e1;

    border-radius: 12px;

    background: #fafcff;
}


.file-icon {

    width: 37px;
    height: 37px;

    flex-shrink: 0;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 9px;

    background: #fee2e2;

    color: #dc2626;

    font-size: 14px;
}


.file-info {

    min-width: 0;

    flex: 1;
}


.file-info span {

    display: block;

    margin-bottom: 2px;

    color: var(--muted);

    font-size: 9px;
}


.file-info strong {

    display: block;

    overflow: hidden;

    color: var(--text-secondary);

    font-size: 10px;

    font-weight: 700;

    white-space: nowrap;

    text-overflow: ellipsis;
}


.file-status {

    width: 23px;
    height: 23px;

    flex-shrink: 0;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #dcfce7;

    color: #15803d;

    font-size: 9px;
}


/* =========================================================
   FOOTER
========================================================= */

.report-card-footer {

    padding: 0 20px 20px;
}


.download-btn {

    width: 100%;

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 10px;

    padding: 12px 14px;

    border-radius: 11px;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--primary-light)
        );

    color: #fff;

    text-decoration: none;

    font-size: 11px;

    font-weight: 800;

    box-shadow:
        0 7px 17px rgba(15,118,110,.15);

    transition: .2s ease;
}


.download-btn:hover {

    color: #fff;

    transform: translateY(-2px);

    box-shadow:
        0 11px 23px rgba(15,118,110,.22);
}


.download-btn span {

    display: inline-flex;

    align-items: center;

    gap: 7px;
}


/* =========================================================
   EMPTY STATE
========================================================= */

.empty-reports {

    position: relative;

    overflow: hidden;

    padding: 75px 25px;

    text-align: center;

    background: #fff;

    border: 1px solid var(--border);

    border-radius: 24px;

    box-shadow:
        0 10px 35px rgba(15,23,42,.05);
}


.empty-visual {

    position: relative;

    width: 105px;
    height: 105px;

    margin: 0 auto 18px;
}


.empty-icon {

    position: relative;

    z-index: 2;

    width: 78px;
    height: 78px;

    margin: 13px auto;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 23px;

    background:
        linear-gradient(
            135deg,
            #ccfbf1,
            #dbeafe
        );

    color: var(--primary);

    font-size: 30px;

    box-shadow:
        0 12px 27px rgba(15,118,110,.12);
}


.floating-icon {

    position: absolute;

    z-index: 3;

    width: 25px;
    height: 25px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 8px;

    font-size: 10px;
}


.floating-one {

    top: 0;
    right: 5px;

    background: #dbeafe;

    color: var(--blue);
}


.floating-two {

    bottom: 1px;
    left: 5px;

    background: #fce7f3;

    color: #db2777;
}


.empty-label {

    display: inline-flex;

    align-items: center;

    gap: 6px;

    padding: 6px 10px;

    margin-bottom: 9px;

    border-radius: 20px;

    background: var(--primary-soft);

    color: var(--primary);

    font-size: 9px;

    font-weight: 800;
}


.empty-reports h2 {

    margin: 0 0 8px;

    color: var(--text);

    font-size: 21px;

    font-weight: 800;
}


.empty-reports p {

    max-width: 470px;

    margin: 0 auto 23px;

    color: var(--text-secondary);

    font-size: 12px;

    line-height: 1.7;
}


.primary-btn {

    display: inline-flex;

    align-items: center;

    gap: 8px;

    padding: 11px 17px;

    border-radius: 11px;

    background:
        linear-gradient(
            135deg,
            var(--primary),
            var(--primary-light)
        );

    color: #fff;

