</style>

<script>

document.addEventListener("DOMContentLoaded", function () {

    const searchInput =
        document.getElementById("reportSearch");

    const reportItems =
        document.querySelectorAll(".report-item");

    const noSearchResult =
        document.getElementById("noSearchResult");

    const clearSearch =
        document.getElementById("clearSearch");

    const resetSearch =
        document.getElementById("resetSearch");


    if (!searchInput) {
        return;
    }


    function performSearch() {

        const searchValue =
            searchInput.value
                .trim()
                .toLowerCase();

        let visibleReports = 0;


        reportItems.forEach(function (item) {

            const title =
                item.dataset.title || "";

            const description =
                item.dataset.description || "";


            const matched =
                title.includes(searchValue) ||
                description.includes(searchValue);


            if (matched) {

                item.style.display = "";

                visibleReports++;

            } else {

                item.style.display = "none";

            }

        });


        if (clearSearch) {

            clearSearch.classList.toggle(
                "show",
                searchValue !== ""
            );

        }


        if (noSearchResult) {

            noSearchResult.classList.toggle(
                "show",
                searchValue !== "" &&
                visibleReports === 0
            );

        }

    }


    searchInput.addEventListener(
        "input",
        performSearch
    );


    if (clearSearch) {

        clearSearch.addEventListener(
            "click",
            function () {

                searchInput.value = "";

                performSearch();

                searchInput.focus();

            }
        );

    }


    if (resetSearch) {

        resetSearch.addEventListener(
            "click",
            function () {

                searchInput.value = "";

                performSearch();

                searchInput.focus();

            }
        );

    }

});

</script>

