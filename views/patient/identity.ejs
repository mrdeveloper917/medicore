<%- include("../layouts/patientHeader", { title: title, user: user }) %>

  <style>
    :root {
      --primary: #0f766e;
      --primary-dark: #115e59;
      --primary-light: #14b8a6;
      --primary-soft: #ecfdf5;
      --blue: #2563eb;
      --blue-soft: #eff6ff;
      --orange: #c2410c;
      --orange-soft: #fff7ed;
      --red: #b91c1c;
      --red-soft: #fef2f2;
      --green: #15803d;
      --green-soft: #f0fdf4;
      --text: #0f172a;
      --muted: #64748b;
      --border: #e2e8f0;
      --bg: #f8fafc;
      --white: #ffffff;
      --shadow: 0 18px 55px rgba(15, 23, 42, 0.08);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background:
        radial-gradient(circle at 10% 10%,
          rgba(20, 184, 166, 0.07),
          transparent 28%),
        radial-gradient(circle at 90% 80%,
          rgba(37, 99, 235, 0.06),
          transparent 28%),
        var(--bg);
    }

    .identity-page {
      min-height: calc(100vh - 140px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 45px 20px 60px;
    }

    .identity-wrapper {
      width: 100%;
      max-width: 820px;
    }

    /* =====================================
       MAIN CARD
    ===================================== */

    .identity-card {
      overflow: hidden;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 26px;
      box-shadow: var(--shadow);
    }

    /* =====================================
       CARD TOP
    ===================================== */

    .identity-top {
      padding: 32px 38px 28px;
      border-bottom: 1px solid var(--border);
      background: linear-gradient(180deg,
          #ffffff 0%,
          #fbfdff 100%);
    }

    .step-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 7px 12px;
      border-radius: 999px;
      background: var(--blue-soft);
      color: var(--blue);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .7px;
      text-transform: uppercase;
    }

    .step-badge i {
      font-size: 11px;
    }

    .identity-heading {
      display: flex;
      align-items: flex-start;
      gap: 18px;
      margin-top: 20px;
    }

    .identity-icon {
      width: 58px;
      height: 58px;
      min-width: 58px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 16px;
      background: linear-gradient(135deg,
          var(--primary-soft),
          #ccfbf1);
      color: var(--primary);
      font-size: 24px;
    }

    .identity-heading h1 {
      margin: 0 0 8px;
      color: var(--text);
      font-size: 30px;
      line-height: 1.2;
      font-weight: 800;
      letter-spacing: -.7px;
    }

    .identity-heading p {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.6;
    }

    /* =====================================
       PROGRESS
    ===================================== */

    .verification-progress {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
      margin-top: 28px;
    }

    .progress-step {
      position: relative;
      height: 6px;
      overflow: hidden;
      border-radius: 999px;
      background: #e2e8f0;
    }

    .progress-step.active {
      background: linear-gradient(90deg,
          var(--blue),
          #60a5fa);
    }

    /* =====================================
       CARD BODY
    ===================================== */

    .identity-body {
      padding: 30px 38px 34px;
    }

    /* =====================================
       DEMO MODE
    ===================================== */

    .demo-alert {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 22px;
      padding: 14px 16px;
      border: 1px solid #fed7aa;
      border-radius: 14px;
      background: var(--orange-soft);
      color: var(--orange);
      font-size: 13px;
      line-height: 1.55;
    }

    .demo-alert i {
      margin-top: 2px;
      font-size: 16px;
    }

    .demo-alert strong {
      font-weight: 800;
    }

    /* =====================================
       ERROR MESSAGE
    ===================================== */

    .error-alert {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 22px;
      padding: 14px 16px;
      border: 1px solid #fecaca;
      border-radius: 14px;
      background: var(--red-soft);
      color: var(--red);
      font-size: 13px;
      line-height: 1.55;
    }

    .error-alert i {
      margin-top: 2px;
      font-size: 16px;
    }

    .error-alert a {
      display: inline-flex;
      margin-top: 7px;
      color: var(--red);
      font-weight: 750;
      text-decoration: underline;
    }

    /* =====================================
       SUCCESS STATE
    ===================================== */

    .success-state {
      padding: 26px;
      border: 1px solid #bbf7d0;
      border-radius: 18px;
      background: linear-gradient(135deg,
          #f0fdf4,
          #ffffff);
      text-align: center;
    }

    .success-icon {
      width: 68px;
      height: 68px;
      margin: 0 auto 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: var(--green-soft);
      color: var(--green);
      font-size: 29px;
    }

    .success-state h2 {
      margin: 0 0 8px;
      color: #166534;
      font-size: 21px;
      font-weight: 800;
    }

    .success-state p {
      max-width: 550px;
      margin: 0 auto 20px;
      color: #4b5563;
      font-size: 14px;
      line-height: 1.6;
    }

    /* =====================================
       FORM INTRO
    ===================================== */

    .form-intro {
      margin-bottom: 22px;
    }

    .form-intro h2 {
      margin: 0 0 8px;
      color: var(--text);
      font-size: 19px;
      font-weight: 800;
    }

    .form-intro p {
      margin: 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.6;
    }

    /* =====================================
       FORM
    ===================================== */

    .identity-form {
      width: 100%;
    }

    .form-group {
      margin-bottom: 20px;
    }

    .form-label {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 8px;
      color: #334155;
      font-size: 13px;
      font-weight: 750;
    }

    .label-required {
      color: #dc2626;
    }

    .aadhaar-input-wrapper {
      position: relative;
    }

    .aadhaar-input-wrapper>i {
      position: absolute;
      left: 15px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--muted);
      pointer-events: none;
    }

    .aadhaar-input {
      width: 100%;
      min-height: 52px;
      padding: 0 15px 0 44px;
      border: 1px solid var(--border);
      border-radius: 13px;
      outline: none;
      background: #f8fafc;
      color: var(--text);
      font-family: inherit;
      font-size: 15px;
      letter-spacing: 1px;
      transition: .2s ease;
    }

    .aadhaar-input:hover {
      background: #fff;
      border-color: #b7c5d6;
    }

    .aadhaar-input:focus {
      background: #fff;
      border-color: var(--blue);
      box-shadow: 0 0 0 4px rgba(37, 99, 235, .09);
    }

    .input-hint {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 8px;
      color: var(--muted);
      font-size: 12px;
    }

    .input-hint i {
      color: var(--primary);
    }

    /* =====================================
       CONSENT
    ===================================== */

    .consent-box {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 16px;
      margin: 20px 0 22px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: #f8fafc;
      cursor: pointer;
      transition: .2s ease;
    }

    .consent-box:hover {
      border-color: #b7c5d6;
      background: #fff;
    }

    .consent-box input {
      width: 18px;
      height: 18px;
      min-width: 18px;
      margin: 1px 0 0;
      accent-color: var(--primary);
      cursor: pointer;
    }

    .consent-text {
      color: #475569;
      font-size: 13px;
      line-height: 1.55;
    }

    .consent-text strong {
      color: var(--text);
    }

    /* =====================================
       PRIMARY BUTTON
    ===================================== */

    .primary-btn {
      min-height: 50px;
      width: 100%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 0 22px;
      border: 0;
      border-radius: 13px;
      background: linear-gradient(135deg,
          var(--primary),
          #0d9488);
      color: #fff;
      font-family: inherit;
      font-size: 14px;
      font-weight: 800;
      text-decoration: none;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(15, 118, 110, .2);
      transition: all .22s ease;
    }

    .primary-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 26px rgba(15, 118, 110, .28);
    }

    .primary-btn:active {
      transform: translateY(0);
    }

    /* =====================================
       PREPARATION CARD
    ===================================== */

    .prepare-card {
      margin-top: 25px;
      padding: 18px;
      border: 1px solid #dbeafe;
      border-radius: 15px;
      background: #eff6ff;
    }

    .prepare-title {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 11px;
      color: #1e40af;
      font-size: 13px;
      font-weight: 800;
    }

    .prepare-list {
      margin: 0;
      padding-left: 19px;
      color: #475569;
      font-size: 12px;
      line-height: 1.8;
    }

    /* =====================================
       PRIVACY FOOTER
    ===================================== */

    .privacy-note {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      margin-top: 20px;
      color: var(--muted);
      font-size: 11px;
      text-align: center;
    }

    .privacy-note i {
      color: var(--primary);
    }

    /* =====================================
       MOBILE
    ===================================== */

    @media (max-width: 700px) {

      .identity-page {
        min-height: auto;
        padding: 25px 13px 40px;
      }

      .identity-card {
        border-radius: 20px;
      }

      .identity-top {
        padding: 25px 20px 22px;
      }

      .identity-body {
        padding: 24px 20px 27px;
      }

      .identity-heading {
        gap: 13px;
      }

      .identity-icon {
        width: 50px;
        height: 50px;
        min-width: 50px;
        border-radius: 14px;
        font-size: 20px;
      }

      .identity-heading h1 {
        font-size: 24px;
      }

      .identity-heading p {
        font-size: 13px;
      }

      .success-state {
        padding: 22px 17px;
      }
    }

    @media (max-width: 430px) {

      .identity-page {
        padding: 18px 10px 30px;
      }

      .identity-top {
        padding: 22px 16px 20px;
      }

      .identity-body {
        padding: 21px 16px 24px;
      }

      .step-badge {
        font-size: 10px;
      }

      .identity-heading h1 {
        font-size: 21px;
      }

      .identity-icon {
        width: 44px;
        height: 44px;
        min-width: 44px;
        font-size: 18px;
      }

      .aadhaar-input {
        min-height: 49px;
        font-size: 14px;
      }

      .consent-box {
        padding: 13px;
      }
    }
  </style>

  <main class="identity-page">

    ```
    <div class="identity-wrapper">

      <section class="identity-card">

        <!-- =================================
             HEADER
        ================================== -->

        <div class="identity-top">

          <span class="step-badge">
            <i class="fa-solid fa-shield-halved"></i>
            Step 1 of 2
          </span>


