              </p>

            </div>

          </div>


          <div class="verification-progress">

            <div class="progress-step active"></div>

            <div class="progress-step"></div>

          </div>

        </div>


        <!-- =================================
             BODY
        ================================== -->

        <div class="identity-body">


          <!-- Demo Mode -->

          <% if (typeof demoMode !=="undefined" && demoMode) { %>

            <div class="demo-alert">

              <i class="fa-solid fa-triangle-exclamation"></i>

              <div>

                <strong>Development Demo:</strong>

                This validates the application flow only.
                It is not Aadhaar or UIDAI authentication.

              </div>

            </div>

            <% } %>


              <!-- Error Message -->

              <% if (message) { %>

                <div class="error-alert">

                  <i class="fa-solid fa-circle-exclamation"></i>

                  <div>

                    <div>
                      <%= message %>
                    </div>

                    <a href="/patient/dashboard">
                      Return to dashboard
                    </a>

                  </div>

                </div>

                <% } %>


                  <!-- Already Verified -->

                  <% if (typeof sessionVerified !=="undefined" && sessionVerified) { %>

                    <div class="success-state">

                      <div class="success-icon">
                        <i class="fa-solid fa-circle-check"></i>
                      </div>

                      <h2>
                        Identity Successfully Verified
                      </h2>

                      <p>
                        Your identity is verified for this login session.
                        Protected medical information is now available.
                      </p>

                      <a href="/patient/history" class="primary-btn">

                        <i class="fa-solid fa-file-medical"></i>

                        View Medical History

                      </a>

                    </div>


                    <% } else { %>


                      <!-- Verification Introduction -->

                      <div class="form-intro">

                        <h2>
                          Aadhaar-linked Identity
                        </h2>

                        <p>
                          Verify your identity first, then complete
                          live video face verification to unlock
                          your protected medical history.
                        </p>

                      </div>


                      <!-- =================================
                     AADHAAR FORM
                ================================== -->

                      <form action="/patient/identity/aadhaar/start" method="post" class="identity-form">

                        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">


                        <div class="form-group">

                          <label for="aadhaarNumber" class="form-label">

                            <span>
                              Aadhaar Number
                              <span class="label-required">*</span>
                            </span>

                          </label>


                          <div class="aadhaar-input-wrapper">

                            <i class="fa-solid fa-id-card"></i>

                            <input id="aadhaarNumber" name="aadhaarNumber" class="aadhaar-input" type="text"
                              inputmode="numeric" autocomplete="off" maxlength="14"
                              placeholder="12-digit Aadhaar number" required>

                          </div>


                          <div class="input-hint">

                            <i class="fa-solid fa-lock"></i>

                            Enter your 12-digit Aadhaar number
