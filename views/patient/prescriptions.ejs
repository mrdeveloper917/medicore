<%- include("../layouts/patientHeader", { title: "My Prescriptions" , user: user }) %>

    <div class="prescriptions-page">

        ```
        <!-- =========================
     PAGE HERO
========================== -->
        <section class="prescriptions-hero">

            <div class="hero-content">

                <a href="/patient/dashboard" class="back-link">
                    <i class="fa-solid fa-arrow-left"></i>
                    Back to Dashboard
                </a>

                <div class="hero-title-row">

                    <div class="hero-icon">
                        <i class="fa-solid fa-prescription-bottle-medical"></i>
                    </div>

                    <div>
                        <h1>My Prescriptions</h1>
                        <p>
                            Keep track of your medicines, dosage instructions
                            and doctor's notes in one place.
                        </p>
                    </div>

                </div>

            </div>

            <div class="prescription-count">
                <div class="count-icon">
                    <i class="fa-solid fa-pills"></i>
                </div>

                <div>
                    <strong>
                        <%= prescriptions?.length || 0 %>
                    </strong>
                    <span>Prescriptions</span>
                </div>
            </div>

        </section>


        <!-- =========================
     PRESCRIPTIONS
========================== -->

        <% if (prescriptions && prescriptions.length> 0) { %>

            <section class="prescriptions-list">

                <% prescriptions.forEach(function(item, index) { %>

                    <article class="prescription-card">

                        <!-- CARD TOP -->
                        <div class="card-top">

                            <div class="prescription-number">
                                <span>#<%= String(index + 1).padStart(2, "0" ) %></span>
                                <small>Prescription</small>
                            </div>

                            <div class="prescription-date">

                                <span>Prescribed On</span>

                                <strong>
                                    <%= item.createdAt ? new Date(item.createdAt).toLocaleDateString( "en-IN" , {
                                        day: "numeric" , month: "short" , year: "numeric" } ) : "N/A" %>
                                </strong>

                            </div>

                        </div>


                        <!-- DOCTOR -->
                        <div class="doctor-section">

                            <div class="doctor-avatar">

                                <% if (item.doctor && item.doctor.profileImage) { %>

                                    <img src="<%= item.doctor.profileImage %>"
                                        alt="Dr. <%= item.doctor.firstName || 'Doctor' %>">

                                    <% } else { %>

                                        <span>
                                            <%= item.doctor && item.doctor.firstName ?
                                                item.doctor.firstName.charAt(0).toUpperCase() : "D" %>
                                        </span>

                                        <% } %>

                            </div>


                            <div class="doctor-info">

                                <div class="doctor-label">
                                    <i class="fa-solid fa-user-doctor"></i>
                                    Prescribed by
                                </div>

                                <h2>
                                    Dr.
                                    <%= item.doctor?.firstName || "" %>
                                        <%= item.doctor?.lastName || "" %>
                                </h2>

                                <p>
                                    <%= item.doctor?.specialization || "General Physician" %>
                                </p>

                            </div>

                        </div>


                        <!-- MEDICINE HERO -->
                        <div class="medicine-highlight">

                            <div class="medicine-icon">
                                <i class="fa-solid fa-pills"></i>
                            </div>

                            <div class="medicine-content">

                                <span>MEDICINE</span>

                                <h3>
                                    <%= item.medicine || "Medicine not specified" %>
                                </h3>

                            </div>

                            <div class="active-status">
                                <i class="fa-solid fa-circle-check"></i>
                                Active
                            </div>

                        </div>


                        <!-- DETAILS -->
                        <div class="details-grid">

                            <!-- DOSAGE -->
                            <div class="detail-box">

                                <div class="detail-icon dosage-icon">
                                    <i class="fa-solid fa-clock"></i>
                                </div>

                                <div class="detail-content">

                                    <span>Dosage / Instructions</span>

                                    <p>
                                        <%= item.dosage || "No dosage instructions provided." %>
                                    </p>

                                </div>

                            </div>


                            <!-- NOTES -->
                            <div class="detail-box">

                                <div class="detail-icon notes-icon">
                                    <i class="fa-solid fa-note-sticky"></i>
                                </div>

                                <div class="detail-content">

                                    <span>Doctor's Notes</span>

                                    <p>
                                        <%= item.notes || "No additional notes." %>
                                    </p>

                                </div>

                            </div>

                        </div>


                        <!-- FOOTER -->
                        <div class="prescription-footer">

                            <div class="footer-left">

                                <span class="verified-badge">
                                    <i class="fa-solid fa-shield-heart"></i>
                                    Doctor Verified
                                </span>

                            </div>


                            <% if (item.doctor?.email) { %>

                                <a href="mailto:<%= item.doctor.email %>" class="doctor-email">
                                    <i class="fa-solid fa-envelope"></i>
                                    <%= item.doctor.email %>
                                </a>

                                <% } %>

                        </div>

                    </article>

                    <% }); %>

            </section>


            <% } else { %>

                <!-- =========================
         EMPTY STATE
    ========================== -->

                <section class="empty-state">

                    <div class="empty-illustration">

                        <div class="empty-circle circle-one"></div>
                        <div class="empty-circle circle-two"></div>

                        <div class="empty-icon">
                            <i class="fa-solid fa-prescription-bottle-medical"></i>
                        </div>

                    </div>

                    <span class="empty-label">
                        <i class="fa-solid fa-file-medical"></i>
                        No prescription records
                    </span>

                    <h2>No Prescriptions Yet</h2>

                    <p>
                        Your prescriptions will appear here after a doctor
                        creates one for you during your treatment.
                    </p>

                    <a href="/patient/appointments" class="primary-btn">
                        <i class="fa-solid fa-calendar-check"></i>
                        View Appointments
                    </a>

                </section>

                <% } %>
                    ```

    </div>

    <style>
        /* =========================================================
   ROOT
========================================================= */

        .prescriptions-page {
            --primary: #0f766e;
            --primary-dark: #115e59;
            --primary-light: #14b8a6;
            --primary-soft: #ecfdf5;

            --blue: #2563eb;
            --blue-soft: #eff6ff;

            --text: #0f172a;
            --text-secondary: #475569;
            --muted: #94a3b8;

            --border: #e2e8f0;
            --surface: #ffffff;
            --background: #f8fafc;

            max-width: 1180px;
            margin: 0 auto;
            padding: 34px 22px 70px;
        }


        /* =========================================================
   HERO
========================================================= */

        .prescriptions-hero {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 25px;

            padding: 30px;
            margin-bottom: 26px;

            border-radius: 24px;

            background:
                radial-gradient(circle at 90% 15%,
                    rgba(20, 184, 166, 0.16),
                    transparent 30%),
                linear-gradient(135deg,
                    #ffffff,
                    #f0fdfa);

            border: 1px solid #ccfbf1;

            box-shadow:
                0 15px 45px rgba(15, 118, 110, 0.07);
        }


        /* BACK */

        .back-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;

            margin-bottom: 18px;

            color: var(--primary);

            text-decoration: none;

            font-size: 13px;
            font-weight: 700;

            transition: 0.2s ease;
        }

        .back-link:hover {
            color: var(--primary-dark);
            transform: translateX(-2px);
        }


        /* TITLE */

        .hero-title-row {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .hero-icon {
            width: 58px;
            height: 58px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 17px;

            background: linear-gradient(135deg,
                    var(--primary),
                    var(--primary-light));

            color: white;

            font-size: 23px;

            box-shadow:
                0 10px 22px rgba(15, 118, 110, 0.20);
        }

        .hero-title-row h1 {
            margin: 0 0 5px;

            color: var(--text);

            font-size: 31px;
            font-weight: 800;

            letter-spacing: -0.6px;
        }

        .hero-title-row p {
            margin: 0;

            color: var(--text-secondary);

            font-size: 14px;
            line-height: 1.6;
        }


        /* COUNT */

        .prescription-count {
            min-width: 160px;

            display: flex;
            align-items: center;
            gap: 12px;

            padding: 14px 17px;

            border-radius: 15px;

            background: rgba(255, 255, 255, 0.88);

            border: 1px solid #dbeafe;

            box-shadow: 0 8px 22px rgba(15, 23, 42, 0.05);
        }

        .count-icon {
            width: 43px;
            height: 43px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 12px;

            background: var(--blue-soft);
            color: var(--blue);

            font-size: 17px;
        }

        .prescription-count strong {
            display: block;

            color: var(--text);

            font-size: 20px;
            line-height: 1.1;
        }

        .prescription-count span {
            display: block;

            margin-top: 3px;

            color: var(--muted);

            font-size: 11px;
            font-weight: 600;
        }


        /* =========================================================
   PRESCRIPTION CARD
========================================================= */

        .prescription-card {
            position: relative;

            overflow: hidden;

            margin-bottom: 20px;
            padding: 24px;

            background: var(--surface);

            border: 1px solid var(--border);

            border-radius: 22px;

            box-shadow:
                0 8px 30px rgba(15, 23, 42, 0.055);

            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease,
                border-color 0.25s ease;
        }

        .prescription-card::before {
            content: "";

            position: absolute;

            left: 0;
            top: 0;
            bottom: 0;

            width: 4px;

            background: linear-gradient(to bottom,
                    var(--primary-light),
                    var(--primary));
        }

        .prescription-card:hover {
            transform: translateY(-3px);

            border-color: #bcefe7;

            box-shadow:
                0 18px 42px rgba(15, 118, 110, 0.09);
        }


        /* =========================================================
   CARD TOP
========================================================= */

        .card-top {
            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 20px;

            padding-bottom: 17px;

            border-bottom: 1px solid #f1f5f9;
        }

        .prescription-number {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .prescription-number span {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            min-width: 42px;
            height: 28px;

            border-radius: 8px;

            background: var(--primary-soft);
            color: var(--primary);

            font-size: 11px;
            font-weight: 800;
        }

        .prescription-number small {
            color: var(--muted);

            font-size: 11px;
            font-weight: 600;
        }

        .prescription-date {
            text-align: right;
        }

        .prescription-date span {
            display: block;

            margin-bottom: 4px;

            color: var(--muted);

            font-size: 10px;
            font-weight: 600;

            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

        .prescription-date strong {
            color: var(--text-secondary);

            font-size: 13px;
        }


        /* =========================================================
   DOCTOR
========================================================= */

        .doctor-section {
            display: flex;
            align-items: center;

            gap: 14px;

            padding: 21px 0;
        }

        .doctor-avatar {
            width: 60px;
            height: 60px;

            flex-shrink: 0;

            overflow: hidden;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 18px;

            background:
                linear-gradient(135deg,
                    #ccfbf1,
                    #dbeafe);

            color: var(--primary);

            font-size: 21px;
            font-weight: 800;

            border: 3px solid #ffffff;

            box-shadow:
                0 5px 15px rgba(15, 23, 42, 0.08);
        }

        .doctor-avatar img {
            width: 100%;
            height: 100%;

            object-fit: cover;
        }

        .doctor-label {
            display: flex;
            align-items: center;
            gap: 6px;

            margin-bottom: 4px;

            color: var(--muted);

            font-size: 10px;
            font-weight: 700;

            text-transform: uppercase;
            letter-spacing: 0.45px;
        }

        .doctor-label i {
            color: var(--primary);
        }

        .doctor-info h2 {
            margin: 0 0 4px;

            color: var(--text);

            font-size: 17px;
            font-weight: 750;
        }

        .doctor-info p {
            margin: 0;

            color: var(--primary);

            font-size: 12px;
            font-weight: 700;
        }


        /* =========================================================
   MEDICINE HIGHLIGHT
========================================================= */

        .medicine-highlight {
            display: flex;
            align-items: center;

            gap: 15px;

            padding: 18px;

            margin-bottom: 17px;

            border-radius: 16px;

            background:
                linear-gradient(135deg,
                    #f0fdfa,
                    #f8fafc);

            border: 1px solid #ccfbf1;
        }

        .medicine-icon {
            width: 47px;
            height: 47px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 13px;

            background: white;

            color: var(--primary);

            font-size: 19px;

            box-shadow:
                0 5px 14px rgba(15, 118, 110, 0.08);
        }

        .medicine-content {
            min-width: 0;
            flex: 1;
        }

        .medicine-content span {
            display: block;

            margin-bottom: 4px;

            color: var(--muted);

            font-size: 9px;
            font-weight: 800;

            letter-spacing: 0.7px;
        }

        .medicine-content h3 {
            margin: 0;

            color: var(--text);

            font-size: 17px;
            font-weight: 800;

            word-break: break-word;
        }

        .active-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;

            padding: 7px 10px;

            border-radius: 20px;

            background: #dcfce7;
            color: #15803d;

            font-size: 10px;
            font-weight: 800;

            white-space: nowrap;
        }

        .active-status i {
            font-size: 10px;
        }


        /* =========================================================
   DETAILS
========================================================= */

        .details-grid {
            display: grid;

            grid-template-columns: repeat(2, minmax(0, 1fr));

            gap: 14px;
        }

        .detail-box {
            display: flex;
            align-items: flex-start;

            gap: 12px;

            min-height: 110px;

            padding: 16px;

            border: 1px solid var(--border);

            border-radius: 15px;

            background: #ffffff;

            transition: 0.2s ease;
        }

        .detail-box:hover {
            border-color: #cbd5e1;

            background: #fcfffe;
        }

        .detail-icon {
            width: 38px;
            height: 38px;

            flex-shrink: 0;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 10px;

            font-size: 14px;
        }

        .dosage-icon {
            background: #eff6ff;
            color: #2563eb;
        }

        .notes-icon {
            background: #fff7ed;
            color: #ea580c;
        }

        .detail-content {
            min-width: 0;
        }

        .detail-content span {
            display: block;

            margin-bottom: 6px;

            color: var(--muted);

            font-size: 10px;
            font-weight: 700;

            text-transform: uppercase;
            letter-spacing: 0.35px;
        }

        .detail-content p {
            margin: 0;

            color: var(--text-secondary);

            font-size: 13px;
            line-height: 1.65;

            word-break: break-word;
        }


        /* =========================================================
   FOOTER
========================================================= */

        .prescription-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 15px;

            margin-top: 19px;
            padding-top: 16px;

            border-top: 1px solid #f1f5f9;
        }

        .verified-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;

            padding: 6px 10px;

            border-radius: 20px;

            background: var(--primary-soft);
            color: #047857;

            font-size: 10px;
            font-weight: 800;
        }

        .verified-badge i {
            font-size: 10px;
        }

        .doctor-email {
            display: inline-flex;
            align-items: center;
            gap: 7px;

            color: var(--text-secondary);

            text-decoration: none;

            font-size: 11px;
            font-weight: 600;

            transition: 0.2s ease;
        }

        .doctor-email:hover {
            color: var(--primary);
        }


        /* =========================================================
   EMPTY STATE
========================================================= */

        .empty-state {
            position: relative;

            overflow: hidden;

            padding: 70px 25px;

            text-align: center;

            background: #ffffff;

            border: 1px solid var(--border);

            border-radius: 24px;

            box-shadow:
                0 10px 35px rgba(15, 23, 42, 0.05);
        }

        .empty-illustration {
            position: relative;

            width: 90px;
            height: 90px;

            margin: 0 auto 18px;
        }

        .empty-icon {
            position: relative;
            z-index: 2;

            width: 72px;
            height: 72px;

            margin: 9px auto;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 22px;

            background:
                linear-gradient(135deg,
                    #ccfbf1,
                    #dbeafe);

            color: var(--primary);

            font-size: 28px;

            box-shadow:
                0 10px 25px rgba(15, 118, 110, 0.10);
        }

        .empty-circle {
            position: absolute;

            border-radius: 50%;

            opacity: 0.5;
        }

        .circle-one {
            width: 26px;
            height: 26px;

            top: 0;
            right: 2px;

            background: #dbeafe;
        }

        .circle-two {
            width: 18px;
            height: 18px;

            bottom: 2px;
            left: 0;

            background: #ccfbf1;
        }

        .empty-label {
            display: inline-flex;
            align-items: center;
            gap: 6px;

            padding: 6px 10px;

            margin-bottom: 10px;

            border-radius: 20px;

            background: var(--primary-soft);
            color: var(--primary);

            font-size: 10px;
            font-weight: 800;
        }

        .empty-state h2 {
            margin: 0 0 8px;

            color: var(--text);

            font-size: 21px;
            font-weight: 800;
        }

        .empty-state p {
            max-width: 460px;

            margin: 0 auto 24px;

            color: var(--text-secondary);

            font-size: 13px;
            line-height: 1.7;
        }

        .primary-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;

            gap: 8px;

            padding: 12px 18px;

            border-radius: 11px;

            background:
                linear-gradient(135deg,
                    var(--primary),
                    var(--primary-light));

            color: white;

            text-decoration: none;

            font-size: 12px;
            font-weight: 800;

            box-shadow:
                0 8px 18px rgba(15, 118, 110, 0.18);

            transition: 0.2s ease;
        }

        .primary-btn:hover {
            transform: translateY(-2px);

            box-shadow:
                0 12px 24px rgba(15, 118, 110, 0.24);
        }


        /* =========================================================
   TABLET
========================================================= */

        @media (max-width: 760px) {

            .prescriptions-page {
                padding: 25px 16px 55px;
            }

            .prescriptions-hero {
                flex-direction: column;
                align-items: flex-start;

                padding: 24px;
            }

            .prescription-count {
                width: 100%;
            }

            .details-grid {
                grid-template-columns: 1fr;
            }

        }


        /* =========================================================
   MOBILE
========================================================= */

        @media (max-width: 520px) {

            .prescriptions-page {
                padding: 18px 12px 45px;
            }

            .prescriptions-hero {
                padding: 20px;

                border-radius: 19px;
            }

            .hero-title-row {
                align-items: flex-start;
            }

            .hero-icon {
                width: 48px;
                height: 48px;

                flex-shrink: 0;

                border-radius: 14px;

                font-size: 19px;
            }

            .hero-title-row h1 {
                font-size: 24px;
            }

            .hero-title-row p {
                font-size: 12px;
            }

            .prescription-card {
                padding: 18px;

                border-radius: 18px;
            }

            .card-top {
                align-items: flex-start;
            }

            .doctor-avatar {
                width: 52px;
                height: 52px;

                border-radius: 15px;
            }

            .doctor-info h2 {
                font-size: 15px;
            }

            .medicine-highlight {
                align-items: flex-start;

                flex-wrap: wrap;

                padding: 14px;
            }

            .medicine-content {
                width: calc(100% - 62px);
            }

            .active-status {
                margin-left: 62px;
            }

            .prescription-footer {
                flex-direction: column;
                align-items: flex-start;
            }

            .doctor-email {
                max-width: 100%;

                word-break: break-all;
            }

            .empty-state {
                padding: 55px 18px;
            }

        }


        /* =========================================================
   VERY SMALL DEVICES
========================================================= */

        @media (max-width: 360px) {

            .hero-title-row {
                gap: 11px;
            }

            .hero-title-row h1 {
                font-size: 21px;
            }

            .prescription-card {
                padding: 15px;
            }

            .prescription-date strong {
                font-size: 12px;
            }

        }
    </style>

    <%- include("../layouts/patientFooter") %>