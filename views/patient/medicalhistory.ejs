<%- include("../layouts/patientHeader", { title: "Medical History" , user: user }) %>

    <style>
        :root {
            --primary: #0f766e;
            --primary-dark: #115e59;
            --primary-light: #14b8a6;
            --primary-soft: #ecfdf5;

            --blue: #2563eb;
            --blue-soft: #eff6ff;

            --purple: #7c3aed;
            --purple-soft: #f5f3ff;

            --orange: #ea580c;
            --orange-soft: #fff7ed;

            --green: #059669;
            --green-soft: #ecfdf5;

            --text: #0f172a;
            --text-soft: #334155;
            --muted: #64748b;

            --border: #e2e8f0;
            --bg: #f8fafc;
            --white: #ffffff;

            --shadow: 0 10px 35px rgba(15, 23, 42, 0.07);
            --shadow-hover: 0 16px 42px rgba(15, 23, 42, 0.10);

            --radius: 20px;
        }

        * {
            box-sizing: border-box;
        }

        body {
            background:
                radial-gradient(circle at 5% 5%,
                    rgba(20, 184, 166, 0.05),
                    transparent 25%),
                var(--bg);
        }

        /* =========================================
       PAGE
    ========================================= */

        .medical-history-page {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 30px 28px 55px;
        }

        /* =========================================
       PAGE HEADER
    ========================================= */

        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 27px;
        }

        .page-title-wrap {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .page-title-icon {
            width: 52px;
            height: 52px;
            min-width: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 15px;
            background: linear-gradient(135deg,
                    var(--primary-soft),
                    #ccfbf1);
            color: var(--primary);
            font-size: 22px;
        }

        .page-header h1 {
            margin: 0 0 5px;
            color: var(--text);
            font-size: 30px;
            font-weight: 800;
            letter-spacing: -.6px;
        }

        .page-header p {
            margin: 0;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.5;
        }

        .back-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 11px 17px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: #fff;
            color: #475569;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            transition: all .2s ease;
        }

        .back-btn:hover {
            border-color: #cbd5e1;
            background: #f8fafc;
            color: var(--text);
            transform: translateY(-1px);
        }

        /* =========================================
       SUMMARY
    ========================================= */

        .history-summary {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 25px;
        }

        .summary-card {
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            gap: 15px;
            min-height: 105px;
            padding: 20px;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 18px;
            box-shadow: var(--shadow);
            transition: all .22s ease;
        }

        .summary-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-hover);
        }

        .summary-card::after {
            content: "";
            position: absolute;
            width: 80px;
            height: 80px;
            right: -35px;
            bottom: -35px;
            border-radius: 50%;
            background: rgba(15, 118, 110, .05);
        }

        .summary-icon {
            width: 52px;
            height: 52px;
            min-width: 52px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            background: var(--primary-soft);
            color: var(--primary);
            font-size: 21px;
        }

        .summary-card:nth-child(2) .summary-icon {
            background: var(--blue-soft);
            color: var(--blue);
        }

        .summary-card:nth-child(3) .summary-icon {
            background: var(--purple-soft);
            color: var(--purple);
        }

        .summary-card span {
            display: block;
            margin-bottom: 5px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
        }

        .summary-card strong {
            display: block;
            color: var(--text);
            font-size: 23px;
            line-height: 1.2;
            font-weight: 800;
        }

        /* =========================================
       SEARCH
    ========================================= */

        .search-box {
            position: relative;
            margin-bottom: 24px;
        }

        .search-box::before {
            content: "\f002";
            position: absolute;
            top: 50%;
            left: 17px;
            z-index: 2;
            transform: translateY(-50%);
            color: #94a3b8;
            font-family: "Font Awesome 6 Free";
            font-weight: 900;
            pointer-events: none;
        }

        .search-box input {
            width: 100%;
            min-height: 52px;
            padding: 0 18px 0 47px;
            border: 1px solid var(--border);
            border-radius: 14px;
            outline: none;
            background: #fff;
            color: var(--text);
            font-family: inherit;
            font-size: 14px;
            box-shadow: 0 4px 15px rgba(15, 23, 42, .03);
            transition: .2s ease;
        }

        .search-box input::placeholder {
            color: #94a3b8;
        }

        .search-box input:hover {
            border-color: #cbd5e1;
        }

        .search-box input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(15, 118, 110, .08);
        }

        /* =========================================
       HISTORY CONTAINER
    ========================================= */

        .history-container {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* =========================================
       HISTORY CARD
    ========================================= */

        .history-card {
            overflow: hidden;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            transition: all .22s ease;
        }

        .history-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-hover);
        }

        .history-card-inner {
            padding: 25px;
        }

        /* =========================================
       RECORD HEADER
    ========================================= */

        .history-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border);
        }

        .visit-info {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .calendar-icon {
            width: 51px;
            height: 51px;
            min-width: 51px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 14px;
            background: var(--blue-soft);
            color: var(--blue);
            font-size: 19px;
        }

        .visit-info h2 {
            margin: 0 0 5px;
            color: var(--text);
            font-size: 18px;
            font-weight: 800;
        }

        .visit-info p {
            margin: 0;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.5;
        }

        .record-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 12px;
            border: 1px solid #a7f3d0;
            border-radius: 999px;
            background: var(--green-soft);
            color: #047857;
            font-size: 11px;
            font-weight: 750;
            white-space: nowrap;
        }

        .record-badge::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #10b981;
        }

        /* =========================================
       DOCTOR SECTION
    ========================================= */

        .doctor-section {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 22px 0;
        }

        .doctor-image {
            flex-shrink: 0;
        }

        .doctor-image img,
        .doctor-placeholder {
            width: 65px;
            height: 65px;
            border-radius: 50%;
        }

        .doctor-image img {
            display: block;
            object-fit: cover;
            border: 3px solid #f1f5f9;
        }

        .doctor-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            border: 3px solid #eef2ff;
            background: #eef2ff;
            color: #6366f1;
            font-size: 22px;
        }

        .doctor-details span {
            display: block;
            margin-bottom: 3px;
            color: var(--muted);
            font-size: 11px;
            font-weight: 650;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .doctor-details h3 {
            margin: 0 0 4px;
            color: var(--text);
            font-size: 17px;
            font-weight: 800;
        }

        .doctor-details p {
            margin: 0;
            color: var(--primary);
            font-size: 13px;
            font-weight: 650;
        }

        /* =========================================
       MEDICAL INFORMATION
    ========================================= */

        .medical-information {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 14px;
        }

        .info-box {
            position: relative;
            padding: 17px;
            border: 1px solid #edf1f5;
            border-radius: 14px;
            background: #f8fafc;
            transition: .2s ease;
        }

        .info-box:hover {
            border-color: #d9e2eb;
            background: #fff;
        }

        .info-title {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 8px;
            color: var(--text-soft);
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .info-title::before {
            content: "";
            width: 5px;
            height: 5px;
            border-radius: 50%;
            background: var(--primary);
        }

        .info-box p {
            margin: 0;
            color: #475569;
            font-size: 13px;
            line-height: 1.65;
            white-space: pre-line;
            overflow-wrap: anywhere;
        }

        .notes-box {
            grid-column: 1 / -1;
            background: #fffbeb;
            border-color: #fde68a;
        }

        .notes-box .info-title {
            color: #92400e;
        }

        .notes-box .info-title::before {
            background: #f59e0b;
        }

        /* =========================================
       APPOINTMENT INFO
    ========================================= */

        .appointment-info {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1px;
            margin-top: 20px;
            overflow: hidden;
            border: 1px solid var(--border);
            border-radius: 14px;
            background: var(--border);
        }

        .appointment-info>div {
            min-width: 0;
            padding: 16px;
            background: #fff;
        }

        .appointment-info span {
            display: block;
            margin-bottom: 6px;
            color: var(--muted);
            font-size: 11px;
            font-weight: 650;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .appointment-info strong {
            display: block;
            color: var(--text-soft);
            font-size: 13px;
            font-weight: 750;
            overflow-wrap: anywhere;
        }

        .appointment-info .status {
            color: var(--green);
            text-transform: capitalize;
        }

        /* =========================================
       EMPTY STATE
    ========================================= */

        .empty-state {
            padding: 70px 30px;
            text-align: center;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        .empty-icon {
            width: 76px;
            height: 76px;
            margin: 0 auto 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 22px;
            background: var(--primary-soft);
            color: var(--primary);
            font-size: 29px;
        }

        .empty-state h2 {
            margin: 0 0 9px;
            color: var(--text);
            font-size: 21px;
            font-weight: 800;
        }

        .empty-state p {
            max-width: 500px;
            margin: 0 auto 25px;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.6;
        }

        .primary-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 45px;
            padding: 0 19px;
            border-radius: 11px;
            background: linear-gradient(135deg,
                    var(--primary),
                    #0d9488);
            color: white;
            font-size: 13px;
            font-weight: 750;
            text-decoration: none;
            box-shadow: 0 7px 18px rgba(15, 118, 110, .20);
            transition: all .2s ease;
        }

        .primary-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 11px 23px rgba(15, 118, 110, .28);
        }

        /* =========================================
       NO RESULTS
    ========================================= */

        .no-results {
            padding: 55px 25px;
            text-align: center;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 18px;
        }

        .no-results-icon {
            width: 65px;
            height: 65px;
            margin: 0 auto 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 18px;
            background: var(--blue-soft);
            color: var(--blue);
            font-size: 23px;
        }

        .no-results h3 {
            margin: 0 0 7px;
            color: var(--text);
            font-size: 18px;
        }

        .no-results p {
            margin: 0;
            color: var(--muted);
            font-size: 13px;
        }

        /* =========================================
       RESPONSIVE TABLET
    ========================================= */

        @media (max-width: 1000px) {

            .medical-history-page {
                padding: 25px 20px 45px;
            }

            .history-summary {
                grid-template-columns: 1fr;
            }

            .appointment-info {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        /* =========================================
       RESPONSIVE MOBILE
    ========================================= */

        @media (max-width: 700px) {

            .medical-history-page {
                padding: 18px 13px 35px;
            }

            .page-header {
                align-items: flex-start;
                flex-direction: column;
                margin-bottom: 21px;
            }

            .page-title-wrap {
                align-items: flex-start;
            }

            .page-title-icon {
                width: 45px;
                height: 45px;
                min-width: 45px;
                border-radius: 13px;
                font-size: 18px;
            }

            .page-header h1 {
                font-size: 24px;
            }

            .page-header p {
                font-size: 13px;
            }

            .back-btn {
                width: 100%;
                justify-content: center;
            }

            .history-summary {
                gap: 12px;
                margin-bottom: 18px;
            }

            .summary-card {
                min-height: 88px;
                padding: 16px;
            }

            .summary-icon {
                width: 45px;
                height: 45px;
                min-width: 45px;
                border-radius: 12px;
            }

            .summary-card strong {
                font-size: 20px;
            }

            .history-card {
                border-radius: 17px;
            }

            .history-card-inner {
                padding: 18px;
            }

            .history-header {
                align-items: flex-start;
                flex-direction: column;
                gap: 13px;
            }

            .visit-info {
                align-items: flex-start;
            }

            .calendar-icon {
                width: 45px;
                height: 45px;
                min-width: 45px;
            }

            .visit-info h2 {
                font-size: 16px;
            }

            .visit-info p {
                font-size: 12px;
            }

            .record-badge {
                font-size: 10px;
            }

            .doctor-section {
                padding: 19px 0;
            }

            .doctor-image img,
            .doctor-placeholder {
                width: 56px;
                height: 56px;
            }

            .medical-information {
                grid-template-columns: 1fr;
            }

            .notes-box {
                grid-column: span 1;
            }

            .appointment-info {
                grid-template-columns: 1fr;
            }

            .empty-state {
                padding: 55px 20px;
            }

            .search-box input {
                min-height: 49px;
            }
        }

        /* =========================================
       SMALL MOBILE
    ========================================= */

        @media (max-width: 430px) {

            .medical-history-page {
                padding-left: 10px;
                padding-right: 10px;
            }

            .page-title-wrap {
                gap: 11px;
            }

            .page-title-icon {
                width: 42px;
                height: 42px;
                min-width: 42px;
            }

            .page-header h1 {
                font-size: 21px;
            }

            .summary-card {
                padding: 14px;
            }

            .history-card-inner {
                padding: 15px;
            }

            .info-box {
                padding: 14px;
            }
        }
    </style>

    <div class="medical-history-page">

        
        <!-- =========================================
     PAGE HEADER
========================================== -->

        <div class="page-header">

            <div class="page-title-wrap">

                <div class="page-title-icon">
                    <i class="fa-solid fa-file-medical"></i>
                </div>

                <div>

                    <h1>
                        Medical History
                    </h1>

                    <p>
                        View your previous medical visits, diagnoses and treatments.
                    </p>

                </div>

            </div>


            <a href="/patient/dashboard" class="back-btn">

                <i class="fa-solid fa-arrow-left"></i>

                Dashboard

            </a>

        </div>


        <!-- =========================================
     SUMMARY
========================================== -->

        <div class="history-summary">

            <div class="summary-card">

                <div class="summary-icon">
                    <i class="fa-solid fa-file-medical"></i>
                </div>

                <div>

                    <span>
                        Total Records
                    </span>

                    <strong>
                        <%= medicalHistory.length %>
                    </strong>

                </div>

            </div>


            <div class="summary-card">

                <div class="summary-icon">
                    <i class="fa-solid fa-user-doctor"></i>
                </div>

                <div>

                    <span>
                        Doctors Visited
                    </span>

                    <strong>
                        <%= new Set( medicalHistory .filter(item=> item.doctor)
                            .map(item => item.doctor._id.toString())
                            ).size %>
                    </strong>

                </div>

            </div>


            <div class="summary-card">

                <div class="summary-icon">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>

                <div>

                    <span>
                        Last Visit
                    </span>

                    <strong>

                        <% if (medicalHistory.length> 0) { %>

                            <%= new Date( medicalHistory[0].visitDate || medicalHistory[0].createdAt
                                ).toLocaleDateString("en-IN") %>

                                <% } else { %>

                                    --

                                    <% } %>

                    </strong>

                </div>

            </div>

        </div>


        <!-- =========================================
     SEARCH
========================================== -->

        <% if (medicalHistory.length> 0) { %>

            <div class="search-box">

                <input type="text" id="historySearch" placeholder="Search diagnosis, doctor, treatment, medicine...">

            </div>

            <% } %>


                <!-- =========================================
     MEDICAL RECORDS
========================================== -->

                <div class="history-container">


                    <% if (medicalHistory.length===0) { %>


                        <!-- EMPTY STATE -->

                        <div class="empty-state">

                            <div class="empty-icon">
                                <i class="fa-solid fa-folder-open"></i>
                            </div>

                            <h2>
                                No Medical History
                            </h2>

                            <p>
                                Your medical history will appear here after your doctor
                                adds a medical record.
                            </p>

                            <a href="/patient/book" class="primary-btn">

                                <i class="fa-solid fa-calendar-plus"></i>

                                Book Appointment

                            </a>

                        </div>


                        <% } else { %>


                            <% medicalHistory.forEach((item, index)=> { %>


                                <div class="history-card" data-search="
                    <%= item.diagnosis || "" %>
                    <%= item.symptoms || "" %>
                    <%= item.treatment || "" %>
                    <%= item.medicines || "" %>
                    <%= item.notes || "" %>
                    <%= item.doctor?.firstName || "" %>
                    <%= item.doctor?.lastName || "" %>
                    <%= item.doctor?.specialization || "" %>
                    <%= item.appointment?.department || "" %>
                    <%= item.appointment?.status || "" %>
                ">


                                    <div class="history-card-inner">


                                        <!-- =================================
                         RECORD HEADER
                    ================================== -->

                                        <div class="history-header">

                                            <div class="visit-info">

                                                <div class="calendar-icon">

                                                    <i class="fa-regular fa-calendar-days"></i>

                                                </div>


                                                <div>

                                                    <h2>
                                                        Medical Visit #<%= medicalHistory.length - index %>
                                                    </h2>

                                                    <p>

                                                        <%= new Date( item.visitDate || item.createdAt
                                                            ).toLocaleDateString( "en-IN" , { weekday: "long" ,
                                                            day: "numeric" , month: "long" , year: "numeric" } ) %>

                                                    </p>

                                                </div>

                                            </div>


                                            <span class="record-badge">

                                                Medical Record

                                            </span>

                                        </div>


                                        <!-- =================================
                         DOCTOR
                    ================================== -->

                                        <div class="doctor-section">

                                            <div class="doctor-image">

                                                <% if (item.doctor?.profileImage) { %>

                                                    <img src="<%= item.doctor.profileImage %>" alt="Doctor">

                                                    <% } else { %>

                                                        <div class="doctor-placeholder">

                                                            <i class="fa-solid fa-user-doctor"></i>

                                                        </div>

                                                        <% } %>

                                            </div>


                                            <div class="doctor-details">

                                                <span>
                                                    Consulted Doctor
                                                </span>

                                                <h3>

                                                    <% if (item.doctor) { %>

                                                        Dr.
                                                        <%= item.doctor.firstName || "" %>
                                                            <%= item.doctor.lastName || "" %>

                                                                <% } else { %>

                                                                    Doctor information unavailable

                                                                    <% } %>

                                                </h3>


                                                <% if (item.doctor?.specialization) { %>

                                                    <p>
                                                        <%= item.doctor.specialization %>
                                                    </p>

                                                    <% } %>

                                            </div>

                                        </div>


                                        <!-- =================================
                         MEDICAL INFORMATION
                    ================================== -->

                                        <div class="medical-information">


                                            <% if (item.diagnosis) { %>

                                                <div class="info-box">

                                                    <span class="info-title">
                                                        Diagnosis
                                                    </span>

                                                    <p>
                                                        <%= item.diagnosis %>
                                                    </p>

                                                </div>

                                                <% } %>


                                                    <% if (item.symptoms) { %>

                                                        <div class="info-box">

                                                            <span class="info-title">
                                                                Symptoms
                                                            </span>

                                                            <p>
                                                                <%= item.symptoms %>
                                                            </p>

                                                        </div>

                                                        <% } %>


                                                            <% if (item.treatment) { %>

                                                                <div class="info-box">

                                                                    <span class="info-title">
                                                                        Treatment
                                                                    </span>

                                                                    <p>
                                                                        <%= item.treatment %>
                                                                    </p>

                                                                </div>

                                                                <% } %>


                                                                    <% if (item.medicines) { %>

                                                                        <div class="info-box">

                                                                            <span class="info-title">
                                                                                Medicines
