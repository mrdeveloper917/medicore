<%- include("../layouts/patientHeader", { title: "Payments" }) %>

<style>
    :root {
        --primary: #2563eb;
        --primary-dark: #1d4ed8;
        --success: #16a34a;
        --warning: #d97706;
        --danger: #dc2626;
        --text: #172033;
        --muted: #64748b;
        --border: #e5e7eb;
        --background: #f8fafc;
        --white: #ffffff;
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        background: var(--background);
        color: var(--text);
        font-family:
            Inter,
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
    }

    .payments-page {
        max-width: 1380px;
        margin: auto;
        padding: 32px;
    }

    /* =========================
       HEADER
    ========================= */

    .payments-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .header-content {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-icon {
        width: 54px;
        height: 54px;
        border-radius: 15px;
        background: #eff6ff;
        color: var(--primary);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 22px;
    }

    .header-content h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 750;
        letter-spacing: -0.5px;
    }

    .header-content p {
        margin: 5px 0 0;
        color: var(--muted);
        font-size: 14px;
    }

    .refresh-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 16px;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: white;
        color: var(--text);
        font-weight: 600;
        cursor: pointer;
        transition: .2s ease;
    }

    .refresh-btn:hover {
        color: var(--primary);
        border-color: #bfdbfe;
    }


    /* =========================
       SECURITY NOTICE
    ========================= */

    .security-notice {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 16px 18px;
        margin-bottom: 25px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 13px;
        color: #1e40af;
    }

    .security-notice i {
        margin-top: 2px;
        font-size: 17px;
    }

    .security-notice strong {
        display: block;
        margin-bottom: 3px;
        font-size: 13px;
    }

    .security-notice p {
        margin: 0;
        font-size: 12px;
        line-height: 1.5;
    }


    /* =========================
       SUMMARY
    ========================= */

    .summary-grid {
        display: grid;
        grid-template-columns:
            repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 32px;
    }

    .summary-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 21px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow:
            0 8px 25px rgba(
                15,
                23,
                42,
                .05
            );
    }

    .summary-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        flex-shrink: 0;
        font-size: 18px;
    }

    .summary-icon.total {
        background: #eff6ff;
        color: #2563eb;
    }

    .summary-icon.paid {
        background: #f0fdf4;
        color: #16a34a;
    }

    .summary-icon.pending {
        background: #fff7ed;
        color: #d97706;
    }

    .summary-label {
        color: var(--muted);
        font-size: 12px;
        margin-bottom: 5px;
    }

    .summary-value {
        font-size: 23px;
        font-weight: 800;
    }


    /* =========================
       SECTION
    ========================= */

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .section-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 750;
    }

    .payment-count {
        color: var(--muted);
        font-size: 13px;
    }


    /* =========================
       PAYMENT CARD
    ========================= */

    .payment-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .payment-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 17px;
        padding: 21px;
        box-shadow:
            0 7px 25px rgba(
                15,
                23,
                42,
                .05
            );
        transition:
            transform .2s ease,
            box-shadow .2s ease;
    }

    .payment-card:hover {
        transform: translateY(-2px);
        box-shadow:
            0 14px 35px rgba(
                15,
                23,
                42,
                .08
            );
    }


    /* =========================
       CARD TOP
    ========================= */

    .payment-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
    }

    .doctor-section {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .doctor-avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        overflow: hidden;
        background: #eff6ff;
        color: var(--primary);

        display: flex;
        justify-content: center;
        align-items: center;

        font-size: 18px;
        font-weight: 800;
        flex-shrink: 0;
    }

    .doctor-avatar img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .doctor-name {
        margin: 0 0 4px;
        font-size: 16px;
        font-weight: 750;
    }

    .doctor-specialization {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
    }


    /* =========================
       STATUS
    ========================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 11px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 750;
        white-space: nowrap;
    }

    .status-paid {
        background: #dcfce7;
        color: #166534;
    }

    .status-pending {
        background: #ffedd5;
        color: #9a3412;
    }


    /* =========================
       DETAILS
    ========================= */

    .payment-details {
        display: grid;
        grid-template-columns:
            repeat(4, 1fr);
        gap: 15px;
        margin-top: 20px;
        padding-top: 18px;
        border-top:
            1px solid var(--border);
    }

    .detail-label {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 6px;
        color: var(--muted);
        font-size: 12px;
    }

    .detail-value {
        color: var(--text);
        font-size: 13px;
        font-weight: 650;
    }

    .amount-value {
        font-size: 19px;
        font-weight: 800;
    }


    /* =========================
       FOOTER
    ========================= */

    .payment-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 18px;
        padding-top: 16px;
        border-top:
            1px solid var(--border);
    }

    .payment-reference {
        color: var(--muted);
        font-size: 11px;
        word-break: break-all;
    }

    .payment-reference strong {
        color: var(--text);
    }


    /* =========================
       PAY BUTTON
    ========================= */

    .pay-btn {
        min-width: 155px;
        border: none;
        border-radius: 10px;
        padding: 12px 18px;
        background: var(--primary);
        color: white;
        font-size: 13px;
        font-weight: 750;
        cursor: pointer;

        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 8px;

        transition: .2s ease;
    }

    .pay-btn:hover {
        background: var(--primary-dark);
        transform: translateY(-1px);
    }

    .pay-btn:disabled {
        opacity: .65;
        cursor: not-allowed;
        transform: none;
    }

    .paid-label {
        color: var(--success);
        font-size: 13px;
        font-weight: 750;

        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

    .unavailable-label {
        color: var(--muted);
        font-size: 13px;
        font-weight: 650;

        display: inline-flex;
        align-items: center;
        gap: 7px;
    }


    /* =========================
       EMPTY
    ========================= */

    .empty-state {
        background: white;
        border: 1px solid var(--border);
        border-radius: 17px;
        padding: 65px 25px;
        text-align: center;
    }

    .empty-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        margin: 0 auto 18px;

        display: flex;
        align-items: center;
        justify-content: center;

        background: #eff6ff;
        color: var(--primary);

        font-size: 27px;
    }

    .empty-state h3 {
        margin: 0 0 8px;
        font-size: 18px;
    }

    .empty-state p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
    }


    /* =========================
       TOAST
    ========================= */

    .payment-toast {
        position: fixed;
        right: 24px;
        bottom: 24px;
        max-width: 390px;
        padding: 14px 17px;
        border-radius: 12px;
        background: #0f172a;
        color: white;

        display: flex;
        align-items: flex-start;
        gap: 10px;

        opacity: 0;
        visibility: hidden;
        transform: translateY(15px);
        transition: .25s ease;

        z-index: 9999;
        font-size: 13px;
    }

    .payment-toast.show {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .payment-toast.success {
        background: #166534;
    }

    .payment-toast.error {
        background: #991b1b;
    }

    .payment-toast.warning {
        background: #92400e;
    }


    /* =========================
       ACCESSIBILITY / UX
    ========================= */

    .refresh-btn:focus-visible,
    .pay-btn:focus-visible {
        outline: 3px solid rgba(37, 99, 235, .25);
        outline-offset: 2px;
    }

    .payment-card.is-processing {
        pointer-events: none;
    }

    .payment-card.is-processing .pay-btn {
        opacity: .75;
    }

    @media (prefers-reduced-motion: reduce) {
        .payment-card,
        .pay-btn,
        .refresh-btn,
        .payment-toast {
            transition: none !important;
        }

        .payment-card:hover,
        .pay-btn:hover {
            transform: none;
        }
    }


    /* =========================
       RESPONSIVE
    ========================= */

    @media (max-width: 1000px) {

        .summary-grid {
            grid-template-columns:
                repeat(2, 1fr);
        }

        .payment-details {
            grid-template-columns:
                repeat(2, 1fr);
        }
    }


    @media (max-width: 700px) {

        .payments-page {
            padding: 18px;
        }

        .payments-header {
            align-items: flex-start;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .payment-top {
            flex-direction: column;
        }

        .payment-details {
            grid-template-columns:
                repeat(2, 1fr);
        }

        .payment-footer {
            flex-direction: column;
            align-items: flex-start;
        }

        .pay-btn {
            width: 100%;
        }
    }


    @media (max-width: 480px) {

        .payments-page {
            padding: 14px;
        }

        .header-content h1 {
            font-size: 23px;
        }

        .header-icon {
            width: 45px;
            height: 45px;
        }

        .payment-details {
            grid-template-columns: 1fr;
        }

        .refresh-btn span {
            display: none;
        }
    }

</style>


<div class="payments-page">

    <!-- ======================================================
         HEADER
    ======================================================= -->

    <div class="payments-header">

        <div class="header-content">

            <div class="header-icon">
                <i class="fa-solid fa-wallet"></i>
            </div>

            <div>

                <h1>
                    Payments
                </h1>

                <p>
                    Manage consultation payments and transaction history
                </p>

            </div>

        </div>


        <button
            type="button"
            class="refresh-btn"
            aria-label="Refresh payment history"
            onclick="window.location.reload()"
        >

            <i class="fa-solid fa-rotate-right"></i>

            <span>
                Refresh
            </span>

        </button>

    </div>


    <!-- ======================================================
         SECURITY NOTICE
    ======================================================= -->

    <div class="security-notice">

        <i class="fa-solid fa-shield-halved"></i>

        <div>

            <strong>
                Secure Payments
            </strong>

            <p>
                Your consultation payments are securely processed
                through Razorpay. Payment status is updated only
                after successful verification.
            </p>

        </div>

    </div>


    <!-- ======================================================
         SUMMARY
    ======================================================= -->

    <%
        let totalAmount = 0;
        let paidAmount = 0;
        let pendingAmount = 0;

        if (payments && payments.length) {

            payments.forEach(function(payment) {

                const amount =
                    Number(payment.amount || 0);

                totalAmount += amount;

                if (
                    String(payment.status || "").toLowerCase()
                    === "paid"
                ) {
                    paidAmount += amount;
                }

                if (
                    String(payment.status || "").toLowerCase()
                    === "pending"
                ) {
                    pendingAmount += amount;
                }

            });

        }
    %>


    <div class="summary-grid">

        <!-- TOTAL -->

        <div class="summary-card">

            <div class="summary-icon total">

                <i class="fa-solid fa-indian-rupee-sign"></i>

            </div>

            <div>

                <div class="summary-label">
                    Total Amount
                </div>

                <div class="summary-value">

                    ₹<%= totalAmount.toLocaleString("en-IN") %>

                </div>

            </div>

        </div>


        <!-- PAID -->

        <div class="summary-card">

            <div class="summary-icon paid">

                <i class="fa-solid fa-circle-check"></i>

            </div>

            <div>

                <div class="summary-label">
                    Paid Amount
                </div>

                <div class="summary-value">

                    ₹<%= paidAmount.toLocaleString("en-IN") %>

                </div>

            </div>

        </div>


        <!-- PENDING -->

        <div class="summary-card">

            <div class="summary-icon pending">

                <i class="fa-solid fa-clock"></i>

            </div>

            <div>

                <div class="summary-label">
                    Pending Amount
                </div>

                <div class="summary-value">

                    ₹<%= pendingAmount.toLocaleString("en-IN") %>

                </div>

            </div>

        </div>

    </div>


    <!-- ======================================================
         SECTION HEADER
    ======================================================= -->

    <div class="section-header">

        <h2>
            Payment History
        </h2>

        <span class="payment-count">

            <%= payments ? payments.length : 0 %>

            <%= payments &&
                payments.length === 1
                    ? "transaction"
                    : "transactions"
            %>

        </span>

    </div>


    <!-- ======================================================
         PAYMENT LIST
    ======================================================= -->

    <% if (
        payments &&
        payments.length > 0
    ) { %>


        <div class="payment-list">


            <% payments.forEach(function(payment) {

                const doctor =
                    payment.doctor;

                const appointment =
                    payment.appointment;


                let doctorName =
                    "Doctor";


                if (doctor) {

                    doctorName =
                        `Dr. ${
                            doctor.firstName || ""
                        } ${
                            doctor.lastName || ""
                        }`.trim();

                }


                let appointmentDate =
                    "N/A";


                if (
                    appointment &&
                    appointment.appointmentDate
                ) {

                    appointmentDate =
                        new Date(
                            appointment.appointmentDate
                        ).toLocaleDateString(
                            "en-IN",
                            {
                                day: "2-digit",
                                month: "short",
                                year: "numeric"
                            }
                        );

                }


                const paymentDate =
                    payment.paidAt
                        ? new Date(
                            payment.paidAt
                        ).toLocaleDateString(
                            "en-IN",
                            {
                                day: "2-digit",
                                month: "short",
                                year: "numeric"
                            }
                        )
                        : payment.createdAt
                            ? new Date(
                                payment.createdAt
                            ).toLocaleDateString(
                                "en-IN",
                                {
                                    day: "2-digit",
                                    month: "short",
                                    year: "numeric"
                                }
                            )
                            : "N/A";


                let initials = "DR";


                if (doctor) {

                    const first =
                        doctor.firstName
                            ? doctor.firstName.charAt(0)
                            : "";

                    const last =
                        doctor.lastName
                            ? doctor.lastName.charAt(0)
                            : "";

                    initials =
                        (
                            first +
                            last ||
                            "DR"
                        ).toUpperCase();

                }

            %>


                <!-- ==================================================
                     PAYMENT CARD
                =================================================== -->

                <div class="payment-card">


                    <!-- TOP -->

                    <div class="payment-top">


                        <div class="doctor-section">

                            <div class="doctor-avatar">

                                <% if (
                                    doctor &&
                                    doctor.profileImage
                                ) { %>

                                    <img
                                        src="<%= doctor.profileImage %>"
                                        alt="Doctor"
                                    >

                                <% } else { %>

                                    <%= initials %>

                                <% } %>

                            </div>


                            <div>

                                <h3 class="doctor-name">

                                    <%= doctorName %>

                                </h3>

                                <p class="doctor-specialization">

                                    <%= doctor &&
                                        doctor.specialization
                                            ? doctor.specialization
                                            : "Medical Consultation"
                                    %>

                                </p>

                            </div>

                        </div>


                        <!-- PAYMENT STATUS -->

                        <% if (
                            String(payment.status || "").toLowerCase()
                            === "paid"
                        ) { %>

                            <span
                                class="status-badge status-paid"
                            >

                                <i class="fa-solid fa-circle-check"></i>

                                Paid

                            </span>

                        <% } else { %>

                            <span
                                class="status-badge status-pending"
                            >

                                <i class="fa-solid fa-clock"></i>

                                Pending

                            </span>

                        <% } %>

                    </div>


                    <!-- DETAILS -->

                    <div class="payment-details">


                        <!-- AMOUNT -->

                        <div>

                            <div class="detail-label">

                                <i class="fa-solid fa-indian-rupee-sign"></i>

                                Amount

                            </div>

                            <div class="detail-value amount-value">

                                ₹<%= Number(
                                    payment.amount || 0
                                ).toLocaleString("en-IN") %>

                            </div>

                        </div>


                        <!-- APPOINTMENT -->

                        <div>

                            <div class="detail-label">

                                <i class="fa-regular fa-calendar"></i>

                                Appointment

                            </div>

                            <div class="detail-value">

                                <%= appointmentDate %>

                                <% if (
                                    appointment &&
                                    appointment.appointmentTime
                                ) { %>

                                    <br>

                                    <span
                                        style="
                                            color:#64748b;
                                            font-weight:500;
                                        "
                                    >

                                        <%= appointment.appointmentTime %>

                                    </span>

                                <% } %>

                            </div>

                        </div>


                        <!-- DEPARTMENT -->

                        <div>

                            <div class="detail-label">

                                <i class="fa-solid fa-stethoscope"></i>

                                Department

                            </div>

                            <div class="detail-value">

                                <%= appointment &&
                                    appointment.department
                                        ? appointment.department
                                        : "Consultation"
                                %>

                            </div>

                        </div>


                        <!-- DATE -->

                        <div>

                            <div class="detail-label">

                                <i class="fa-regular fa-calendar-check"></i>

                                <%= String(payment.status || "").toLowerCase()
                                    === "paid"
                                        ? "Paid On"
                                        : "Created On"
                                %>

                            </div>

                            <div class="detail-value">

                                <%= paymentDate %>

                            </div>

                        </div>

                    </div>


                    <!-- FOOTER -->

                    <div class="payment-footer">


                        <!-- REFERENCE -->

                        <div class="payment-reference">

                            <% if (
                                payment.razorpayPaymentId
                            ) { %>

                                Payment ID:

                                <strong>
                                    <%= payment.razorpayPaymentId %>
                                </strong>

                            <% } else if (
                                payment.razorpayOrderId
                            ) { %>

                                Order ID:

                                <strong>
                                    <%= payment.razorpayOrderId %>
                                </strong>

                            <% } else { %>

                                Reference:

                                <strong>
                                    #<%= payment._id %>
                                </strong>

                            <% } %>

                        </div>


                        <!-- ACTION -->

                        <div>

                            <!-- PAID -->

                            <% if (
                                String(payment.status || "").toLowerCase()
                                === "paid"
                            ) { %>

                                <span class="paid-label">

                                    <i class="fa-solid fa-circle-check"></i>

                                    Payment Completed

                                </span>


                            <!-- PENDING -->

                            <% } else if (
                                String(payment.status || "").toLowerCase()
                                === "pending" &&
                                appointment &&
                                String(appointment.status || "").toLowerCase()
                                !== "cancelled"
                            ) { %>

                                <button
                                    type="button"
                                    class="pay-btn"
                                    data-appointment-id="<%= appointment._id %>"
                                    onclick="
                                        payAppointment(
                                            '<%= appointment._id %>',
                                            this
                                        )
                                    "
                                >

                                    <i class="fa-solid fa-credit-card"></i>

                                    Pay ₹<%= Number(
                                        payment.amount || 0
                                    ).toLocaleString("en-IN") %>

                                </button>


                            <!-- CANCELLED / UNAVAILABLE -->

                            <% } else { %>

                                <span class="unavailable-label">

                                    <i class="fa-solid fa-ban"></i>

                                    Payment Unavailable

                                </span>

                            <% } %>

                        </div>

                    </div>

                </div>


            <% }); %>

        </div>


    <% } else { %>


        <!-- EMPTY -->

        <div class="empty-state">

            <div class="empty-icon">

                <i class="fa-solid fa-wallet"></i>

            </div>

            <h3>
                No Payment Records
            </h3>

            <p>
                Your consultation payment history
                will appear here after booking an appointment.
            </p>

        </div>

    <% } %>

</div>


<!-- =========================================================
     TOAST
========================================================= -->

<div
    id="paymentToast"
    class="payment-toast"
    role="status"
    aria-live="polite"
>

    <i id="toastIcon"></i>

    <span id="toastMessage"></span>

</div>


<!-- =========================================================
     RAZORPAY
========================================================= -->

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<script>

    /* =========================================================
       TOAST
    ========================================================= */

    function showPaymentToast(
        message,
        type = "success"
    ) {

        const toast =
            document.getElementById(
                "paymentToast"
            );

        const messageElement =
            document.getElementById(
                "toastMessage"
            );

        const icon =
            document.getElementById(
                "toastIcon"
            );

        if (!toast || !messageElement || !icon) {
            return;
        }

        messageElement.textContent =
            message;

        toast.className =
            `payment-toast show ${type}`;

        if (type === "success") {

            icon.className =
                "fa-solid fa-circle-check";

        } else if (type === "warning") {

            icon.className =
                "fa-solid fa-triangle-exclamation";

        } else {

            icon.className =
                "fa-solid fa-circle-exclamation";

        }

        clearTimeout(
            window.paymentToastTimer
        );

        window.paymentToastTimer =
            setTimeout(
                () => {

                    toast.classList.remove(
                        "show"
                    );

                },
                4500
            );

    }


    /* =========================================================
       RESET PAYMENT BUTTON
    ========================================================= */

    function resetPaymentButton(
        button
    ) {

        if (!button) {
            return;
        }

        button.disabled =
            false;

        const paymentCard =
            button.closest(".payment-card");

        if (paymentCard) {
            paymentCard.classList.remove(
                "is-processing"
            );
        }

        button.innerHTML = `
            <i class="fa-solid fa-credit-card"></i>
            Pay Now
        `;

    }


    /* =========================================================
       PAY APPOINTMENT
    ========================================================= */

    async function payAppointment(
        appointmentId,
        button
    ) {

        if (!appointmentId) {

            showPaymentToast(
                "Appointment ID is missing.",
                "error"
            );

            return;

        }


        try {

            /* =================================================
               PREVENT DOUBLE CLICK
            ================================================= */

            if (
                button &&
                button.disabled
            ) {
                return;
            }


            /* =================================================
               LOADING STATE
            ================================================= */

            if (button) {

                button.disabled =
                    true;

                const paymentCard =
                    button.closest(".payment-card");

                if (paymentCard) {
                    paymentCard.classList.add(
                        "is-processing"
                    );
                }

                button.innerHTML = `
                    <i class="fa-solid fa-spinner fa-spin"></i>
                    Creating Order...
                `;

            }


            /* =================================================
               CREATE RAZORPAY ORDER
            ================================================= */

            const response =
                await fetch(
                    "/patient/payments/create-order",
                    {
                        method: "POST",

                        headers: {
                            "Content-Type":
                                "application/json",

                            "Accept":
                                "application/json"
                        },

                        credentials:
                            "same-origin",

                        body:
                            JSON.stringify({
                                appointmentId:
                                    appointmentId
                            })
                    }
                );


            /* =================================================
               HANDLE SERVER RESPONSE
            ================================================= */

            const contentType =
                response.headers.get(
                    "content-type"
                ) || "";

            let data = {};

            if (
                contentType.includes(
                    "application/json"
                )
            ) {

                data =
                    await response.json();

            } else {

                const rawText =
                    await response.text();

                throw new Error(
                    response.status === 401
                        ? "Your session has expired. Please log in again."
                        : response.status === 403
                            ? "You are not authorized to make this payment."
                            : rawText ||
                              "Unable to create payment order."
                );

            }


            /* =================================================
               VALIDATE SERVER RESPONSE
            ================================================= */

            if (
                !response.ok ||
                !data.success
            ) {

                throw new Error(
                    data.message ||
                    "Unable to create payment order."
                );

            }


            /* =================================================
               VALIDATE PAYMENT ORDER
            ================================================= */

            if (
                !data.order ||
                !data.order.id ||
                !data.order.amount
            ) {

                throw new Error(
                    "Invalid payment order received from server."
                );

            }


            /* =================================================
               CHECK RAZORPAY
            ================================================= */

            if (
                typeof Razorpay ===
                "undefined"
            ) {

                throw new Error(
                    "Razorpay checkout could not be loaded."
                );

            }


            /* =================================================
               RAZORPAY OPTIONS
            ================================================= */

            const options = {

                key:
                    data.key,

                amount:
                    data.order.amount,

                currency:
                    data.order.currency ||
                    "INR",

                name:
                    "MediCore",

                description:
                    "Doctor Consultation Payment",

                order_id:
                    data.order.id,


                /* =============================================
                   PREFILL PATIENT DETAILS
                ============================================= */

                prefill: {

                    name:
                        data.patient?.name ||
                        "",

                    email:
                        data.patient?.email ||
                        "",

                    contact:
                        data.patient?.contact ||
                        ""

                },


                /* =============================================
                   NOTES
                ============================================= */

                notes: {

                    paymentId:
                        data.payment?.id ||
                        "",

                    appointmentId:
                        appointmentId

                },


                /* =============================================
                   THEME
                ============================================= */

                theme: {

                    color:
                        "#2563eb"

                },


                /* =============================================
                   PAYMENT SUCCESS
                ============================================= */

                handler:
                    async function(
                        razorpayResponse
                    ) {

                        try {

                            if (button) {

                                button.innerHTML = `
                                    <i class="fa-solid fa-spinner fa-spin"></i>
                                    Verifying Payment...
                                `;

                            }


                            /* =================================
                               VALIDATE RAZORPAY RESPONSE
                            ================================= */

                            if (
                                !razorpayResponse ||
                                !razorpayResponse
                                    .razorpay_payment_id ||
                                !razorpayResponse
                                    .razorpay_signature
                            ) {

                                throw new Error(
                                    "Incomplete payment verification data."
                                );

                            }


                            /* =================================
                               VERIFY PAYMENT
                            ================================= */

                            const verifyResponse =
                                await fetch(
                                    "/patient/payments/verify",
                                    {

                                        method:
                                            "POST",

                                        headers: {

                                            "Content-Type":
                                                "application/json",

                                            "Accept":
                                                "application/json"

                                        },

                                        credentials:
                                            "same-origin",

                                        body:
                                            JSON.stringify({

                                                paymentId:
                                                    data.payment?.id,

                                                razorpayPaymentId:
                                                    razorpayResponse
                                                        .razorpay_payment_id,

                                                razorpaySignature:
                                                    razorpayResponse
                                                        .razorpay_signature

                                            })

                                    }
                                );


                            /* =================================
                               HANDLE VERIFY RESPONSE
                            ================================= */

                            const verifyContentType =
                                verifyResponse.headers.get(
                                    "content-type"
                                ) || "";

                            let verifyData = {};

                            if (
                                verifyContentType.includes(
                                    "application/json"
                                )
                            ) {

                                verifyData =
                                    await verifyResponse.json();

                            } else {

                                const rawVerifyText =
                                    await verifyResponse.text();

                                throw new Error(
                                    rawVerifyText ||
                                    "Payment verification failed."
                                );

                            }


                            /* =================================
                               VERIFY RESULT
                            ================================= */

                            if (
                                !verifyResponse.ok ||
                                !verifyData.success
                            ) {

                                throw new Error(
                                    verifyData.message ||
                                    "Payment verification failed."
                                );

                            }


                            /* =================================
                               SUCCESS
                            ================================= */

                            showPaymentToast(
                                "Payment successful and verified!",
                                "success"
                            );


                            if (button) {

                                button.disabled =
                                    true;

                                button.innerHTML = `
                                    <i class="fa-solid fa-circle-check"></i>
                                    Payment Successful
                                `;

                            }


                            /* =================================
                               REFRESH PAYMENT HISTORY
                            ================================= */

                            setTimeout(
                                () => {

                                    window.location.reload();

                                },
                                1200
                            );


                        } catch (error) {

                            console.error(
                                "Payment Verification Error:",
                                error
                            );


                            showPaymentToast(
                                error.message ||
                                "Payment verification failed.",
                                "error"
                            );


                            resetPaymentButton(
                                button
                            );

                        }

                    },


                /* =============================================
                   CHECKOUT CLOSED
                ============================================= */

                modal: {

                    ondismiss:
                        function() {

                            resetPaymentButton(
                                button
                            );


                            showPaymentToast(
                                "Payment window closed.",
                                "warning"
                            );

                        }

                }

            };


            /* =================================================
               CREATE RAZORPAY INSTANCE
            ================================================= */

            const razorpay =
                new Razorpay(
                    options
                );


            /* =================================================
               PAYMENT FAILED
            ================================================= */

            razorpay.on(
                "payment.failed",
                function(response) {

                    console.error(
                        "Razorpay Payment Failed:",
                        response
                    );


                    const errorDescription =
                        response?.error?.description ||
                        response?.error?.reason ||
                        "Payment failed. Please try again.";


                    showPaymentToast(
                        errorDescription,
                        "error"
                    );


                    resetPaymentButton(
                        button
                    );

                }
            );


            /* =================================================
               OPEN RAZORPAY CHECKOUT
            ================================================= */

            razorpay.open();


        } catch (error) {

            console.error(
                "Payment Error:",
                error
            );


            showPaymentToast(
                error.message ||
                "Unable to start payment.",
                "error"
            );


            resetPaymentButton(
                button
            );

        }

    }

</script>


