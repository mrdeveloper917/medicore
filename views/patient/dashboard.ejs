
<%- include("../layouts/patientHeader", {
    title: "Patient Dashboard",
    user: user
}) %>

<style>

/* =========================================================
   MEDICORE PATIENT DASHBOARD
   Premium • Clean • Responsive
   ========================================================= */

.content {
    width: 100%;
    max-width: 1500px;
    margin: 0 auto;
    padding: 28px 30px 55px;
}


/* =========================================================
   WELCOME BANNER
   ========================================================= */

.welcome-banner {
    position: relative;
    overflow: hidden;

    min-height: 275px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 38px 45px;

    margin-bottom: 24px;

    border-radius: 25px;

    background:
        radial-gradient(
            circle at 85% 20%,
            rgba(255,255,255,.18),
            transparent 30%
        ),
        linear-gradient(
            135deg,
            #0f766e,
            #0d9488 55%,
            #14b8a6
        );

    box-shadow:
        0 18px 45px rgba(15,118,110,.20);

    color: #fff;
}

.welcome-banner::before {
    content: "";

    position: absolute;

    width: 260px;
    height: 260px;

    right: 210px;
    top: -150px;

    border-radius: 50%;

    background: rgba(255,255,255,.07);
}

.welcome-banner::after {
    content: "";

    position: absolute;

    width: 180px;
    height: 180px;

    right: 35px;
    bottom: -115px;

    border-radius: 50%;

    background: rgba(255,255,255,.07);
}

.welcome-left {
    position: relative;
    z-index: 2;

    max-width: 680px;
}

.welcome-label {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    padding: 7px 11px;

    margin-bottom: 13px;

    border-radius: 20px;

    background: rgba(255,255,255,.13);

    border: 1px solid rgba(255,255,255,.20);

    font-size: 10px;
    font-weight: 800;

    letter-spacing: 1px;
    text-transform: uppercase;
}

.welcome-label::before {
    content: "";

    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: #a7f3d0;
}

.welcome-left h1 {
    margin: 0 0 12px;

    font-size: 34px;
    line-height: 1.25;

    font-weight: 800;

    letter-spacing: -.6px;
}

.welcome-left p {
    max-width: 600px;

    margin: 0 0 25px;

    color: rgba(255,255,255,.88);

    font-size: 13px;
    line-height: 1.8;
}

.welcome-actions {
    display: flex;
    align-items: center;
    gap: 10px;

    flex-wrap: wrap;
}

.welcome-actions .primary-btn,
.welcome-actions .secondary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    min-height: 42px;

    padding: 11px 17px;

    border-radius: 11px;

    text-decoration: none;

    font-size: 11px;
    font-weight: 750;

    transition: .2s ease;
}

.welcome-actions .primary-btn {
    background: #fff;

    color: #0f766e;

    box-shadow:
        0 8px 20px rgba(0,0,0,.10);
}

.welcome-actions .primary-btn:hover {
    transform: translateY(-3px);

    box-shadow:
        0 12px 25px rgba(0,0,0,.16);
}

.welcome-actions .secondary-btn {
    color: #fff;

    background: rgba(255,255,255,.11);

    border: 1px solid rgba(255,255,255,.27);
}

.welcome-actions .secondary-btn:hover {
    background: rgba(255,255,255,.18);

    transform: translateY(-3px);
}

.welcome-right {
    position: relative;
    z-index: 2;

    width: 285px;

    display: flex;
    align-items: center;
    justify-content: center;
}

.welcome-right img {
    width: 100%;
    max-width: 270px;

    max-height: 230px;

    object-fit: contain;

    filter:
        drop-shadow(0 18px 24px rgba(0,0,0,.15));

    transform: translateY(10px);
}


/* =========================================================
   IDENTITY VERIFICATION
   ========================================================= */

.identity-alert {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 18px;

    padding: 16px 19px;

    margin-bottom: 18px;

    border-radius: 15px;

    border: 1px solid #fed7aa;

    background:
        linear-gradient(
            135deg,
            #fffaf5,
            #fff7ed
        );

    box-shadow:
        0 5px 18px rgba(234,88,12,.05);
}

.identity-content {
    display: flex;
    align-items: center;

    gap: 13px;
}

.identity-icon {
    width: 42px;
    height: 42px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background: #ffedd5;

    color: #ea580c;
}

.identity-content strong {
    display: block;

    margin-bottom: 3px;

    color: #9a3412;

    font-size: 12px;
}

.identity-content p {
    margin: 0;

    color: #9a3412;

    font-size: 10px;
    line-height: 1.5;
}

.verify-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;

    padding: 9px 14px;

    border-radius: 9px;

    background: #ea580c;

    color: #fff;

    text-decoration: none;

    font-size: 10px;
    font-weight: 750;

    white-space: nowrap;

    transition: .2s ease;
}

.verify-btn:hover {
    background: #c2410c;

    transform: translateY(-2px);
}

.identity-success {
    display: flex;
    align-items: center;
    gap: 12px;

    padding: 15px 18px;

    margin-bottom: 20px;

    border-radius: 15px;

    background: #ecfdf5;

    border: 1px solid #bbf7d0;

    color: #047857;

    font-size: 11px;
}

.identity-success-icon {
    width: 35px;
    height: 35px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    background: #d1fae5;

    color: #059669;
}


/* =========================================================
   STATISTICS
   ========================================================= */

.stats-grid {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0,1fr));

    gap: 17px;

    margin-bottom: 25px;
}

.stat-card {
    position: relative;
    overflow: hidden;

    display: flex;
    align-items: center;

    gap: 14px;

    min-height: 105px;

    padding: 19px;

    border: 1px solid #e8edf3;

    border-radius: 18px;

    background: #fff;

    box-shadow:
        0 7px 24px rgba(15,23,42,.045);

    transition:
        transform .2s ease,
        box-shadow .2s ease;
}

.stat-card::after {
    content: "";

    position: absolute;

    right: -35px;
    bottom: -45px;

    width: 115px;
    height: 115px;

    border-radius: 50%;

    background: #f8fafc;
}

.stat-card:hover {
    transform: translateY(-4px);

    box-shadow:
        0 14px 30px rgba(15,23,42,.08);
}

.stat-icon {
    position: relative;
    z-index: 2;

    width: 50px;
    height: 50px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 14px;

    font-size: 18px;
}

.stat-icon.blue {
    background: #eaf2ff;
    color: #2563eb;
}

.stat-icon.green {
    background: #e7f8f3;
    color: #0f766e;
}

.stat-icon.purple {
    background: #f3edff;
    color: #7c3aed;
}

.stat-icon.orange {
    background: #fff3e6;
    color: #ea580c;
}

.stat-card h2 {
    position: relative;
    z-index: 2;

    margin: 0 0 4px;

    font-size: 23px;
    font-weight: 800;

    color: #172033;
}

.stat-card p {
    position: relative;
    z-index: 2;

    margin: 0;

    font-size: 10px;
    font-weight: 650;

    color: #667085;
}


/* =========================================================
   DASHBOARD GRID
   ========================================================= */

.dashboard-grid {
    display: grid;

    grid-template-columns:
        minmax(0,1.35fr)
        minmax(330px,.85fr);

    gap: 21px;

    margin-bottom: 21px;
}


/* =========================================================
   DASHBOARD CARD
   ========================================================= */

.dashboard-card {
    min-width: 0;

    padding: 22px;

    border: 1px solid #e8edf3;

    border-radius: 20px;

    background: #fff;

    box-shadow:
        0 7px 25px rgba(15,23,42,.045);

    transition:
        box-shadow .2s ease,
        transform .2s ease;
}

.dashboard-card:hover {
    box-shadow:
        0 13px 32px rgba(15,23,42,.065);
}


/* =========================================================
   CARD HEADER
   ========================================================= */

.card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 15px;

    margin-bottom: 20px;

    padding-bottom: 15px;

    border-bottom: 1px solid #eef1f4;
}

.card-label {
    display: block;

    margin-bottom: 4px;

    color: #98a2b3;

    font-size: 9px;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: .9px;
}

.card-header h3 {
    margin: 0;

    color: #172033;

    font-size: 17px;
    font-weight: 800;
}

.view-all {
    display: inline-flex;
    align-items: center;
    gap: 6px;

    color: #0f766e;

    text-decoration: none;

    font-size: 10px;
    font-weight: 750;

    white-space: nowrap;
}

.view-all::after {
    content: "→";

    font-size: 14px;
}

.view-all:hover {
    color: #075e58;
}


/* =========================================================
   UPCOMING APPOINTMENT
   ========================================================= */

.appointment-box {
    position: relative;
}

.appointment-doctor {
    display: flex;
    align-items: center;

    gap: 13px;

    margin-bottom: 18px;
}

.doctor-avatar {
    width: 60px;
    height: 60px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border-radius: 16px;

    background: #eaf8f6;

    color: #0f766e;

    font-size: 21px;
    font-weight: 800;

    border: 1px solid #d4eeea;
}

.doctor-avatar img {
    width: 100%;
    height: 100%;

    object-fit: cover;
}

.appointment-doctor h4 {
    margin: 0 0 5px;

    color: #172033;

    font-size: 15px;
    font-weight: 800;
}

.appointment-doctor p {
    margin: 0;

    color: #0f766e;

    font-size: 10px;
    font-weight: 700;
}

.appointment-status {
    position: absolute;

    top: 0;
    right: 0;

    padding: 6px 10px;

    border-radius: 20px;

    font-size: 9px;
    font-weight: 800;

    background: #e7f8f3;
    color: #087f5b;
}

.appointment-info {
    display: grid;

    grid-template-columns:
        repeat(3,1fr);

    gap: 10px;

    padding: 16px 0;

    border-top: 1px solid #eef1f4;
    border-bottom: 1px solid #eef1f4;
}

.info-item {
    display: flex;
    align-items: center;

    gap: 8px;
}

.info-item > i {
    width: 30px;
    height: 30px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 9px;

    background: #eefbf9;

    color: #0f766e;

    font-size: 11px;
}

.info-item span {
    display: block;

    margin-bottom: 3px;

    color: #98a2b3;

    font-size: 8px;
    font-weight: 600;
}

.info-item strong {
    display: block;

    color: #344054;

    font-size: 10px;
    font-weight: 750;
}

.appointment-details-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;

    width: 100%;

    gap: 8px;

    margin-top: 15px;

    padding: 11px 13px;

    border-radius: 10px;

    background: #f0fdfa;

    color: #0f766e;

    text-decoration: none;

    font-size: 10px;
    font-weight: 750;

    transition: .2s ease;
}

.appointment-details-btn:hover {
    background: #dff7f2;

    transform: translateX(2px);
}


/* =========================================================
   ASSIGNED DOCTOR
   ========================================================= */

.assigned-doctor {
    display: flex;
    align-items: center;

    gap: 17px;

    min-height: 150px;
}

.large-doctor-avatar {
    width: 88px;
    height: 88px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border-radius: 22px;

    background: #eefbf9;

    color: #0f766e;

    font-size: 30px;
    font-weight: 800;

    border: 1px solid #d7efeb;
}

.large-doctor-avatar img {
    width: 100%;
    height: 100%;

    object-fit: cover;
}

.assigned-doctor-info {
    min-width: 0;
}

.assigned-doctor-info h4 {
    margin: 0 0 6px;

    color: #172033;

    font-size: 16px;
    font-weight: 800;
}

.assigned-doctor-info .specialization {
    margin: 0 0 10px;

    color: #0f766e;

    font-size: 10px;
    font-weight: 750;
}

.assigned-doctor-info p:not(.specialization) {
    display: flex;
    align-items: center;

    gap: 7px;

    margin: 6px 0;

    color: #667085;

    font-size: 9px;
}

.assigned-doctor-info i {
    width: 14px;

    color: #98a2b3;
}


/* =========================================================
   EMPTY STATES
   ========================================================= */

.empty-card,
.empty-table {
    text-align: center;

    padding: 35px 18px;
}

.empty-icon {
    width: 55px;
    height: 55px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin: 0 auto 12px;

    border-radius: 16px;

    background: #f0fdfa;

    color: #0f766e;

    font-size: 21px;
}

.empty-card h4,
.empty-table h4 {
    margin: 0 0 6px;

    color: #172033;

    font-size: 14px;
    font-weight: 800;
}

.empty-card p,
.empty-table p {
    max-width: 330px;

    margin: 0 auto 16px;

    color: #98a2b3;

    font-size: 10px;
    line-height: 1.6;
}

.primary-btn.small {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 7px;

    padding: 10px 14px;

    border-radius: 9px;

    background: #0f766e;

    color: #fff;

    text-decoration: none;

    font-size: 10px;
    font-weight: 750;

    transition: .2s ease;
}

.primary-btn.small:hover {
    background: #0b625c;

    transform: translateY(-2px);
}


/* =========================================================
   PRESCRIPTIONS TABLE
   ========================================================= */

.table-wrapper {
    width: 100%;

    overflow-x: auto;
}

.table {
    width: 100%;

    min-width: 600px;

    border-collapse: collapse;
}

.table th {
    padding: 11px 10px;

    background: #f8fafc;

    color: #98a2b3;

    border-bottom: 1px solid #e7ebef;

    text-align: left;

    font-size: 9px;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: .4px;
}

.table td {
    padding: 14px 10px;

    border-bottom: 1px solid #f0f2f5;

    color: #475467;

    font-size: 10px;
}

.table tbody tr {
    transition: .15s ease;
}

.table tbody tr:hover {
    background: #f8fbfc;
}

.table tbody tr:last-child td {
    border-bottom: none;
}

.badge.success {
    display: inline-flex;
    align-items: center;

    padding: 5px 9px;

    border-radius: 20px;

    background: #e7f8f3;

    color: #087f5b;

    font-size: 8px;
    font-weight: 800;
}


/* =========================================================
   NOTIFICATIONS
   ========================================================= */

.notification-list {
    list-style: none;

    margin: 0;
    padding: 0;
}

.notification-list li {
    display: flex;
    align-items: flex-start;

    gap: 12px;

    padding: 13px 0;

    border-bottom: 1px solid #f0f2f5;
}

.notification-list li:last-child {
    border-bottom: none;
}

.notification-icon {
    width: 38px;
    height: 38px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 11px;

    background: #eaf8f6;

    color: #0f766e;

    font-size: 12px;
}

.notification-content {
    flex: 1;

    min-width: 0;
}

.notification-content p {
    margin: 0 0 5px;

    color: #475467;

    font-size: 10px;
    line-height: 1.55;
}

.notification-content span {
    color: #98a2b3;

    font-size: 8px;
}


/* =========================================================
   QUICK ACTIONS
   ========================================================= */

.quick-actions {
    display: grid;

    grid-template-columns:
        repeat(6,minmax(0,1fr));

    gap: 13px;

    margin-top: 4px;
}

.quick-actions a {
    min-height: 90px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    gap: 9px;

    padding: 14px 8px;

    border: 1px solid #e7ebef;

    border-radius: 15px;

    background: #fff;

    color: #475467;

    text-decoration: none;

    box-shadow:
        0 5px 18px rgba(15,23,42,.035);

    transition: .2s ease;
}

.quick-actions a i {
    width: 37px;
    height: 37px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 11px;

    background: #eefbf9;

    color: #0f766e;

    font-size: 14px;

    transition: .2s ease;
}

.quick-actions a span {
    text-align: center;

    font-size: 9px;
    font-weight: 750;
}

.quick-actions a:hover {
    border-color: #b8e8e1;

    transform: translateY(-4px);

    color: #0f766e;

    box-shadow:
        0 13px 27px rgba(15,118,110,.09);
}

.quick-actions a:hover i {
    background: #0f766e;

    color: #fff;

    transform: scale(1.05);
}


/* =========================================================
   RESPONSIVE — 1150px
   ========================================================= */

@media (max-width: 1150px) {

    .stats-grid {
        grid-template-columns:
            repeat(2,1fr);
    }

    .quick-actions {
        grid-template-columns:
            repeat(3,1fr);
    }

    .welcome-banner {
        padding: 35px;
    }

}


/* =========================================================
   RESPONSIVE — 900px
   ========================================================= */

@media (max-width: 900px) {

    .content {
        padding: 22px;
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }

    .welcome-right {
        width: 220px;
    }

    .welcome-right img {
        max-width: 210px;
    }

}


/* =========================================================
   RESPONSIVE — 700px
   ========================================================= */

@media (max-width: 700px) {

    .content {
        padding: 16px;
    }

    .welcome-banner {
        min-height: auto;

        padding: 28px 23px;

        border-radius: 19px;
    }

    .welcome-left h1 {
        font-size: 27px;
    }

    .welcome-left p {
        font-size: 11px;
    }

    .welcome-right {
        display: none;
    }

    .appointment-info {
        grid-template-columns: 1fr;
    }

    .identity-alert {
        align-items: flex-start;
        flex-direction: column;
    }

    .verify-btn {
        width: 100%;

        justify-content: center;
    }

}


/* =========================================================
   RESPONSIVE — 550px
   ========================================================= */

@media (max-width: 550px) {

    .content {
        padding: 12px;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .dashboard-card {
        padding: 18px;

        border-radius: 17px;
    }

    .card-header h3 {
        font-size: 15px;
    }

    .assigned-doctor {
        align-items: flex-start;
    }

    .large-doctor-avatar {
        width: 70px;
        height: 70px;

        border-radius: 17px;

        font-size: 24px;
    }

    .quick-actions {
        grid-template-columns:
            repeat(2,1fr);
    }

    .welcome-actions {
        flex-direction: column;

        align-items: stretch;
    }

    .welcome-actions a {
        width: 100%;
    }

}


/* =========================================================
   RESPONSIVE — 400px
   ========================================================= */

@media (max-width: 400px) {

    .welcome-banner {
        padding: 23px 18px;
    }

    .welcome-left h1 {
        font-size: 23px;
    }

    .stat-card {
        min-height: 92px;

        padding: 16px;
    }

    .stat-icon {
        width: 44px;
        height: 44px;
    }

    .stat-card h2 {
        font-size: 20px;
    }

    .quick-actions a {
        min-height: 78px;
    }

}


/* =========================================================
   SMOOTH
   ========================================================= */

html {
    scroll-behavior: smooth;
}

::selection {
    background: #bdeee8;
    color: #064e49;
}

</style>


<div class="content">


    <!-- =====================================================
         WELCOME BANNER
         ===================================================== -->

    <section class="welcome-banner">

        <div class="welcome-left">

            <span class="welcome-label">
                MediCore Patient Portal
            </span>

            <h1>
                Welcome Back,
                <%= user.firstName || "Patient" %> 👋
            </h1>

            <p>
                Manage your appointments, prescriptions,
                payments and medical reports from one
                secure and professional healthcare portal.
            </p>

            <div class="welcome-actions">

                <a
                    href="/patient/book"
                    class="primary-btn"
                >
                    <i class="fa-solid fa-calendar-plus"></i>
                    Book Appointment
                </a>

                <a
                    href="/patient/appointments"
                    class="secondary-btn"
                >
                    <i class="fa-solid fa-calendar-check"></i>
                    My Appointments
                </a>

            </div>

        </div>


        <div class="welcome-right">

            <img
                src="/images/dashboard/patient.png"
                alt="Patient Dashboard"
            >

        </div>

    </section>


    <!-- =====================================================
         IDENTITY VERIFICATION
         ===================================================== -->

    <% if (identityRequired) { %>

        <section class="identity-alert">

            <div class="identity-content">

                <div class="identity-icon">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>

                <div>

                    <strong>
                        Identity verification required
                    </strong>

                    <p>
                        Complete identity verification before
                        accessing your medical history, reports
                        and prescriptions.
                    </p>

                </div>

            </div>


            <a
                href="/patient/identity"
                class="verify-btn"
            >
                <i class="fa-solid fa-user-shield"></i>
                Verify Identity
            </a>

        </section>

    <% } %>


    <% if (!canAccessProtected) { %>

        <section class="identity-alert">

            <div class="identity-content">

                <div class="identity-icon">
                    <i class="fa-solid fa-lock"></i>
                </div>

                <div>

                    <strong>
                        Protected medical information locked
                    </strong>

                    <p>
                        Verify your identity to unlock medical
                        history, reports and prescriptions.
                    </p>

                </div>

            </div>


            <a
                href="/patient/identity"
                class="verify-btn"
            >
                <i class="fa-solid fa-unlock"></i>
                Verify Now
            </a>

        </section>

    <% } else { %>

        <section class="identity-success">

            <div class="identity-success-icon">

                <i class="fa-solid fa-circle-check"></i>

            </div>

            <div>

                <strong>
                    Identity verified
                </strong>

                <span>
                    Your protected medical history,
                    reports and prescriptions are available.
                </span>

            </div>

        </section>

    <% } %>


    <!-- =====================================================
         STATISTICS
         ===================================================== -->

    <section class="stats-grid">


        <div class="stat-card">

            <div class="stat-icon blue">

                <i class="fa-solid fa-calendar-check"></i>

            </div>

            <div>

                <h2>
                    <%= stats?.upcomingAppointments || 0 %>
                </h2>

                <p>
                    Upcoming Appointments
                </p>

            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon green">

                <i class="fa-solid fa-user-doctor"></i>

            </div>

            <div>

                <h2>
                    <%= stats?.totalDoctors || 0 %>
                </h2>

                <p>
                    Doctors Consulted
                </p>

            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon purple">

                <i class="fa-solid fa-file-medical"></i>

            </div>

            <div>

                <h2>
                    <%= stats?.reports || 0 %>
                </h2>

                <p>
                    Medical Reports
                </p>

            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon orange">

                <i class="fa-solid fa-credit-card"></i>

            </div>

            <div>

                <h2>
                    ₹<%= stats?.pendingPayments || 0 %>
                </h2>

                <p>
                    Pending Payment
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         UPCOMING APPOINTMENT + ASSIGNED DOCTOR
         ===================================================== -->

    <div class="dashboard-grid">


        <!-- Upcoming Appointment -->

        <div class="dashboard-card">

            <div class="card-header">

                <div>

                    <span class="card-label">
                        Schedule
                    </span>

                    <h3>
                        Upcoming Appointment
                    </h3>

                </div>

                <a
                    href="/patient/appointments"
                    class="view-all"
                >
                    View All
                </a>

            </div>


            <% if (appointment) { %>

                <div class="appointment-box">


                    <div class="appointment-doctor">

                        <div class="doctor-avatar">

                            <% if (
                                appointment.doctor &&
                                appointment.doctor.profileImage
                            ) { %>

                                <img
                                    src="<%= appointment.doctor.profileImage %>"
                                    alt="Doctor"
                                >

                            <% } else { %>

                                <span>

                                    <%= appointment.doctor &&
                                        appointment.doctor.firstName
                                        ? appointment.doctor.firstName
                                            .charAt(0)
                                            .toUpperCase()
                                        : "D"
                                    %>

                                </span>

                            <% } %>

                        </div>


                        <div>

                            <h4>

                                Dr.
                                <%= appointment.doctor?.firstName || "" %>
                                <%= appointment.doctor?.lastName || "" %>

                            </h4>

                            <p>

                                <%= appointment.doctor?.specialization ||
                                    "General Physician"
                                %>

                            </p>

                        </div>

                    </div>


                    <span class="appointment-status">

                        <%= appointment.status %>

                    </span>


                    <div class="appointment-info">


                        <div class="info-item">

                            <i class="fa-solid fa-hospital"></i>

                            <div>

                                <span>
                                    Department
                                </span>

                                <strong>
                                    <%= appointment.department || "N/A" %>
                                </strong>

                            </div>

                        </div>


                        <div class="info-item">

                            <i class="fa-solid fa-calendar"></i>

                            <div>

                                <span>
                                    Date
                                </span>

                                <strong>

                                    <%= appointment.appointmentDate
                                        ? new Date(
                                            appointment.appointmentDate
                                          ).toLocaleDateString(
                                            "en-IN",
                                            {
                                                day: "numeric",
                                                month: "short",
                                                year: "numeric"
                                            }
                                          )
                                        : "N/A"
                                    %>

                                </strong>

                            </div>

                        </div>


                        <div class="info-item">

                            <i class="fa-solid fa-clock"></i>

                            <div>

                                <span>
                                    Time
                                </span>

                                <strong>
                                    <%= appointment.appointmentTime || "N/A" %>
                                </strong>

                            </div>

                        </div>

                    </div>


                    <a
                        href="/patient/appointment/<%= appointment._id %>"
                        class="appointment-details-btn"
                    >

                        <span>
                            View Appointment Details
                        </span>

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>


            <% } else { %>

                <div class="empty-card">

                    <div class="empty-icon">

                        <i class="fa-regular fa-calendar-xmark"></i>

                    </div>

                    <h4>
                        No Upcoming Appointment
                    </h4>

                    <p>
                        You don't have any approved upcoming
                        appointments.
                    </p>

                    <a
                        href="/patient/book"
                        class="primary-btn small"
                    >
                        <i class="fa-solid fa-calendar-plus"></i>
                        Book Appointment
                    </a>

                </div>

            <% } %>

        </div>


        <!-- Assigned Doctor -->

        <div class="dashboard-card">

            <div class="card-header">

                <div>

                    <span class="card-label">
                        Healthcare
                    </span>

                    <h3>
                        Assigned Doctor
                    </h3>

                </div>

            </div>


            <% if (doctor) { %>

                <div class="assigned-doctor">


                    <div class="large-doctor-avatar">

                        <% if (doctor.profileImage) { %>

                            <img
                                src="<%= doctor.profileImage %>"
                                alt="Doctor"
                            >

                        <% } else { %>

                            <span>

                                <%= doctor.firstName
                                    ? doctor.firstName
                                        .charAt(0)
                                        .toUpperCase()
                                    : "D"
                                %>

                            </span>

                        <% } %>

                    </div>


                    <div class="assigned-doctor-info">

                        <h4>

                            Dr.
                            <%= doctor.firstName || "" %>
                            <%= doctor.lastName || "" %>

                        </h4>


                        <p class="specialization">

                            <%= doctor.specialization ||
                                "General Physician"
                            %>

                        </p>


                        <% if (doctor.email) { %>

                            <p>

                                <i class="fa-solid fa-envelope"></i>

                                <%= doctor.email %>

                            </p>

                        <% } %>


                        <% if (doctor.phone) { %>

                            <p>

                                <i class="fa-solid fa-phone"></i>

                                <%= doctor.phone %>

                            </p>

                        <% } %>

                    </div>

                </div>


            <% } else { %>

                <div class="empty-card">

                    <div class="empty-icon">

                        <i class="fa-solid fa-user-doctor"></i>

                    </div>

                    <h4>
                        No Doctor Assigned
                    </h4>

                    <p>
                        Book an appointment with a doctor
                        to get started.
                    </p>

                    <a
                        href="/patient/book"
                        class="primary-btn small"
                    >
                        <i class="fa-solid fa-user-doctor"></i>
                        Find a Doctor
                    </a>

                </div>

            <% } %>

        </div>

    </div>


    <!-- =====================================================
         RECENT PRESCRIPTIONS
         ===================================================== -->

    <section class="dashboard-card prescriptions-card">

        <div class="card-header">

            <div>

                <span class="card-label">
                    Medical Records
                </span>

                <h3>
                    Recent Prescriptions
                </h3>

            </div>

            <a
                href="/patient/prescriptions"
                class="view-all"
            >
                View All
            </a>

        </div>


        <% if (
            prescriptions &&
            prescriptions.length > 0
        ) { %>

            <div class="table-wrapper">

                <table class="table">

                    <thead>

                        <tr>

                            <th>
                                Date
                            </th>

                            <th>
                                Doctor
                            </th>

                            <th>
                                Medicine
                            </th>

                            <th>
                                Status
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <% prescriptions.forEach(function(item) { %>

                            <tr>

                                <td>

                                    <%= item.createdAt
                                        ? new Date(
                                            item.createdAt
                                          ).toLocaleDateString(
                                            "en-IN",
                                            {
                                                day: "numeric",
                                                month: "short",
                                                year: "numeric"
                                            }
                                          )
                                        : "N/A"
                                    %>

                                </td>


                                <td>

                                    Dr.
                                    <%= item.doctor?.firstName || "" %>
                                    <%= item.doctor?.lastName || "" %>

                                </td>


                                <td>

                                    <%= item.medicine ||
                                        item.medicines ||
                                        "Prescription Available"
                                    %>

                                </td>


                                <td>

                                    <span class="badge success">

                                        <i class="fa-solid fa-circle-check"
                                           style="margin-right:4px">
                                        </i>

                                        Active

                                    </span>

                                </td>

                            </tr>

                        <% }); %>

                    </tbody>

                </table>

            </div>


        <% } else { %>

            <div class="empty-table">

                <i class="fa-solid fa-prescription-bottle-medical"></i>

                <h4>
                    No Prescriptions Yet
                </h4>

                <p>
                    Your recent prescriptions will appear here.
                </p>

            </div>

        <% } %>

    </section>


    <!-- =====================================================
         NOTIFICATIONS
         ===================================================== -->

    <section class="dashboard-card notifications-card">

        <div class="card-header">

            <div>

                <span class="card-label">
                    Updates
                </span>

                <h3>
                    Notifications
                </h3>

            </div>

            <a
                href="/patient/notifications"
                class="view-all"
            >
                View All
            </a>

        </div>


        <% if (
            notifications &&
            notifications.length > 0
        ) { %>

            <ul class="notification-list">

                <% notifications.forEach(function(item) { %>

                    <li>

                        <div class="notification-icon">

                            <i class="fa-solid fa-bell"></i>

                        </div>


                        <div class="notification-content">

                            <p>

                                <%= item.message ||
                                    item.title ||
                                    "You have a new notification."
                                %>

                            </p>


                            <% if (item.createdAt) { %>

                                <span>

                                    <i class="fa-regular fa-clock"
                                       style="margin-right:4px">
                                    </i>

                                    <%= new Date(
                                        item.createdAt
                                    ).toLocaleDateString(
                                        "en-IN",
                                        {
                                            day: "numeric",
                                            month: "short",
                                            year: "numeric"
                                        }
                                    ) %>

                                </span>

                            <% } %>

                        </div>

                    </li>

                <% }); %>

            </ul>


        <% } else { %>

            <div class="empty-table">

                <i class="fa-regular fa-bell-slash"></i>

                <h4>
                    No Notifications
                </h4>

                <p>
                    You're all caught up.
                </p>

            </div>

        <% } %>

    </section>


    <!-- =====================================================
         QUICK ACTIONS
         ===================================================== -->

    <section class="quick-actions">

        <a href="/patient/book">

            <i class="fa-solid fa-calendar-plus"></i>

            <span>
                Book Appointment
            </span>

        </a>


        <a href="/patient/appointments">

            <i class="fa-solid fa-calendar-check"></i>

            <span>
                My Appointments
            </span>

        </a>


        <a href="/patient/reports">

            <i class="fa-solid fa-file-medical"></i>

            <span>
                Medical Reports
            </span>

        </a>


        <a href="/patient/prescriptions">

            <i class="fa-solid fa-prescription-bottle-medical"></i>

            <span>
                Prescriptions
            </span>

        </a>


        <a href="/patient/payments">

            <i class="fa-solid fa-wallet"></i>

            <span>
                Payments
            </span>

        </a>


        <a href="/patient/profile">

            <i class="fa-solid fa-user"></i>

            <span>
                My Profile
            </span>

        </a>

    </section>

</div>


<%- include("../layouts/patientFooter") %>
```
